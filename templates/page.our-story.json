          "settings": {
            "name": "Dr Huang Dejian",
            "role": "Co-founder",
            "text": "<p>Dr Huang is deputy head of Food Science and Technology at the National University of Singapore. ProTEGO® was developed by him.</p>"
          }
        },
        "chef_stroobant": {
          "type": "person",
          "settings": {
            "name": "Emmanuel Stroobant",
            "role": "Michelin-starred chef",
            "text": "<p>Chef Stroobant endorses ProTEGO®. It holds together through long cooking, where most noodles break.</p>"
