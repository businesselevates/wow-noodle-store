      "settings": {
        "background": "cream",
        "overline": "Our name",
        "heading": "What the 0 in W0W® stands for.",
        "intro": "<p>Every W0W® product is built on two zeros:</p>",
        "body": "<p>Look at the circle around our logo. The top half is a barley stalk, for our first noodle. The bottom is a strand of noodle.</p>",
        "logo_alt": "W0W® logo",
        "card_image_alt": "ProTEGO®, a W0W® product. Protein Protects.",
        "card_heading": "ProTEGO® means Protein Protects.",
        "card_body": "<p>Tego is Latin for protect. ProTEGO® looks after you with [protein] of protein per 100g, and after the earth with second-life ingredients. It is the world's only noodle made with upcycled second-life protein.</p>",
        "product": "10-individual-pack-80g-w0w®-protego™",
        "protein_metafield": "w0w.protein_per_100g",
        "protein_value": "31.9",
        "protein_unit": "g",
        "padding_top": 80,
        "padding_bottom": 80
      }
    },
    "story_timeline": {
      "type": "hlt-timeline",
      "blocks": {
        "barley_fresh": {
          "type": "entry",
          "settings": {
            "show": true,
            "year": "",
            "year_tbc": true,
            "title": "Our first noodle.",
            "text": "<p>W0W® Barley Fresh was made from barley protein and fibre recovered from spent barley grains. It was so unlike other noodles that normal noodle factories could not make it at scale, so we stopped making it. The barley stalk in our logo comes from that noodle.</p>"
          }
        },
        "y2023": {
          "type": "entry",
          "settings": {
            "show": true,
            "year": "2023",
            "year_tbc": false,
            "title": "",
            "text": "<p>Our spent barley work with a malt drink maker wins the Singapore International Chamber of Commerce's Most Transformational Collaboration Award.</p>"
          }
        },
        "y2024": {
          "type": "entry",
          "settings": {
            "show": true,
            "year": "2024",
            "year_tbc": false,
            "title": "",
            "text": "<p>The Apex Award from the UN Global Compact Network Singapore.</p>"
          }
        },
        "protego": {
          "type": "entry",
          "settings": {
            "show": true,
            "year": "",
            "year_tbc": true,
            "title": "ProTEGO®.",
            "text": "<p>A dry noodle with 25.5g of protein in every 80g pack, made with second-life peanut protein and sweet potato fibre.</p>"
          }
        },
        "y2025": {
          "type": "entry",
          "settings": {
            "show": true,
            "year": "2025",
            "year_tbc": false,
            "title": "",
            "text": "<p>The SIAL Innovation Award, The SPARK Sustainability Innovator Award, the Singapore Business Review National Award for F&amp;B, FoodTech500 and SushiTech Tokyo.</p>"
          }
        },
        "y2026": {
          "type": "entry",
          "settings": {
            "show": true,
            "year": "2026",
            "year_tbc": false,
            "title": "",
            "text": "<p>The SIFST Food Product Award 2026 to 2028 for Best Product, and on 23 September, the BT-UOB Sustainability Award, Special Recognition for SMEs.</p>"
          }
        }
      },
      "block_order": [
        "barley_fresh",
        "y2023",
        "y2024",
        "protego",
        "y2025",
        "y2026"
      ],
