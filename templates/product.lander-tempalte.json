al needs.","formula_subtext_size":16,"formula_subtext_color":"#fffbf1","formula_text":"One snack designed for all of them is a snack designed for none of them.","formula_text_size":19,"formula_text_color":"#f9f7f1","formula_image":"shopify:\/\/shop_images\/Rectangle_8.webp","formula_image_radius":12,"formula_description":"","formula_description_size":12,"formula_description_color":"#5ec2e7","formula_bg_color":"#1b2e5c","formula_card_bg":"#1b2e5c","formula_card_radius":8,"formula_card_padding":30,"formula_gap":30,"formula_padding_vertical":30,"formula_text_spacing":15,"imgcard_image":"shopify:\/\/shop_images\/Screenshot_at_Jun_12_16-01-36.webp","imgcard_image_mobile":"shopify:\/\/shop_images\/ChatGPT_Image_Jun_12_2026_04_11_06_PM.webp","imgcard_title":"","imgcard_title_size":28,"imgcard_title_color":"#000000","imgcard_caption":"","imgcard_caption_size":14,"imgcard_caption_color":"#ffffff","imgcard_align":"center","imgcard_image_radius":0,"imgcard_section_bg":"#1b2e5c","imgcard_card_bg":"#1b2e5c","imgcard_card_radius":0,"imgcard_card_padding":0,"imgcard_text_spacing":16,"imgcard_padding_vertical":40,"banner_image":"shopify:\/\/shop_images\/hf_20260611_030310_2ba88b27-db26-4f83-99b3-6c228a7f5e53_1.webp","banner_height":590,"banner_height_mobile":300,"banner_border_radius":12,"banner_show_overlay":false,"banner_overlay_color":"#000000","banner_overlay_opacity":30,"banner_content_h":"flex-start","banner_content_v":"center","banner_text_align":"left","banner_content_max_width":520,"banner_content_padding":40,"banner_subtitle":"","banner_subtitle_color":"#192e59","banner_subtitle_size":14,"banner_title":"","banner_title_color":"#192e59","banner_title_size":40,"banner_text":"","banner_text_color":"#3c4d6b","banner_text_size":16,"banner_section_bg":"#1b2e5c","banner_padding_vertical":40,"label_heading":"<p>Here's what \"clean label\" actually doesn't guarantee.<\/p>","label_heading_size":46,"label_heading_color":"#fffbf1","label_text":"<p>You've found a snack. Organic. No sugar. Short ingredient list. It passes every check. But can it answer these?<\/p>","label_text_size":16,"label_text_color":"#fffbf1","label_bg_color":"#1b2e5c","label_padding_vertical":5,"label_padding_bottom":60,"label_spacing":30,"label_card_bg":"#233b74","label_card_radius":12,"label_card_padding":30,"label_card_gap":20,"label_card_spacing":10,"label_card_show_dot":true,"label_card_dot_color":"#7fa8d8","label_card_number_size":24,"label_card_number_color":"#5ec2e7","label_card_title_size":22,"label_card_title_color":"#ffffff","label_card_text_size":16,"label_card_text_color":"#ffffff","label_card_1_number":"01","label_card_1_title":"Texture Safety","label_card_1_text":"Is the texture genuinely safe for your child's chewing ability at this specific age - or does it assume jaw development they don't have yet?","label_card_2_number":"02","label_card_2_title":"Digestive Compatibility","label_card_2_text":"Does the formulation support a developing gut - or stress it? Fibres fine for a toddler can cause real discomfort in an infant.","label_card_3_number":"03","label_card_3_title":"Nutritional Integrity","label_card_3_text":"After heat processing, how much of the nutrition on that label actually reaches your child? Most heat-sensitive vitamins are destroyed.","label_card_4_number":"04","label_card_4_title":"Acceptance","label_card_4_text":"Will your child actually eat it? Textures not designed for young palates get rejected - not eaten.","show_cta_button":true,"cta_button_text":"FIND THE RIGHT SNACK FOR YOUR CHILD'S AGE","cta_button_link":"#buy-section","cta_button_text_size":16,"cta_button_bg":"#5ec2e7","cta_button_hover_bg":"#8abadb","cta_button_text_color":"#ffffff","cta_button_radius":40,"cta_button_padding_vertical":15,"cta_button_padding_horizontal":40},"blocks":{}}},"block_order":["ai_gen_block_d0114ae_nd8g9X"],"name":"THINK ABOUT FORMULA","settings":{}},"blocks_CTgrHx":{"type":"_blocks","blocks":{"ai_gen_block_fc3fe58_zQHJn9":{"type":"ai_gen_block_fc3fe58","sett