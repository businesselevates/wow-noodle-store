    "hlt_why_bundle": {
      "type": "hlt-text",
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Why a bundle beats buying a box at a time.",
            "size": "hlt-h2"
          }
        },
        "list_2": {
          "type": "list",
          "settings": {
            "items": "More to try. At least 10 different snacks in one delivery, so if one doesn't win them over, there are plenty more.\nLess per snack. About 10% below buying the same boxes one by one, and 15 to 17% with the Value pack.\nEnough for every bag. The stroller bag and the kitchen cupboard, from one order.\nThe Value pack is made for two or more little ones.",
            "bold_lead": true,
            "pending_last_line": "The Value pack is made for two or more little ones, and comes with free Habibara wipes.",
            "show_pending": false
          }
        },
