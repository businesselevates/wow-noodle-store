    "wow_faq": {
      "type": "hlt-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "show": true,
            "question": "How does a noodle have 31.9g of protein per 100g?",
            "answer": "<p>Because protein is one of the four things it is made from. The panel reads 31.9g per 100g and 25.5g in an 80g pack, and both are printed on the back.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "show": true,
            "question": "Is it going to taste like health food?",
            "answer": "<p>Most people say soba. Springy, with a bite that holds. Fourteen reviews on the 10-pack average 4.9 out of 5.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "show": true,
            "question": "How do I cook it?",
            "answer": "<p>Boil five minutes and drain, or cook it straight in your soup. It holds its shape through long cooking, and the next day in a meal prep box.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "show": true,
            "question": "Is it cheaper than chicken breast?",
            "answer": "<p>No. Chicken breast costs less and always will. What it cannot do is be a different meal every day.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "show": true,
            "question": "Can I eat it if I avoid gluten or peanuts?",
            "answer": "<p>No. Contains gluten and peanut, and it is made on shared equipment with soy and sesame.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "show": true,
            "question": "How many packs should I start with?",
            "answer": "<p>Ten. That is ten dinners, enough to know whether you keep reaching for it. If you already know, the 40-pack is where the extra packs begin.</p>"
          }
        }
      },
      "block_order": [
        "question_1",
        "question_2",
        "question_3",
        "question_4",
        "question_5",
        "question_6"
      ],
