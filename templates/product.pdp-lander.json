    "wow_second_life": {
      "type": "hlt-media-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "text": "Two of the four ingredients had a first life somewhere else.",
            "size": "hlt-h2"
          }
        },
        "body_origin": {
          "type": "body",
          "settings": {
            "text": "<p>The protein comes from oil meals, the solids left behind after oil is pressed. The fibre is upcycled from potato noodle production. Both were already food, and both were headed somewhere other than a plate.</p>",
            "large": true
          }
        },
        "body_claim": {
          "type": "body",
          "settings": {
            "text": "<p>Zero waste ingredients, in the world's only noodle made with upcycled second-life protein. KosmodeHealth calls the work #Wastes2Health.</p>",
            "large": true
          }
        }
      },
      "block_order": [
