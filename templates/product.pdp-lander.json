    "wow_reviews": {
      "type": "hlt-reviews",
      "blocks": {
        "review_1": {
          "type": "review",
          "settings": {
            "text": "Got myself 30 packs of the dry noodles; each pack can actually last me for 2 meals as I have them with vegetables and chicken. Absolutely delicious way to add more protein into my daily intake... it tastes just like soba noodles.",
            "name": "Karen",
            "tag": "",
            "lead_for": "0"
          }
        },
        "review_2": {
          "type": "review",
          "settings": {
            "text": "The texture is firm but also bouncy and I like that it keeps you full for longer... A really good (and even tastier!) alternative to soba noodles.",
            "name": "Emma",
            "tag": "",
            "lead_for": "0"
          }
        },
        "review_3": {
          "type": "review",
          "settings": {
            "text": "Great texture to the noodles. Love that there is a bit of chewiness/bite to it. It serves as a good base for sauces too. Also rather filling!",
            "name": "Guo An",
            "tag": "",
            "lead_for": "0"
          }
        },
        "review_4": {
          "type": "review",
          "settings": {
            "text": "Texture of health product is artificial, like eating plastic, but ProTEGO the texture is like hand make noodles. Very nice.",
            "name": "Sheldon Sim",
            "tag": "FDM 2025",
            "lead_for": "0"
          }
        }
      },
      "block_order": [
        "review_1",
        "review_2",
        "review_3",
        "review_4"
      ],
