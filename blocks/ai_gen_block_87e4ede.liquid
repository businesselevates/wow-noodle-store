{% doc %}
  @prompt
    create a section with this structure:
    heading, 4 card in 1 line. each card have icon and title. then sub head, 4 horizontal card, text, sub text, button at bottom. allow me to adjust each element indepently
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-feature-section__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-feature-section__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
  }

  .ai-feature-section__icon-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.icon_cards_gap }}px;
    margin-bottom: {{ block.settings.icon_cards_margin_bottom }}px;
  }

  .ai-feature-section__icon-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.icon_card_bg }};
    border: {{ block.settings.icon_card_border_width }}px solid {{ block.settings.icon_card_border_color }};
    border-radius: {{ block.settings.icon_card_border_radius }}px;
    padding: {{ block.settings.icon_card_padding }}px;
    text-align: center;
  }

  .ai-feature-section__icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto {{ block.settings.icon_margin_bottom }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-section__icon-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-feature-section__icon-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_placeholder_color }};
  }

  .ai-feature-section__icon-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.icon_title_size }}px;
    color: {{ block.settings.icon_title_color }};
    margin: 0;
  }

  .ai-feature-section__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    text-align: {{ block.settings.subheading_alignment }};
    margin: 0 0 {{ block.settings.subheading_margin_bottom }}px;
  }

  .ai-feature-section__horizontal-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.horizontal_cards_gap }}px;
  }

  .ai-feature-section__horizontal-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.horizontal_card_bg }};
    border: {{ block.settings.horizontal_card_border_width }}px solid {{ block.settings.horizontal_card_border_color }};
    border-radius: {{ block.settings.horizontal_card_border_radius }}px;
    padding: {{ block.settings.horizontal_card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.horizontal_card_gap }}px;
  }

  .ai-feature-section__card-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    margin: 0;
  }

  .ai-feature-section__card-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_subtext_size }}px;
    color: {{ block.settings.card_subtext_color }};
    margin: 0;
    flex-grow: 1;
  }

  .ai-feature-section__card-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    text-align: center;
    border: none;
    cursor: pointer;
  }

  .ai-feature-section__card-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-feature-section__icon-cards-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-feature-section__horizontal-cards-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-feature-section__icon-cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-feature-section__horizontal-cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="ai-feature-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-section__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-feature-section__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-feature-section__icon-cards-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign icon_key = 'icon_' | append: i
          assign icon_title_key = 'icon_title_' | append: i
          assign icon = block.settings[icon_key]
          assign icon_title = block.settings[icon_title_key]
        %}
        <div class="ai-feature-section__icon-card-{{ ai_gen_id }}">
          <div class="ai-feature-section__icon-wrapper-{{ ai_gen_id }}">
            {% if icon != blank %}
              <img src="{{ icon | image_url: width: 200 }}" alt="{{ icon_title | escape }}" loading="lazy">
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
          </div>
          {% if icon_title != blank %}
            <h3 class="ai-feature-section__icon-title-{{ ai_gen_id }}">{{ icon_title }}</h3>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if block.settings.subheading != blank %}
      <h3 class="ai-feature-section__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</h3>
    {% endif %}

    <div class="ai-feature-section__horizontal-cards-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign text_key = 'card_text_' | append: i
          assign subtext_key = 'card_subtext_' | append: i
          assign button_text_key = 'card_button_text_' | append: i
          assign button_link_key = 'card_button_link_' | append: i
          assign text = block.settings[text_key]
          assign subtext = block.settings[subtext_key]
          assign button_text = block.settings[button_text_key]
          assign button_link = block.settings[button_link_key]
        %}
        <div class="ai-feature-section__horizontal-card-{{ ai_gen_id }}">
          {% if text != blank %}
            <p class="ai-feature-section__card-text-{{ ai_gen_id }}">{{ text }}</p>
          {% endif %}
          {% if subtext != blank %}
            <p class="ai-feature-section__card-subtext-{{ ai_gen_id }}">{{ subtext }}</p>
          {% endif %}
          {% if button_text != blank %}
            <a href="{{ button_link }}" class="ai-feature-section__card-button-{{ ai_gen_id }}">{{ button_text }}</a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

