{% doc %}
  @prompt
    create a section with background is hero image full width. subheading with badge , heading, text, button. allow me to adjust content position, each element

  ── ALIGNMENT ────────────────────────────────────────────────────────────────
  The content used to be positioned by padding measured from the viewport edge,
  while the header logo measures from the theme's page container. Those two only
  coincide at one screen width, and the wider the screen the further the copy
  drifts from the logo. The content now sits in an inner wrapper that mirrors the
  page container, so its edge tracks the logo and the trust row at every width.

  ── CARD ─────────────────────────────────────────────────────────────────────
  The translucent card behind the copy only existed under 749px, so on desktop
  the heading sat straight on the photo. The card is now available on desktop
  too, sharing the colour, opacity and radius with the mobile one.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign card_bg_rgb = block.settings.mobile_card_background | color_to_rgb | remove: 'rgb(' | remove: ')'
  if card_bg_rgb == blank
    assign card_bg_rgb = '255, 255, 255'
  endif
  assign card_alpha = block.settings.mobile_card_opacity | divided_by: 100.0

  assign scrim_rgb = block.settings.overlay_color | color_to_rgb | remove: 'rgb(' | remove: ')'
  if scrim_rgb == blank
    assign scrim_rgb = '0, 0, 0'
  endif
  assign scrim_alpha = block.settings.overlay_opacity | divided_by: 100.0
%}

{% style %}
  .ai-hero-section-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.section_height }}px;
    display: flex;
    align-items: {{ block.settings.content_vertical_position }};
    overflow: hidden;
  }

  .ai-hero-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .ai-hero-background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.image_position }};
    opacity: {{ block.settings.image_opacity | divided_by: 100.0 }};
    display: block;
  }

  .ai-hero-background-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  /* Desktop: show desktop image, hide mobile image */
  .ai-hero-bg-desktop-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ai-hero-bg-mobile-{{ ai_gen_id }} {
    display: none;
    width: 100%;
    height: 100%;
  }

  .ai-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    {%- case block.settings.overlay_style -%}
      {%- when 'left' -%}
    /* a gradient clears the busy half of the photo without flattening the whole
       shot the way an even tint does */
    background: linear-gradient(to right,
      rgba({{ scrim_rgb }}, {{ scrim_alpha }}) 0%,
      rgba({{ scrim_rgb }}, {{ scrim_alpha }}) 30%,
      rgba({{ scrim_rgb }}, 0) 65%);
      {%- when 'right' -%}
    background: linear-gradient(to left,
      rgba({{ scrim_rgb }}, {{ scrim_alpha }}) 0%,
      rgba({{ scrim_rgb }}, {{ scrim_alpha }}) 30%,
      rgba({{ scrim_rgb }}, 0) 65%);
      {%- when 'bottom' -%}
    background: linear-gradient(to top,
      rgba({{ scrim_rgb }}, {{ scrim_alpha }}) 0%,
      rgba({{ scrim_rgb }}, 0) 65%);
      {%- else -%}
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    {%- endcase %}
  }

  /* ---- The alignment fix ----
     Mirrors the theme page container so the copy's edge tracks the header logo
     and the trust row rather than the viewport edge. */
  .ai-hero-inner-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    justify-content: {{ block.settings.content_horizontal_position }};
    {%- if block.settings.container_mode == 'theme' %}
    max-width: var(--page-width, {{ block.settings.container_max_width }}px);
    padding-inline: var(--page-margin, {{ block.settings.container_padding }}px);
    {%- else %}
    max-width: {{ block.settings.container_max_width }}px;
    padding-inline: {{ block.settings.container_padding }}px;
    {%- endif %}
    margin-inline: auto;
  }

  .ai-hero-content-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    padding-top: {{ block.settings.content_padding_vertical }}px;
    padding-bottom: {{ block.settings.content_padding_vertical }}px;
    padding-left: {{ block.settings.content_padding_left }}px;
    padding-right: {{ block.settings.content_padding_right }}px;
    text-align: {{ block.settings.text_alignment }};
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.element_spacing }}px;
    {%- if block.settings.desktop_card_enabled %}
    background-color: rgba({{ card_bg_rgb }}, {{ card_alpha }});
    border-radius: {{ block.settings.mobile_card_border_radius }}px;
      {%- if block.settings.card_blur > 0 %}
    /* frosts the photo behind the card, so a translucent panel stays readable
       over the busy part of the shot rather than only over flat areas */
    -webkit-backdrop-filter: blur({{ block.settings.card_blur }}px);
            backdrop-filter: blur({{ block.settings.card_blur }}px);
      {%- endif %}
    {%- endif %}
  }

  .ai-hero-badge-wrapper-{{ ai_gen_id }} {
    display: flex;
    {% if block.settings.text_alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.text_alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
  }

  .ai-hero-badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
    background-color: {{ block.settings.badge_background_color }};
    color: {{ block.settings.badge_text_color }};
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-hero-heading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_font_size }}px;
    line-height: 1.2;
    font-weight: 900;
  }

  .ai-hero-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_font_size }}px;
    line-height: 1.6;
    margin: 0;
    max-width: {{ block.settings.text_max_width }}px;
    {% if block.settings.text_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% elsif block.settings.text_alignment == 'right' %}
      margin-left: auto;
    {% endif %}
  }

  .ai-hero-button-wrapper-{{ ai_gen_id }} {
    display: flex;
    {% if block.settings.text_alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.text_alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
  }

  .ai-hero-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-hero-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-hero-section-{{ ai_gen_id }} {
      min-height: {{ block.settings.section_height_mobile }}px;
      align-items: {{ block.settings.mobile_vertical_position }};
    }

    .ai-hero-inner-{{ ai_gen_id }} {
      justify-content: {{ block.settings.mobile_horizontal_position }};
      padding-inline: 0;
      max-width: none;
    }

    /* Swap background images */
    .ai-hero-bg-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-hero-bg-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-hero-content-{{ ai_gen_id }} {
      width: 100%;
      max-width: {{ block.settings.mobile_card_max_width }}px;
      padding: {{ block.settings.mobile_card_padding }}px;
      text-align: {{ block.settings.mobile_text_alignment }};
      background-color: rgba({{ card_bg_rgb }}, {{ card_alpha }});
      border-radius: {{ block.settings.mobile_card_border_radius }}px;
      margin-top: {{ block.settings.mobile_card_margin_top }}px;
      margin-bottom: {{ block.settings.mobile_card_margin_bottom }}px;
      {% if block.settings.mobile_card_horizontal == 'left' %}
        margin-left: {{ block.settings.mobile_card_margin_sides }}px;
        margin-right: auto;
        align-self: flex-start;
      {% elsif block.settings.mobile_card_horizontal == 'right' %}
        margin-left: auto;
        margin-right: {{ block.settings.mobile_card_margin_sides }}px;
        align-self: flex-end;
      {% else %}
        margin-left: auto;
        margin-right: auto;
        align-self: center;
      {% endif %}
    }

    .ai-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_font_size | times: 0.65 | round }}px;
    }

    .ai-hero-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_font_size | times: 0.9 | round }}px;
      max-width: none;
    }

    .ai-hero-badge-wrapper-{{ ai_gen_id }} {
      {% if block.settings.mobile_text_alignment == 'center' %}
        justify-content: center;
      {% elsif block.settings.mobile_text_alignment == 'right' %}
        justify-content: flex-end;
      {% else %}
        justify-content: flex-start;
      {% endif %}
    }

    .ai-hero-button-wrapper-{{ ai_gen_id }} {
      {% if block.settings.mobile_text_alignment == 'center' %}
        justify-content: center;
      {% elsif block.settings.mobile_text_alignment == 'right' %}
        justify-content: flex-end;
      {% else %}
        justify-content: flex-start;
      {% endif %}
    }
  }
{% endstyle %}

<div class="ai-hero-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-background-{{ ai_gen_id }}">

    {%- comment -%} Desktop background image {%- endcomment -%}
    <div class="ai-hero-bg-desktop-{{ ai_gen_id }}">
      {% if block.settings.background_image %}
        <img
          src="{{ block.settings.background_image | image_url: width: 2000 }}"
          srcset="{{ block.settings.background_image | image_url: width: 1000 }} 1000w,
                  {{ block.settings.background_image | image_url: width: 1500 }} 1500w,
                  {{ block.settings.background_image | image_url: width: 2000 }} 2000w,
                  {{ block.settings.background_image | image_url: width: 2600 }} 2600w"
          sizes="100vw"
          alt="{{ block.settings.background_image.alt | escape }}"
          width="{{ block.settings.background_image.width }}"
          height="{{ block.settings.background_image.height }}"
          {%- comment -%}
            This is the largest element above the fold, so it is the LCP element.
            Lazy-loading makes the browser wait for layout before it even asks for
            the file, which is the wrong order for a hero.
          {%- endcomment -%}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      {% else %}
        <div class="ai-hero-background-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    {%- comment -%} Mobile background image — falls back to desktop image if not set {%- endcomment -%}
    <div class="ai-hero-bg-mobile-{{ ai_gen_id }}">
      {% if block.settings.background_image_mobile %}
        <img
          src="{{ block.settings.background_image_mobile | image_url: width: 900 }}"
          srcset="{{ block.settings.background_image_mobile | image_url: width: 500 }} 500w,
                  {{ block.settings.background_image_mobile | image_url: width: 900 }} 900w,
                  {{ block.settings.background_image_mobile | image_url: width: 1300 }} 1300w"
          sizes="100vw"
          alt="{{ block.settings.background_image_mobile.alt | escape }}"
          width="{{ block.settings.background_image_mobile.width }}"
          height="{{ block.settings.background_image_mobile.height }}"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      {% elsif block.settings.background_image %}
        <img
          src="{{ block.settings.background_image | image_url: width: 900 }}"
          srcset="{{ block.settings.background_image | image_url: width: 500 }} 500w,
                  {{ block.settings.background_image | image_url: width: 900 }} 900w,
                  {{ block.settings.background_image | image_url: width: 1300 }} 1300w"
          sizes="100vw"
          alt="{{ block.settings.background_image.alt | escape }}"
          width="{{ block.settings.background_image.width }}"
          height="{{ block.settings.background_image.height }}"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      {% else %}
        <div class="ai-hero-background-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

  </div>

  {% if block.settings.show_overlay %}
    <div class="ai-hero-overlay-{{ ai_gen_id }}" aria-hidden="true"></div>
  {% endif %}

  <div class="ai-hero-inner-{{ ai_gen_id }}">
    <div class="ai-hero-content-{{ ai_gen_id }}">
      {% if block.settings.show_badge and block.settings.badge_text != blank %}
        <div class="ai-hero-badge-wrapper-{{ ai_gen_id }}">
          <span class="ai-hero-badge-{{ ai_gen_id }}">{{ block.settings.badge_text }}</span>
        </div>
      {% endif %}

      {% if block.settings.show_heading and block.settings.heading != blank %}
        <h1 class="ai-hero-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
      {% endif %}

      {% if block.settings.show_text and block.settings.text != blank %}
        <div class="ai-hero-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
      {% endif %}

      {% if block.settings.show_button and block.settings.button_text != blank %}
        <div class="ai-hero-button-wrapper-{{ ai_gen_id }}">
          <a href="{{ block.settings.button_link }}" class="ai-hero-button-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero with background",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Alignment" },
    { "type": "select", "id": "container_mode", "label": "Container width", "info": "Match theme reads the theme's own page width so the copy lines up with the header logo. Switch to Custom only if it still drifts, then set the two values below from DevTools.", "options": [ { "value": "theme", "label": "Match theme" }, { "value": "custom", "label": "Custom" } ], "default": "theme" },
    { "type": "range", "id": "container_max_width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "label": "Container max width", "default": 1400 },
    { "type": "range", "id": "container_padding", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Container side padding", "default": 24 },

    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "background_image", "label": "Desktop image" },
    { "type": "select", "id": "image_position", "label": "Image focal point", "options": [ { "value": "center", "label": "Centre" }, { "value": "left center", "label": "Left" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" } ], "default": "center" },
    { "type": "range", "id": "image_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Image opacity", "default": 100 },
    { "type": "range", "id": "section_height", "min": 300, "max": 900, "step": 50, "unit": "px", "label": "Desktop height", "default": 600 },

    { "type": "header", "content": "Mobile layout" },
    { "type": "image_picker", "id": "background_image_mobile", "label": "Mobile image" },
    { "type": "paragraph", "content": "Upload a portrait or square image for mobile screens. If left empty, the desktop image will be used." },
    { "type": "range", "id": "section_height_mobile", "min": 300, "max": 700, "step": 50, "unit": "px", "label": "Mobile height", "default": 500 },
    { "type": "select", "id": "mobile_vertical_position", "label": "Vertical position (mobile)", "options": [ { "value": "flex-start", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "flex-end", "label": "Bottom" } ], "default": "flex-end" },
    { "type": "select", "id": "mobile_horizontal_position", "label": "Horizontal position (mobile)", "options": [ { "value": "flex-start", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "flex-end", "label": "Right" } ], "default": "flex-start" },
    { "type": "select", "id": "mobile_text_alignment", "label": "Text alignment (mobile)", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "left" },

    { "type": "header", "content": "Content card", "info": "The card is always on for mobile. Turn it on for desktop when the photo behind the copy is busy." },
    { "type": "checkbox", "id": "desktop_card_enabled", "label": "Show card on desktop", "default": false },
    { "type": "color", "id": "mobile_card_background", "label": "Card background color", "default": "#ffffff" },
    { "type": "range", "id": "mobile_card_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Card background opacity", "default": 80 },
    { "type": "range", "id": "card_blur", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Card background blur", "info": "Frosts the photo behind a translucent card. Desktop only. Leave at 0 for a plain tint.", "default": 0 },
    { "type": "range", "id": "mobile_card_border_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Card border radius", "default": 16 },
    { "type": "range", "id": "mobile_card_padding", "min": 16, "max": 60, "step": 4, "unit": "px", "label": "Card padding (mobile)", "default": 24 },
    { "type": "range", "id": "mobile_card_max_width", "min": 200, "max": 600, "step": 10, "unit": "px", "label": "Card max width (mobile)", "default": 480 },
    { "type": "select", "id": "mobile_card_horizontal", "label": "Card horizontal position (mobile)", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "range", "id": "mobile_card_margin_sides", "min": 0, "max": 40, "step": 4, "unit": "px", "label": "Card side gap (mobile)", "default": 16 },
    { "type": "range", "id": "mobile_card_margin_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Card top offset (mobile)", "default": 0 },
    { "type": "range", "id": "mobile_card_margin_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Card bottom offset (mobile)", "default": 16 },

    { "type": "header", "content": "Overlay" },
    { "type": "checkbox", "id": "show_overlay", "label": "Show overlay", "default": true },
    { "type": "select", "id": "overlay_style", "label": "Overlay shape", "info": "A gradient clears the side the copy sits on without flattening the whole photo.", "options": [ { "value": "even", "label": "Even tint" }, { "value": "left", "label": "Fade from left" }, { "value": "right", "label": "Fade from right" }, { "value": "bottom", "label": "Fade from bottom" } ], "default": "even" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Overlay opacity", "default": 30 },

    { "type": "header", "content": "Content layout" },
    { "type": "select", "id": "content_horizontal_position", "label": "Horizontal position (desktop)", "options": [ { "value": "flex-start", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "flex-end", "label": "Right" } ], "default": "center" },
    { "type": "select", "id": "content_vertical_position", "label": "Vertical position (desktop)", "options": [ { "value": "flex-start", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "flex-end", "label": "Bottom" } ], "default": "center" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment (desktop)", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "range", "id": "content_max_width", "min": 400, "max": 1200, "step": 50, "unit": "px", "label": "Content max width", "default": 800 },
    { "type": "range", "id": "content_padding_vertical", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Content padding (top/bottom, desktop)", "default": 40 },
    { "type": "range", "id": "content_padding_left", "min": 0, "max": 300, "step": 10, "unit": "px", "label": "Content padding left (desktop)", "info": "Doubles as the card's left padding when the desktop card is on.", "default": 60 },
    { "type": "range", "id": "content_padding_right", "min": 0, "max": 300, "step": 10, "unit": "px", "label": "Content padding right (desktop)", "default": 20 },
    { "type": "range", "id": "text_max_width", "min": 200, "max": 1000, "step": 20, "unit": "px", "label": "Paragraph text max width", "default": 600 },
    { "type": "range", "id": "element_spacing", "min": 10, "max": 50, "step": 5, "unit": "px", "label": "Spacing between elements", "default": 20 },

    { "type": "header", "content": "Badge" },
    { "type": "checkbox", "id": "show_badge", "label": "Show badge", "default": true },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "New arrival" },
    { "type": "color", "id": "badge_background_color", "label": "Background color", "default": "#910f3f" },
    { "type": "color", "id": "badge_text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "range", "id": "badge_font_size", "min": 10, "max": 20, "step": 1, "unit": "px", "label": "Font size", "default": 12 },
    { "type": "range", "id": "badge_padding_vertical", "min": 4, "max": 16, "step": 2, "unit": "px", "label": "Vertical padding", "default": 6 },
    { "type": "range", "id": "badge_padding_horizontal", "min": 8, "max": 32, "step": 2, "unit": "px", "label": "Horizontal padding", "default": 16 },
    { "type": "range", "id": "badge_border_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Border radius", "default": 40 },

    { "type": "header", "content": "Heading" },
    { "type": "checkbox", "id": "show_heading", "label": "Show heading", "default": true },
    { "type": "text", "id": "heading", "label": "Heading text", "default": "Discover your style" },
