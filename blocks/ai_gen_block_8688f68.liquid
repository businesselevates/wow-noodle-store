    { "type": "text", "id": "card_1_bullet_3", "label": "Bullet point 3", "default": "30-day money back guarantee" },
    { "type": "image_picker", "id": "card_1_image", "label": "Image" },
    { "type": "text", "id": "card_1_cta_text", "label": "CTA text", "default": "Shop Now" },
