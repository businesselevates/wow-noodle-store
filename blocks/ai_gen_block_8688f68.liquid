    { "type": "text", "id": "card_2_badge", "label": "Badge", "default": "Popular" },
    { "type": "text", "id": "card_2_subtitle_top", "label": "Top subtitle", "default": "Essential" },
    { "type": "text", "id": "card_2_title", "label": "Title", "default": "Basic Bundle" },
    { "type": "text", "id": "card_2_subtitle_bottom", "label": "Bottom subtitle", "default": "Perfect for beginners" },
    { "type": "textarea", "id": "card_2_text", "label": "Description", "default": "Get started with our carefully curated basic bundle at an affordable price." },
    { "type": "text", "id": "card_2_bullet_1", "label": "Bullet point 1", "default": "High-quality essentials" },
    { "type": "text", "id": "card_2_bullet_2", "label": "Bullet point 2", "default": "Easy to use" },
    { "type": "text", "id": "card_2_bullet_3", "label": "Bullet point 3", "default": "Great value for money" },
    { "type": "image_picker", "id": "card_2_image", "label": "Image" },
    { "type": "text", "id": "card_2_cta_text", "label": "CTA text", "default": "Shop Now" },
