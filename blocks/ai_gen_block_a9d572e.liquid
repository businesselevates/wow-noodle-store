{% doc %}
  @prompt
    Create a 3-column certification/trust badges section with card-style layout. Each card should have a white rounded card background with subtle shadow. Inside each card: top row has a small icon/emoji image on the left (in a light gray rounded square container) and a short badge label on the top-right (e.g., "MUIS", "SG", "97%") in a colored pill or bold text. Below that, a bold title (e.g., "Halal Certification"), a regular subtitle line (e.g., "Majlis Ugama Islam Singapura"), and at the bottom, 2 lines of smaller monospace/light gray text (e.g., "No. MC-24-SG-00871" and "Valid until Dec 2025"). The overall section background should be a light beige/off-white. All 3 columns should be customizable with their own icon, badge text, badge color, title, subtitle, and two detail text lines., use the same icon and color as the image. Font of subtitle like "made in singapore" is Inter
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-badges-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_background }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-trust-badges-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-trust-badges-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-trust-badge-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-trust-badge-header-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .ai-trust-badge-icon-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ai-trust-badge-icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-trust-badge-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
  }

  .ai-trust-badge-label-{{ ai_gen_id }} {
    flex-shrink: 0;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-trust-badge-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-trust-badge-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-trust-badge-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.4;
  }

  .ai-trust-badge-details-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 4px;
  }

  .ai-trust-badge-detail-{{ ai_gen_id }} {
    font-size: {{ block.settings.detail_size }}px;
    font-family: 'Courier New', Courier, monospace;
    color: {{ block.settings.detail_color }};
    margin: 0;
    line-height: 1.4;
  }

  @media screen and (max-width: 989px) {
    .ai-trust-badges-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-trust-badges-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-trust-badge-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<trust-badges-{{ ai_gen_id }} class="ai-trust-badges-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-badges-container-{{ ai_gen_id }}">
    <div class="ai-trust-badges-grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign badge_enabled_key = 'badge_' | append: i | append: '_enabled'
          assign icon_key = 'badge_' | append: i | append: '_icon'
          assign label_key = 'badge_' | append: i | append: '_label'
          assign label_color_key = 'badge_' | append: i | append: '_label_color'
          assign label_bg_key = 'badge_' | append: i | append: '_label_bg'
          assign title_key = 'badge_' | append: i | append: '_title'
          assign subtitle_key = 'badge_' | append: i | append: '_subtitle'
          assign detail1_key = 'badge_' | append: i | append: '_detail1'
          assign detail2_key = 'badge_' | append: i | append: '_detail2'

          assign badge_enabled = block.settings[badge_enabled_key]
          assign icon = block.settings[icon_key]
          assign label = block.settings[label_key]
          assign label_color = block.settings[label_color_key]
          assign label_bg = block.settings[label_bg_key]
          assign title = block.settings[title_key]
          assign subtitle = block.settings[subtitle_key]
          assign detail1 = block.settings[detail1_key]
          assign detail2 = block.settings[detail2_key]
        %}

        {% if badge_enabled %}
          <div class="ai-trust-badge-card-{{ ai_gen_id }}">
            <div class="ai-trust-badge-header-{{ ai_gen_id }}">
              <div class="ai-trust-badge-icon-wrapper-{{ ai_gen_id }}">
                {% if icon %}
                  <img
                    src="{{ icon | image_url: width: 100 }}"
                    alt="{{ title | escape }}"
                    class="ai-trust-badge-icon-{{ ai_gen_id }}"
                    loading="lazy"
                    width="100"
                    height="100"
                  >
                {% else %}
                  <div class="ai-trust-badge-icon-placeholder-{{ ai_gen_id }}">
                    ✓
                  </div>
                {% endif %}
              </div>

              {% if label != blank %}
                <div
                  class="ai-trust-badge-label-{{ ai_gen_id }}"
                  style="background-color: {{ label_bg }}; color: {{ label_color }};"
                >
                  {{ label }}
                </div>
              {% endif %}
            </div>

            <div class="ai-trust-badge-content-{{ ai_gen_id }}">
              {% if title != blank %}
                <h3 class="ai-trust-badge-title-{{ ai_gen_id }}">{{ title }}</h3>
              {% endif %}

              {% if subtitle != blank %}
                <p class="ai-trust-badge-subtitle-{{ ai_gen_id }}">{{ subtitle }}</p>
              {% endif %}

              {% if detail1 != blank or detail2 != blank %}
                <div class="ai-trust-badge-details-{{ ai_gen_id }}">
                  {% if detail1 != blank %}
                    <p class="ai-trust-badge-detail-{{ ai_gen_id }}">{{ detail1 }}</p>
                  {% endif %}
                  {% if detail2 != blank %}
                    <p class="ai-trust-badge-detail-{{ ai_gen_id }}">{{ detail2 }}</p>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</trust-badges-{{ ai_gen_id }}>

<script>
  (function() {
    class TrustBadges{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('trust-badges-{{ ai_gen_id }}', TrustBadges{{ ai_gen_id }});
  })();
</script>

