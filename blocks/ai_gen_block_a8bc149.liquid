{% doc %}
  @prompt
    create the science section, with structure from top to down have sub heading, heading, 5 column card, hero image, give image section here for me to replace the image, remove the image section. add the ordering number above card title like this. and move all card icon to the left side 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-science-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-science-section__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-science-section__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 12px 0;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
  }

  .ai-science-section__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-weight: 900;
    line-height: 1.2;
  }

  .ai-science-section__cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin-bottom: {{ block.settings.cards_spacing }}px;
  }

  .ai-science-section__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    border: {{ block.settings.card_border_thickness }}px solid {{ block.settings.card_border_color }};
    display: flex;
    align-items: flex-start;
    gap: {{ block.settings.card_content_gap }}px;
  }

  .ai-science-section__card-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    background-color: {{ block.settings.icon_background }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-science-section__card-icon-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
    fill: {{ block.settings.icon_color }};
  }

  .ai-science-section__card-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-science-section__card-number-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_number_size }}px;
    color: {{ block.settings.card_number_color }};
    font-weight: 700;
    margin: 0 0 8px 0;
  }

  .ai-science-section__card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 8px 0;
    font-weight: 700;
  }

  .ai-science-section__card-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-science-section__hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    border-radius: {{ block.settings.hero_border_radius }}px;
    overflow: hidden;
  }

  .ai-science-section__hero-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-science-section__hero-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-science-section__hero-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-science-section__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 989px) {
    .ai-science-section__cards-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-science-section__cards-{{ ai_gen_id }} {
      grid-template-columns: repeat(1, 1fr);
    }

    .ai-science-section__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-science-section__subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.8);
    }
  }
{% endstyle %}

<science-section-{{ ai_gen_id }}
  class="ai-science-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-science-section__header-{{ ai_gen_id }}">
    {% if block.settings.subheading != blank %}
      <div class="ai-science-section__subheading-{{ ai_gen_id }}">
        {{ block.settings.subheading }}
      </div>
    {% endif %}
    {% if block.settings.heading != blank %}
      <h2 class="ai-science-section__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}
  </div>

  <div class="ai-science-section__cards-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign card_title_key = 'card_' | append: i | append: '_title'
        assign card_text_key = 'card_' | append: i | append: '_text'
        assign card_title = block.settings[card_title_key]
        assign card_text = block.settings[card_text_key]
      %}
      <div class="ai-science-section__card-{{ ai_gen_id }}">
        <div class="ai-science-section__card-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            {% if i == 1 %}
              <path d="M19.5 3.09L15 5.5 10.5 3.09 6 5.5 1.5 3.09V4.91L6 7.32 10.5 4.91 15 7.32 19.5 4.91V3.09M19.5 8.09L15 10.5 10.5 8.09 6 10.5 1.5 8.09V9.91L6 12.32 10.5 9.91 15 12.32 19.5 9.91V8.09M19.5 13.09L15 15.5 10.5 13.09 6 15.5 1.5 13.09V14.91L6 17.32 10.5 14.91 15 17.32 19.5 14.91V13.09M19.5 18.09L15 20.5 10.5 18.09 6 20.5 1.5 18.09V19.91L6 22.32 10.5 19.91 15 22.32 19.5 19.91V18.09Z"/>
            {% elsif i == 2 %}
              <path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z"/>
            {% elsif i == 3 %}
              <path d="M12,2L14.5,9.5L22,12L14.5,14.5L12,22L9.5,14.5L2,12L9.5,9.5L12,2M12,5.8L10.7,10.3L6.2,12L10.7,13.7L12,18.2L13.3,13.7L17.8,12L13.3,10.3L12,5.8Z"/>
            {% elsif i == 4 %}
              <path d="M7,2V4H8V18A4,4 0 0,0 12,22A4,4 0 0,0 16,18V4H17V2H7M11,16C10.4,16 10,15.6 10,15C10,14.4 10.4,14 11,14C11.6,14 12,14.4 12,15C12,15.6 11.6,16 11,16M13,12C12.4,12 12,11.6 12,11C12,10.4 12.4,10 13,10C13.6,10 14,10.4 14,11C14,11.6 13.6,12 13,12M14,7H10V4H14V7Z"/>
            {% else %}
              <path d="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M11,6H13V14H11V6M10,16H14V18H10V16Z"/>
            {% endif %}
          </svg>
        </div>
        <div class="ai-science-section__card-content-{{ ai_gen_id }}">
          <div class="ai-science-section__card-number-{{ ai_gen_id }}">
            {{ i | prepend: '0' }}
          </div>
          {% if card_title != blank %}
            <h3 class="ai-science-section__card-title-{{ ai_gen_id }}">
              {{ card_title }}
            </h3>
          {% endif %}
          {% if card_text != blank %}
            <p class="ai-science-section__card-text-{{ ai_gen_id }}">
              {{ card_text }}
            </p>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  <div class="ai-science-section__hero-{{ ai_gen_id }}">
    {% if block.settings.hero_image %}
      <img
        src="{{ block.settings.hero_image | image_url: width: 2000 }}"
        alt="{{ block.settings.hero_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.hero_image.width }}"
        height="{{ block.settings.hero_image.height }}"
        class="ai-science-section__hero-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-science-section__hero-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-science-section__empty-state-{{ ai_gen_id }}">
          Next, add a hero image
        </div>
      </div>
    {% endif %}
  </div>
</science-section-{{ ai_gen_id }}>

<script>
  (function() {
    class ScienceSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('science-section-{{ ai_gen_id }}', ScienceSection{{ ai_gen_id }});
  })();
</script>

