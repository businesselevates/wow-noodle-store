{% doc %}
  @prompt
    Create a section with structure like this:
    
    Section 1: introduction
    - heading, text
    - content align left
    
    Section 2: ingredient
    - 5 card, 1 line 1 card
    - each card split into 3 parts. part 1: numberic, sub title, title, text. part 2: image. Part 3: text, 4 bullet point below ( each line 2 bullet point). use check badge for bullet point icon
    
    section 3: guideance
    - 1 card with same size as section 2
    - card split 2 part: left is text with sub title, title. right is image
    
    allow me to adjust text, size, color, background of each element, card, etc independently. keep all content and card in container, have blank padding on horizontal left and right same with previous section you created, and also allow me to adjust. and let me adjust the padding between each section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-multi-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-multi-section-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    padding-left: {{ block.settings.container_padding_horizontal }}px;
    padding-right: {{ block.settings.container_padding_horizontal }}px;
  }

  .ai-intro-section-{{ ai_gen_id }} {
    padding-top: {{ block.settings.intro_padding_top }}px;
    padding-bottom: {{ block.settings.intro_padding_bottom }}px;
    background-color: {{ block.settings.intro_bg_color }};
  }

  .ai-intro-content-{{ ai_gen_id }} {
    text-align: {{ block.settings.intro_text_align }};
  }

  .ai-intro-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.intro_heading_size }}px;
    color: {{ block.settings.intro_heading_color }};
    margin: 0 0 {{ block.settings.intro_heading_margin_bottom }}px;
  }

  .ai-intro-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.intro_text_size }}px;
    color: {{ block.settings.intro_text_color }};
    margin: 0;
  }

  .ai-ingredient-section-{{ ai_gen_id }} {
    padding-top: {{ block.settings.ingredient_padding_top }}px;
    padding-bottom: {{ block.settings.ingredient_padding_bottom }}px;
    background-color: {{ block.settings.ingredient_bg_color }};
  }

  .ai-ingredient-cards-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.ingredient_card_gap }}px;
  }

  .ai-ingredient-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.ingredient_card_bg }};
    border-radius: {{ block.settings.ingredient_card_radius }}px;
    padding: {{ block.settings.ingredient_card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.ingredient_card_inner_gap }}px;
  }

  .ai-ingredient-card-part1-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-ingredient-number-{{ ai_gen_id }} {
    font-size: {{ block.settings.ingredient_number_size }}px;
    color: {{ block.settings.ingredient_number_color }};
    font-weight: 700;
    margin: 0;
  }

  .ai-ingredient-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.ingredient_subtitle_size }}px;
    color: {{ block.settings.ingredient_subtitle_color }};
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-ingredient-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.ingredient_title_size }}px;
    color: {{ block.settings.ingredient_title_color }};
    margin: 0;
    font-weight: 600;
  }

  .ai-ingredient-desc-{{ ai_gen_id }} {
    font-size: {{ block.settings.ingredient_desc_size }}px;
    color: {{ block.settings.ingredient_desc_color }};
    margin: 0;
  }

  .ai-ingredient-card-part2-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-ingredient-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.ingredient_image_radius }}px;
  }

  .ai-ingredient-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.ingredient_image_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-ingredient-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-ingredient-card-part3-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-ingredient-part3-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.ingredient_part3_text_size }}px;
    color: {{ block.settings.ingredient_part3_text_color }};
    margin: 0;
  }

  .ai-ingredient-bullets-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .ai-ingredient-bullet-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .ai-ingredient-bullet-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.ingredient_bullet_icon_size }}px;
    height: {{ block.settings.ingredient_bullet_icon_size }}px;
    color: {{ block.settings.ingredient_bullet_icon_color }};
  }

  .ai-ingredient-bullet-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.ingredient_bullet_text_size }}px;
    color: {{ block.settings.ingredient_bullet_text_color }};
    margin: 0;
  }

  .ai-guidance-section-{{ ai_gen_id }} {
    padding-top: {{ block.settings.guidance_padding_top }}px;
    padding-bottom: {{ block.settings.guidance_padding_bottom }}px;
    background-color: {{ block.settings.guidance_bg_color }};
  }

  .ai-guidance-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.guidance_card_bg }};
    border-radius: {{ block.settings.guidance_card_radius }}px;
    padding: {{ block.settings.guidance_card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.guidance_card_gap }}px;
  }

  .ai-guidance-text-section-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-guidance-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.guidance_subtitle_size }}px;
    color: {{ block.settings.guidance_subtitle_color }};
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-guidance-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.guidance_title_size }}px;
    color: {{ block.settings.guidance_title_color }};
    margin: 0;
    font-weight: 600;
  }

  .ai-guidance-image-section-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-guidance-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.guidance_image_radius }}px;
  }

  .ai-guidance-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.guidance_image_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-guidance-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (min-width: 750px) {
    .ai-guidance-card-{{ ai_gen_id }} {
      flex-direction: row;
      align-items: center;
    }

    .ai-guidance-text-section-{{ ai_gen_id }} {
      flex: 1;
    }

    .ai-guidance-image-section-{{ ai_gen_id }} {
      flex: 1;
    }
  }
{% endstyle %}

<div class="ai-multi-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-intro-section-{{ ai_gen_id }}">
    <div class="ai-multi-section-container-{{ ai_gen_id }}">
      <div class="ai-intro-content-{{ ai_gen_id }}">
        {% if block.settings.intro_heading != blank %}
          <h2 class="ai-intro-heading-{{ ai_gen_id }}">{{ block.settings.intro_heading }}</h2>
        {% endif %}
        {% if block.settings.intro_text != blank %}
          <div class="ai-intro-text-{{ ai_gen_id }}">{{ block.settings.intro_text }}</div>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="ai-ingredient-section-{{ ai_gen_id }}">
    <div class="ai-multi-section-container-{{ ai_gen_id }}">
      <div class="ai-ingredient-cards-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          {% liquid
            assign enabled_key = 'ingredient_' | append: i | append: '_enabled'
            assign number_key = 'ingredient_' | append: i | append: '_number'
            assign subtitle_key = 'ingredient_' | append: i | append: '_subtitle'
            assign title_key = 'ingredient_' | append: i | append: '_title'
            assign desc_key = 'ingredient_' | append: i | append: '_desc'
            assign image_key = 'ingredient_' | append: i | append: '_image'
            assign part3_text_key = 'ingredient_' | append: i | append: '_part3_text'
            assign bullet1_key = 'ingredient_' | append: i | append: '_bullet1'
            assign bullet2_key = 'ingredient_' | append: i | append: '_bullet2'
            assign bullet3_key = 'ingredient_' | append: i | append: '_bullet3'
            assign bullet4_key = 'ingredient_' | append: i | append: '_bullet4'

            assign enabled = block.settings[enabled_key]
            assign number = block.settings[number_key]
            assign subtitle = block.settings[subtitle_key]
            assign title = block.settings[title_key]
            assign desc = block.settings[desc_key]
            assign image = block.settings[image_key]
            assign part3_text = block.settings[part3_text_key]
            assign bullet1 = block.settings[bullet1_key]
            assign bullet2 = block.settings[bullet2_key]
            assign bullet3 = block.settings[bullet3_key]
            assign bullet4 = block.settings[bullet4_key]
          %}

          {% if enabled %}
            <div class="ai-ingredient-card-{{ ai_gen_id }}">
              <div class="ai-ingredient-card-part1-{{ ai_gen_id }}">
                {% if number != blank %}
                  <div class="ai-ingredient-number-{{ ai_gen_id }}">{{ number }}</div>
                {% endif %}
                {% if subtitle != blank %}
                  <div class="ai-ingredient-subtitle-{{ ai_gen_id }}">{{ subtitle }}</div>
                {% endif %}
                {% if title != blank %}
                  <h3 class="ai-ingredient-title-{{ ai_gen_id }}">{{ title }}</h3>
                {% endif %}
                {% if desc != blank %}
                  <p class="ai-ingredient-desc-{{ ai_gen_id }}">{{ desc }}</p>
                {% endif %}
              </div>

              <div class="ai-ingredient-card-part2-{{ ai_gen_id }}">
                {% if image %}
                  <img
                    src="{{ image | image_url: width: 1200 }}"
                    alt="{{ image.alt | escape }}"
                    loading="lazy"
                    width="{{ image.width }}"
                    height="{{ image.height }}"
                    class="ai-ingredient-image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-ingredient-image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-ingredient-card-part3-{{ ai_gen_id }}">
                {% if part3_text != blank %}
                  <p class="ai-ingredient-part3-text-{{ ai_gen_id }}">{{ part3_text }}</p>
                {% endif %}

                <div class="ai-ingredient-bullets-{{ ai_gen_id }}">
                  {% if bullet1 != blank %}
                    <div class="ai-ingredient-bullet-{{ ai_gen_id }}">
                      <svg class="ai-ingredient-bullet-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                      </svg>
                      <span class="ai-ingredient-bullet-text-{{ ai_gen_id }}">{{ bullet1 }}</span>
                    </div>
                  {% endif %}

                  {% if bullet2 != blank %}
                    <div class="ai-ingredient-bullet-{{ ai_gen_id }}">
                      <svg class="ai-ingredient-bullet-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                      </svg>
                      <span class="ai-ingredient-bullet-text-{{ ai_gen_id }}">{{ bullet2 }}</span>
                    </div>
                  {% endif %}

                  {% if bullet3 != blank %}
                    <div class="ai-ingredient-bullet-{{ ai_gen_id }}">
                      <svg class="ai-ingredient-bullet-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                      </svg>
                      <span class="ai-ingredient-bullet-text-{{ ai_gen_id }}">{{ bullet3 }}</span>
                    </div>
                  {% endif %}

                  {% if bullet4 != blank %}
                    <div class="ai-ingredient-bullet-{{ ai_gen_id }}">
                      <svg class="ai-ingredient-bullet-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                      </svg>
                      <span class="ai-ingredient-bullet-text-{{ ai_gen_id }}">{{ bullet4 }}</span>
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="ai-guidance-section-{{ ai_gen_id }}">
    <div class="ai-multi-section-container-{{ ai_gen_id }}">
      <div class="ai-guidance-card-{{ ai_gen_id }}">
        <div class="ai-guidance-text-section-{{ ai_gen_id }}">
          {% if block.settings.guidance_subtitle != blank %}
            <div class="ai-guidance-subtitle-{{ ai_gen_id }}">{{ block.settings.guidance_subtitle }}</div>
          {% endif %}
          {% if block.settings.guidance_title != blank %}
            <h3 class="ai-guidance-title-{{ ai_gen_id }}">{{ block.settings.guidance_title }}</h3>
          {% endif %}
        </div>

        <div class="ai-guidance-image-section-{{ ai_gen_id }}">
          {% if block.settings.guidance_image %}
            <img
              src="{{ block.settings.guidance_image | image_url: width: 1200 }}"
              alt="{{ block.settings.guidance_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.guidance_image.width }}"
              height="{{ block.settings.guidance_image.height }}"
              class="ai-guidance-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-guidance-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Multi section content",
  "settings": [
    {
      "type": "header",
      "content": "Container"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "label": "Max width",
      "min": 600,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "container_padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Introduction section"
    },
    {
      "type": "richtext",
      "id": "intro_heading",
      "label": "Heading",
      "default": "<p>Welcome to our product</p>"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Text",
      "default": "<p>Discover the amazing benefits of our carefully selected ingredients.</p>"
    },
    {
      "type": "select",
      "id": "intro_text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "intro_heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "color",
      "id": "intro_heading_color",
      "label": "Heading color",
      "default": "#192e59"
    },
    {
      "type": "range",
      "id": "intro_heading_margin_bottom",
      "label": "Heading margin bottom",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "intro_text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "intro_text_color",
      "label": "Text color",
      "default": "#192e59"
    },
    {
      "type": "color",
      "id": "intro_bg_color",
      "label": "Background color",
      "default": "#f9f7f1"
    },
    {
      "type": "range",
      "id": "intro_padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "intro_padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Ingredient section"
    },
    {
      "type": "color",
      "id": "ingredient_bg_color",
      "label": "Background color",
      "default": "#f9f7f1"
    },
    {
      "type": "range",
      "id": "ingredient_padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "ingredient_padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "ingredient_card_gap",
      "label": "Gap between cards",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Ingredient card style"
    },
    {
      "type": "color",
      "id": "ingredient_card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "ingredient_card_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "ingredient_card_padding",
      "label": "Card padding",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "ingredient_card_inner_gap",
      "label": "Gap between card parts",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "ingredient_number_size",
      "label": "Number size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "ingredient_number_color",
      "label": "Number color",
      "default": "#910f3f"
    },
    {
      "type": "range",
      "id": "ingredient_subtitle_size",
      "label": "Subtitle size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "ingredient_subtitle_color",
      "label": "Subtitle color",
      "default": "#3f4e1f"
    },
    {
      "type": "range",
      "id": "ingredient_title_size",
      "label": "Title size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "ingredient_title_color",
      "label": "Title color",
      "default": "#192e59"
    },
    {
      "type": "range",
      "id": "ingredient_desc_size",
      "label": "Description size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "ingredient_desc_color",
      "label": "Description color",
      "default": "#192e59"
    },
    {
      "type": "range",
      "id": "ingredient_image_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "ingredient_part3_text_size",
      "label": "Part 3 text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "ingredient_part3_text_color",
      "label": "Part 3 text color",
      "default": "#192e59"
    },
    {
      "type": "range",
      "id": "ingredient_bullet_icon_size",
      "label": "Bullet icon size",
      "min": 12,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "ingredient_bullet_icon_color",
      "label": "Bullet icon color",
      "default": "#3f4e1f"
    },
    {
      "type": "range",
      "id": "ingredient_bullet_text_size",
      "label": "Bullet text size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "ingredient_bullet_text_color",
      "label": "Bullet text color",
      "default": "#192e59"
