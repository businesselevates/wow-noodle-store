{% doc %}
  @prompt
    generate a section with sub heading, heading, description, 4 card in 1 line, and a hero image full width size below. in each card have icon, title, text
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-hero-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-feature-hero-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
  }

  .ai-feature-hero-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .ai-feature-hero-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
  }

  .ai-feature-hero-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-feature-hero-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.6;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-feature-hero-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin-bottom: 40px;
  }

  .ai-feature-hero-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 30px 20px;
    text-align: center;
    box-shadow: 0 {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-feature-hero-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 {{ block.settings.card_shadow_vertical | plus: 5 }}px {{ block.settings.card_shadow_blur | plus: 5 }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | times: 1.2 }});
  }

  .ai-feature-hero-card-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-hero-card-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-feature-hero-card-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-hero-card-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-feature-hero-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 12px;
    font-weight: 600;
  }

  .ai-feature-hero-card-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-feature-hero-image-{{ ai_gen_id }} {
    width: 100%;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-feature-hero-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-feature-hero-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    min-height: 400px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-feature-hero-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-height: 500px;
  }

  .ai-feature-hero-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  /* Desktop: show desktop image, hide mobile image */
  .ai-feature-hero-image-desktop-{{ ai_gen_id }} {
    display: block;
  }

  .ai-feature-hero-image-mobile-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .ai-feature-hero-cards-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-feature-hero-{{ ai_gen_id }} {
      padding: 30px 15px;
    }

    .ai-feature-hero-cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-feature-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-feature-hero-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.8 }}px;
    }

    /* Mobile: hide desktop image, show mobile image */
    .ai-feature-hero-image-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-feature-hero-image-mobile-{{ ai_gen_id }} {
      display: block;
    }
  }
{% endstyle %}

<feature-hero-{{ ai_gen_id }} class="ai-feature-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-hero-container-{{ ai_gen_id }}">
    <div class="ai-feature-hero-header-{{ ai_gen_id }}">
      {% if block.settings.subheading != blank %}
        <div class="ai-feature-hero-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
      {% endif %}
      
      {% if block.settings.heading != blank %}
        <h2 class="ai-feature-hero-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      
      {% if block.settings.description != blank %}
        <div class="ai-feature-hero-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>

    <div class="ai-feature-hero-cards-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign card_icon_key = 'card_' | append: i | append: '_icon'
          assign card_title_key = 'card_' | append: i | append: '_title'
          assign card_text_key = 'card_' | append: i | append: '_text'
          
          assign card_icon = block.settings[card_icon_key]
          assign card_title = block.settings[card_title_key]
          assign card_text = block.settings[card_text_key]
        %}
        
        <div class="ai-feature-hero-card-{{ ai_gen_id }}">
          <div class="ai-feature-hero-card-icon-{{ ai_gen_id }}">
            {% if card_icon %}
              <img
                src="{{ card_icon | image_url: width: 200 }}"
                alt="{{ card_title | escape }}"
                loading="lazy"
                width="200"
                height="200"
              >
            {% else %}
              <div class="ai-feature-hero-card-icon-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          
          {% if card_title != blank %}
            <h3 class="ai-feature-hero-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
          {% endif %}
          
          {% if card_text != blank %}
            <div class="ai-feature-hero-card-text-{{ ai_gen_id }}">{{ card_text }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="ai-feature-hero-image-{{ ai_gen_id }}">

      {%- comment -%} Desktop image {%- endcomment -%}
      <div class="ai-feature-hero-image-desktop-{{ ai_gen_id }}">
        {% if block.settings.hero_image %}
          <img
            src="{{ block.settings.hero_image | image_url: width: 2000 }}"
            alt="{{ block.settings.hero_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.hero_image.width }}"
            height="{{ block.settings.hero_image.height }}"
          >
        {% else %}
          <div class="ai-feature-hero-image-placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
            <div class="ai-feature-hero-empty-state-{{ ai_gen_id }}">
              Next, add a hero image
            </div>
          </div>
        {% endif %}
      </div>

      {%- comment -%} Mobile image — falls back to desktop image if not set {%- endcomment -%}
      <div class="ai-feature-hero-image-mobile-{{ ai_gen_id }}">
        {% if block.settings.hero_image_mobile %}
          <img
            src="{{ block.settings.hero_image_mobile | image_url: width: 800 }}"
            alt="{{ block.settings.hero_image_mobile.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.hero_image_mobile.width }}"
            height="{{ block.settings.hero_image_mobile.height }}"
          >
        {% elsif block.settings.hero_image %}
          <img
            src="{{ block.settings.hero_image | image_url: width: 800 }}"
            alt="{{ block.settings.hero_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.hero_image.width }}"
            height="{{ block.settings.hero_image.height }}"
          >
        {% else %}
          <div class="ai-feature-hero-image-placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
            <div class="ai-feature-hero-empty-state-{{ ai_gen_id }}">
              Add a mobile hero image
            </div>
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</feature-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class FeatureHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('feature-hero-{{ ai_gen_id }}', FeatureHero{{ ai_gen_id }});
  })();
</script>

{% schema %}
