{% doc %}
  @prompt
    generate an our story section, create a text block under the image, insert 3 card under story text like this, remove card icon, add a sub heading above the heading like this, add a stethoscope icon into image caption section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-our-story-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-our-story-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-our-story-content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .ai-our-story-content-{{ ai_gen_id }} {
      grid-template-columns: {% if block.settings.layout == 'image_left' %}1fr 1fr{% else %}1fr 1fr{% endif %};
      gap: 60px;
    }

    .ai-our-story-image-wrapper-{{ ai_gen_id }} {
      order: {% if block.settings.layout == 'image_left' %}1{% else %}2{% endif %};
    }

    .ai-our-story-text-wrapper-{{ ai_gen_id }} {
      order: {% if block.settings.layout == 'image_left' %}2{% else %}1{% endif %};
    }
  }

  .ai-our-story-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-our-story-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    object-fit: cover;
  }

  .ai-our-story-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-our-story-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-our-story-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-our-story-image-caption-{{ ai_gen_id }} {
    font-size: {{ block.settings.caption_size }}px;
    color: {{ block.settings.caption_color }};
    line-height: 1.5;
    text-align: {{ block.settings.caption_alignment }};
    display: flex;
    align-items: center;
    gap: 8px;
    {% if block.settings.caption_alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.caption_alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
  }

  .ai-our-story-caption-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    color: {{ block.settings.icon_color }};
  }

  .ai-our-story-caption-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .ai-our-story-text-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-our-story-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
  }

  .ai-our-story-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-our-story-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-our-story-text-{{ ai_gen_id }} p {
    margin: 0 0 16px;
  }

  .ai-our-story-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-our-story-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 30px;
  }

  @media screen and (min-width: 750px) {
    .ai-our-story-cards-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }

  .ai-our-story-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background_color }};
    padding: 24px;
    border-radius: {{ block.settings.card_border_radius }}px;
    border: {{ block.settings.card_border_thickness }}px solid {{ block.settings.card_border_color }};
    text-align: center;
  }

  .ai-our-story-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 12px;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-our-story-card-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    line-height: 1.5;
    margin: 0;
  }

  .ai-our-story-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    transition: background-color 0.3s ease;
    border: none;
    cursor: pointer;
    text-align: center;
  }

  .ai-our-story-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-our-story-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }

    .ai-our-story-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-our-story-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.9);
    }

    .ai-our-story-image-caption-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.caption_size }}px * 0.9);
    }

    .ai-our-story-caption-icon-{{ ai_gen_id }} {
      width: calc({{ block.settings.icon_size }}px * 0.9);
      height: calc({{ block.settings.icon_size }}px * 0.9);
    }

    .ai-our-story-card-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.card_title_size }}px * 0.9);
    }

    .ai-our-story-card-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.card_text_size }}px * 0.9);
    }
  }
{% endstyle %}

<our-story-{{ ai_gen_id }} class="ai-our-story-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-our-story-container-{{ ai_gen_id }}">
    <div class="ai-our-story-content-{{ ai_gen_id }}">
      <div class="ai-our-story-image-wrapper-{{ ai_gen_id }}">
        <div>
          {% if block.settings.image %}
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              class="ai-our-story-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-our-story-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-our-story-empty-state-{{ ai_gen_id }}">
                Next, add an image
              </div>
            </div>
          {% endif %}
        </div>

        {% if block.settings.image_caption != blank %}
          <div class="ai-our-story-image-caption-{{ ai_gen_id }}">
            {% if block.settings.show_icon %}
              <span class="ai-our-story-caption-icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-5a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"></path>
                  <path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"></path>
                  <circle cx="20" cy="10" r="2"></circle>
                </svg>
              </span>
            {% endif %}
            <span>{{ block.settings.image_caption }}</span>
          </div>
        {% endif %}
      </div>

      <div class="ai-our-story-text-wrapper-{{ ai_gen_id }}">
        {% if block.settings.subheading != blank %}
          <div class="ai-our-story-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="ai-our-story-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.story_text != blank %}
          <div class="ai-our-story-text-{{ ai_gen_id }}">
            {{ block.settings.story_text }}
          </div>
        {% endif %}

        {% if block.settings.show_cards %}
          <div class="ai-our-story-cards-{{ ai_gen_id }}">
            {% for i in (1..3) %}
              {% liquid
                assign card_title_key = 'card_' | append: i | append: '_title'
                assign card_text_key = 'card_' | append: i | append: '_text'
                
                assign card_title = block.settings[card_title_key]
                assign card_text = block.settings[card_text_key]
              %}
              
              <div class="ai-our-story-card-{{ ai_gen_id }}">
                {% if card_title != blank %}
                  <h3 class="ai-our-story-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
                {% endif %}
                
                {% if card_text != blank %}
                  <p class="ai-our-story-card-text-{{ ai_gen_id }}">{{ card_text }}</p>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {% if block.settings.button_text != blank and block.settings.button_link != blank %}
          <div>
            <a href="{{ block.settings.button_link }}" class="ai-our-story-button-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</our-story-{{ ai_gen_id }}>

{% schema %}
