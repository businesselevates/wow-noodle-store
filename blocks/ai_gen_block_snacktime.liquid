{% comment %}
  Age Bundle: "What snack time looks like" (Block 12).
  Heading, four items with line icons instead of numbers, one button.
  Icons: label, melt, box, step (plus check, star, heart, none).
{% endcomment %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .st-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.section_bg }};
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
  }
  .st-inner-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }
  .st-heading-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
  }
  .st-list-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: {% if block.settings.layout == 'grid' %}repeat(2, 1fr){% else %}1fr{% endif %};
    gap: {{ block.settings.item_gap }}px;
  }
  .st-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.item_inner_gap }}px;
    background: {{ block.settings.card_bg }};
    border-radius: {{ block.settings.card_radius }}px;
    padding: {{ block.settings.card_padding }}px;
  }
  .st-icon-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: {{ block.settings.icon_box }}px;
    height: {{ block.settings.icon_box }}px;
    border-radius: 50%;
    background: {{ block.settings.icon_bg }};
    color: {{ block.settings.icon_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .st-icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .st-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.35;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0;
  }
  .st-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
    color: {{ block.settings.text_color }};
    margin: 6px 0 0;
  }
  .st-cta-{{ ai_gen_id }} {
    text-align: center;
    margin-top: {{ block.settings.button_spacing }}px;
  }
  .st-button-{{ ai_gen_id }} {
    display: inline-block;
    text-decoration: none;
    font-weight: 700;
    font-size: {{ block.settings.button_size }}px;
    padding: {{ block.settings.button_padding_v }}px {{ block.settings.button_padding_h }}px;
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_bg }};
    color: {{ block.settings.button_text_color }};
    transition: background-color .15s ease, color .15s ease;
  }
  .st-button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_bg }};
    color: {{ block.settings.button_hover_text }};
  }
  @media screen and (max-width: 749px) {
    .st-{{ ai_gen_id }} { padding: {{ block.settings.padding_top | times: 0.6 | round }}px 16px {{ block.settings.padding_bottom | times: 0.6 | round }}px; }
    .st-heading-{{ ai_gen_id }} { font-size: {{ block.settings.heading_size | times: 0.75 | round }}px; }
    .st-list-{{ ai_gen_id }} { grid-template-columns: 1fr; }
    .st-item-{{ ai_gen_id }} { padding: {{ block.settings.card_padding | times: 0.7 | round }}px; }
    .st-icon-{{ ai_gen_id }} { width: {{ block.settings.icon_box | times: 0.8 | round }}px; height: {{ block.settings.icon_box | times: 0.8 | round }}px; }
  }
{% endstyle %}

{% capture icon_label %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9-9-9z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>{% endcapture %}
{% capture icon_melt %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14v7c0 1.5-1 2.5-2 2.5s-1.8 1.2-1.8 2.7S14 19 13 19s-1.5-1.5-1.5-3-1-2.2-2-2.2S7 15 7 16.5 6 19 5 19"/><path d="M5 4v7"/><path d="M19 4v3"/></svg>{% endcapture %}
{% capture icon_box %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8l9-4 9 4v9l-9 4-9-4z"/><path d="M3 8l9 4 9-4"/><path d="M12 12v9"/><path d="M7.5 6l9 4"/></svg>{% endcapture %}
{% capture icon_step %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 20h5v-5h5v-5h5V5"/><path d="M14 5h4v4"/></svg>{% endcapture %}
{% capture icon_check %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>{% endcapture %}
{% capture icon_star %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.4l-5.7 3.1 1.2-6.4L2.8 9.7l6.4-.8z"/></svg>{% endcapture %}
{% capture icon_heart %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.6-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.4-7 10-7 10z"/></svg>{% endcapture %}

<div class="st-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="st-inner-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="st-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="st-list-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign k_title = 'item_' | append: i | append: '_title'
          assign k_text = 'item_' | append: i | append: '_text'
          assign k_icon = 'item_' | append: i | append: '_icon'
          assign i_title = block.settings[k_title]
          assign i_text = block.settings[k_text]
          assign i_icon = block.settings[k_icon]
        %}
        {% if i_title != blank %}
          <div class="st-item-{{ ai_gen_id }}">
            {% if i_icon != 'none' %}
              <div class="st-icon-{{ ai_gen_id }}">
                {%- case i_icon -%}
                  {%- when 'label' -%}{{ icon_label }}
                  {%- when 'melt' -%}{{ icon_melt }}
                  {%- when 'box' -%}{{ icon_box }}
                  {%- when 'step' -%}{{ icon_step }}
                  {%- when 'check' -%}{{ icon_check }}
                  {%- when 'star' -%}{{ icon_star }}
                  {%- when 'heart' -%}{{ icon_heart }}
                {%- endcase -%}
              </div>
            {% endif %}
            <div>
              <p class="st-title-{{ ai_gen_id }}">{{ i_title }}</p>
              {% if i_text != blank %}<p class="st-text-{{ ai_gen_id }}">{{ i_text }}</p>{% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.button_text != blank %}
      <div class="st-cta-{{ ai_gen_id }}">
        <a class="st-button-{{ ai_gen_id }}" href="{{ block.settings.button_link | default: '#MainContent' }}">{{ block.settings.button_text }}</a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Snack time list",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "container_width", "min": 700, "max": 1400, "step": 20, "unit": "px", "label": "Container width", "default": 1100 },
    { "type": "select", "id": "layout", "label": "Items layout", "options": [ { "value": "list", "label": "One per row" }, { "value": "grid", "label": "Two columns" } ], "default": "list" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 56 },
    { "type": "range", "id": "heading_spacing", "min": 8, "max": 60, "step": 2, "unit": "px", "label": "Space under heading", "default": 28 },
    { "type": "range", "id": "item_gap", "min": 6, "max": 40, "step": 2, "unit": "px", "label": "Gap between items", "default": 16 },
    { "type": "range", "id": "item_inner_gap", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Gap between icon and text", "default": 20 },
    { "type": "range", "id": "card_padding", "min": 8, "max": 48, "step": 2, "unit": "px", "label": "Item padding", "default": 24 },
    { "type": "range", "id": "card_radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Item corner radius", "default": 12 },
    { "type": "range", "id": "icon_box", "min": 36, "max": 96, "step": 2, "unit": "px", "label": "Icon circle size", "default": 56 },
    { "type": "range", "id": "icon_size", "min": 16, "max": 48, "step": 1, "unit": "px", "label": "Icon size", "default": 28 },
    { "type": "range", "id": "button_spacing", "min": 8, "max": 80, "step": 4, "unit": "px", "label": "Space above button", "default": 32 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#1b2e5c" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#ffffff" },
    { "type": "color", "id": "card_bg", "label": "Item background", "default": "#ffffff" },
    { "type": "color", "id": "title_color", "label": "Item title", "default": "#1b2e5c" },
    { "type": "color", "id": "text_color", "label": "Item text", "default": "#1b2e5c" },
    { "type": "color", "id": "icon_bg", "label": "Icon circle background", "default": "#e4f8ff" },
    { "type": "color", "id": "icon_color", "label": "Icon", "default": "#1b2e5c" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#eef6fc" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#1b2e5c" },
    { "type": "color", "id": "button_hover_bg", "label": "Button hover background", "default": "#5ec2e7" },
    { "type": "color", "id": "button_hover_text", "label": "Button hover text", "default": "#ffffff" },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "min": 20, "max": 56, "step": 1, "unit": "px", "label": "Heading size", "default": 32 },
    { "type": "range", "id": "title_size", "min": 14, "max": 28, "step": 1, "unit": "px", "label": "Item title size", "default": 18 },
    { "type": "range", "id": "text_size", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Item text size", "default": 15 },
    { "type": "range", "id": "button_size", "min": 12, "max": 20, "step": 1, "unit": "px", "label": "Button text size", "default": 16 },
    { "type": "range", "id": "button_padding_v", "min": 6, "max": 24, "step": 1, "unit": "px", "label": "Button vertical padding", "default": 12 },
    { "type": "range", "id": "button_padding_h", "min": 12, "max": 60, "step": 2, "unit": "px", "label": "Button horizontal padding", "default": 30 },
    { "type": "range", "id": "button_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Button corner radius", "default": 40 },

    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What snack time looks like with the right age on the box" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Buy now" },
    { "type": "url", "id": "button_link", "label": "Button link" },

    { "type": "header", "content": "Item 1" },
    { "type": "select", "id": "item_1_icon", "label": "Icon", "options": [ { "value": "label", "label": "Label" }, { "value": "melt", "label": "Melting shape" }, { "value": "box", "label": "Delivery box" }, { "value": "step", "label": "Upward step" }, { "value": "check", "label": "Check" }, { "value": "star", "label": "Star" }, { "value": "heart", "label": "Heart" }, { "value": "none", "label": "No icon" } ], "default": "label" },
    { "type": "text", "id": "item_1_title", "label": "Title", "default": "You stop re-reading the label. The age on the box is the answer." },
    { "type": "textarea", "id": "item_1_text", "label": "Text (optional)" },

    { "type": "header", "content": "Item 2" },
    { "type": "select", "id": "item_2_icon", "label": "Icon", "options": [ { "value": "label", "label": "Label" }, { "value": "melt", "label": "Melting shape" }, { "value": "box", "label": "Delivery box" }, { "value": "step", "label": "Upward step" }, { "value": "check", "label": "Check" }, { "value": "star", "label": "Star" }, { "value": "heart", "label": "Heart" }, { "value": "none", "label": "No icon" } ], "default": "melt" },
    { "type": "text", "id": "item_2_title", "label": "Title", "default": "Texture stops being a worry. Melt-on-contact for the little ones, crunch only once they are ready." },
    { "type": "textarea", "id": "item_2_text", "label": "Text (optional)" },

    { "type": "header", "content": "Item 3" },
    { "type": "select", "id": "item_3_icon", "label": "Icon", "options": [ { "value": "label", "label": "Label" }, { "value": "melt", "label": "Melting shape" }, { "value": "box", "label": "Delivery box" }, { "value": "step", "label": "Upward step" }, { "value": "check", "label": "Check" }, { "value": "star", "label": "Star" }, { "value": "heart", "label": "Heart" }, { "value": "none", "label": "No icon" } ], "default": "box" },
    { "type": "text", "id": "item_3_title", "label": "Title", "default": "Running out on a Tuesday stops. One delivery is about two months of snacks." },
    { "type": "textarea", "id": "item_3_text", "label": "Text (optional)" },

    { "type": "header", "content": "Item 4" },
    { "type": "select", "id": "item_4_icon", "label": "Icon", "options": [ { "value": "label", "label": "Label" }, { "value": "melt", "label": "Melting shape" }, { "value": "box", "label": "Delivery box" }, { "value": "step", "label": "Upward step" }, { "value": "check", "label": "Check" }, { "value": "star", "label": "Star" }, { "value": "heart", "label": "Heart" }, { "value": "none", "label": "No icon" } ], "default": "step" },
    { "type": "text", "id": "item_4_title", "label": "Title", "default": "When they outgrow this box, the next age is one tap away." },
    { "type": "textarea", "id": "item_4_text", "label": "Text (optional)" }
  ],
  "presets": [ { "name": "Snack time list" } ]
}
{% endschema %}