{% doc %}
  @prompt
    Two-column layout: subheading + heading on top, then 3 stacked feature cards on
    the left and an image on the right. Card 1 keeps the verified badge. Large side
    whitespace. Each element editable. Stacks on mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-cards-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 0;
  }

  .ai-feature-cards-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.side_padding }}px;
  }

  .ai-feature-cards-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .ai-feature-cards-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 12px 0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-feature-cards-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-weight: 700;
  }

  .ai-feature-layout-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: {{ 100 | minus: block.settings.image_ratio }}fr {{ block.settings.image_ratio }}fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: stretch;
  }

  .ai-feature-cards-grid-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.card_gap }}px;
    min-width: 0;
  }

  .ai-feature-image-col-{{ ai_gen_id }} {
    min-width: 0;
  }

  .ai-feature-image-wrapper-{{ ai_gen_id }} {
    height: 100%;
    min-height: 280px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-feature-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-feature-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: 280px;
    background-color: #f0f0ea;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-feature-image-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  .ai-feature-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    position: relative;
  }

  .ai-feature-card-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_background }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    color: {{ block.settings.icon_color }};
  }

  .ai-feature-card-icon-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.6);
    height: calc({{ block.settings.icon_size }}px * 0.6);
  }

  .ai-feature-card-content-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-feature-card-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_subtitle_size }}px;
    color: {{ block.settings.card_subtitle_color }};
    margin: 0 0 8px 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-feature-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 12px 0;
    font-weight: 600;
  }

  .ai-feature-card-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-feature-card-badge-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.card_padding }}px;
    right: {{ block.settings.card_padding }}px;
    display: flex;
    align-items: center;
    gap: 4px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: {{ block.settings.badge_text_size }}px;
    font-weight: 500;
  }

  .ai-feature-card-badge-{{ ai_gen_id }} svg {
    width: 16px;
    height: 16px;
  }

  @media screen and (max-width: 749px) {
    .ai-feature-cards-container-{{ ai_gen_id }} {
      padding: 0 20px;
    }

    .ai-feature-layout-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.card_gap }}px;
    }

    {% if block.settings.image_mobile_position == 'above' %}
      .ai-feature-image-col-{{ ai_gen_id }} {
        order: -1;
      }
    {% endif %}

    .ai-feature-image-wrapper-{{ ai_gen_id }},
    .ai-feature-image-placeholder-{{ ai_gen_id }} {
      height: auto;
      min-height: 0;
    }

    .ai-feature-image-wrapper-{{ ai_gen_id }} img {
      height: auto;
    }

    .ai-feature-cards-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-feature-cards-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-cards-container-{{ ai_gen_id }}">
    <div class="ai-feature-cards-header-{{ ai_gen_id }}">
      {% if block.settings.subheading != blank %}
        <div class="ai-feature-cards-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h2 class="ai-feature-cards-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
    </div>

    <div class="ai-feature-layout-{{ ai_gen_id }}">
      <div class="ai-feature-cards-grid-{{ ai_gen_id }}">
        <div class="ai-feature-card-{{ ai_gen_id }}">
          {% if block.settings.card_1_show_badge %}
            <div class="ai-feature-card-badge-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              {{ block.settings.badge_text }}
            </div>
          {% endif %}
          <div class="ai-feature-card-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div class="ai-feature-card-content-{{ ai_gen_id }}">
            {% if block.settings.card_1_subtitle != blank %}
              <div class="ai-feature-card-subtitle-{{ ai_gen_id }}">{{ block.settings.card_1_subtitle }}</div>
            {% endif %}
            {% if block.settings.card_1_title != blank %}
              <h3 class="ai-feature-card-title-{{ ai_gen_id }}">{{ block.settings.card_1_title }}</h3>
            {% endif %}
            {% if block.settings.card_1_text != blank %}
              <div class="ai-feature-card-text-{{ ai_gen_id }}">{{ block.settings.card_1_text }}</div>
            {% endif %}
          </div>
        </div>

        <div class="ai-feature-card-{{ ai_gen_id }}">
          <div class="ai-feature-card-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
              <path d="M2 17l10 5 10-5"></path>
              <path d="M2 12l10 5 10-5"></path>
            </svg>
          </div>
          <div class="ai-feature-card-content-{{ ai_gen_id }}">
            {% if block.settings.card_2_subtitle != blank %}
              <div class="ai-feature-card-subtitle-{{ ai_gen_id }}">{{ block.settings.card_2_subtitle }}</div>
            {% endif %}
            {% if block.settings.card_2_title != blank %}
              <h3 class="ai-feature-card-title-{{ ai_gen_id }}">{{ block.settings.card_2_title }}</h3>
            {% endif %}
            {% if block.settings.card_2_text != blank %}
              <div class="ai-feature-card-text-{{ ai_gen_id }}">{{ block.settings.card_2_text }}</div>
            {% endif %}
          </div>
        </div>

        <div class="ai-feature-card-{{ ai_gen_id }}">
          <div class="ai-feature-card-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </div>
          <div class="ai-feature-card-content-{{ ai_gen_id }}">
            {% if block.settings.card_3_subtitle != blank %}
              <div class="ai-feature-card-subtitle-{{ ai_gen_id }}">{{ block.settings.card_3_subtitle }}</div>
            {% endif %}
            {% if block.settings.card_3_title != blank %}
              <h3 class="ai-feature-card-title-{{ ai_gen_id }}">{{ block.settings.card_3_title }}</h3>
            {% endif %}
            {% if block.settings.card_3_text != blank %}
              <div class="ai-feature-card-text-{{ ai_gen_id }}">{{ block.settings.card_3_text }}</div>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="ai-feature-image-col-{{ ai_gen_id }}">
        {% if block.settings.side_image %}
          <div class="ai-feature-image-wrapper-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.side_image | image_url: width: 1200 }}"
              alt="{{ block.settings.side_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.side_image.width }}"
              height="{{ block.settings.side_image.height }}"
            >
          </div>
        {% else %}
          <div class="ai-feature-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature cards",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 600,
      "max": 1400,
      "step": 100,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Side padding",
      "min": 20,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Header text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Image (right column)"
    },
    {
      "type": "image_picker",
      "id": "side_image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_ratio",
      "label": "Image column width",
      "min": 30,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between cards and image",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "image_mobile_position",
      "label": "Image position on mobile",
      "options": [
        { "value": "below", "label": "Below cards" },
        { "value": "above", "label": "Above cards" }
      ],
      "default": "below"
    },
    {
      "type": "header",
      "content": "Top section"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Age-specific formulation"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#8a9466"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right snack for your child's stage."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#3f4e1f"
    },
    {
      "type": "header",
      "content": "Cards style"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_border_width",
      "label": "Border width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Border color",
      "default": "#e0e0d4"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Padding",
      "min": 15,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 25
    },
    {
      "type": "header",
      "content": "Icon style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 30,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 45
    },
    {
      "type": "color",
      "id": "icon_background",
      "label": "Background",
      "default": "#eef3e6"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#3f4e1f"
    },
    {
      "type": "range",
      "id": "icon_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Card text style"
    },
    {
      "type": "range",
      "id": "card_subtitle_size",
      "label": "Subtitle size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "card_subtitle_color",
      "label": "Subtitle color",
      "default": "#999999"
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Title size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Title color",
      "default": "#2b2b22"
    },
    {
      "type": "range",
      "id": "card_text_size",
      "label": "Text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Card 1"
    },
    {
      "type": "text",
      "id": "card_1_subtitle",
      "label": "Subtitle",
      "default": "6M+ | First Explorers"
    },
    {
      "type": "text",
      "id": "card_1_title",
      "label": "Title",
      "default": "1-3 melts, 1-2x per week"
    },
    {
      "type": "textarea",
      "id": "card_1_text",
      "label": "Text",
      "default": "Introduce gradually, help babies explore new textures safely."
    },
    {
      "type": "checkbox",
      "id": "card_1_show_badge",
      "label": "Show verified badge",
      "default": true
    },
    {
      "type": "header",
      "content": "Card 2"
    },
    {
      "type": "text",
      "id": "card_2_subtitle",
      "label": "Subtitle",
      "default": "12M+ | Growing Adventurers"
    },
    {
      "type": "text",
      "id": "card_2_title",
      "label": "Title",
      "default": "3-6 melts, 2-3x per week"
    },
    {
      "type": "textarea",
      "id": "card_2_text",
      "label": "Text",
      "default": "Baby grows more confident with textures and bolder tastes."
    },
    {
      "type": "header",
      "content": "Card 3"
    },
    {
      "type": "text",
      "id": "card_3_subtitle",
      "label": "Subtitle",
      "default": "18M+ | Confident Eaters"
    },
    {
      "type": "text",
      "id": "card_3_title",
      "label": "Title",
      "default": "Up to 1 pack, several times per week"
    },
    {
      "type": "textarea",
      "id": "card_3_text",
      "label": "Text",
      "default": "May be served more regularly as part of a balanced diet."
    },
    {
      "type": "header",
      "content": "Badge style"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Verified"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Background",
      "default": "#7c8a4f"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "badge_text_size",
      "label": "Text size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "badge_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Feature cards"
    }
  ]
}
{% endschema %}
