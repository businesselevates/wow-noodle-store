{% doc %}
  @prompt
    Generate a section with sub heading, heading, text, 2 button on 1 line, sub text. Each button can adjust color, text, border seperately. all the content & visual align on the left. , let me adjust the vertical space padding on right and left side
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-content-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding_vertical }}px {{ block.settings.section_padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-content-section__wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_spacing }}px;
    text-align: left;
    align-items: flex-start;
  }

  .ai-content-section__subheading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .ai-content-section__heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-content-section__text-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-content-section__buttons-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.button_gap }}px;
    flex-wrap: wrap;
  }

  .ai-content-section__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    font-weight: 500;
  }

  .ai-content-section__button-1-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_1_bg_color }};
    color: {{ block.settings.button_1_text_color }};
    border: {{ block.settings.button_1_border_width }}px solid {{ block.settings.button_1_border_color }};
    border-radius: {{ block.settings.button_1_border_radius }}px;
  }

  .ai-content-section__button-1-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_1_hover_bg_color }};
    color: {{ block.settings.button_1_hover_text_color }};
  }

  .ai-content-section__button-2-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_2_bg_color }};
    color: {{ block.settings.button_2_text_color }};
    border: {{ block.settings.button_2_border_width }}px solid {{ block.settings.button_2_border_color }};
    border-radius: {{ block.settings.button_2_border_radius }}px;
  }

  .ai-content-section__button-2-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_2_hover_bg_color }};
    color: {{ block.settings.button_2_hover_text_color }};
  }

  .ai-content-section__subtext-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.subtext_color }};
    font-style: italic;
  }

  @media screen and (max-width: 749px) {
    .ai-content-section__buttons-{{ ai_gen_id }} {
      flex-direction: column;
      width: 100%;
    }

    .ai-content-section__button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-content-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-content-section__wrapper-{{ ai_gen_id }}">
    {% if block.settings.subheading != blank %}
      <p class="ai-content-section__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h2 class="ai-content-section__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.text != blank %}
      <div class="ai-content-section__text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
    {% endif %}

    <div class="ai-content-section__buttons-{{ ai_gen_id }}">
      {% if block.settings.button_1_text != blank %}
        <a
          href="{{ block.settings.button_1_link }}"
          class="ai-content-section__button-{{ ai_gen_id }} ai-content-section__button-1-{{ ai_gen_id }}"
        >
          {{ block.settings.button_1_text }}
        </a>
      {% endif %}

      {% if block.settings.button_2_text != blank %}
        <a
          href="{{ block.settings.button_2_link }}"
          class="ai-content-section__button-{{ ai_gen_id }} ai-content-section__button-2-{{ ai_gen_id }}"
        >
          {{ block.settings.button_2_text }}
        </a>
      {% endif %}
    </div>

    {% if block.settings.subtext != blank %}
      <p class="ai-content-section__subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</p>
    {% endif %}
  </div>
</div>

