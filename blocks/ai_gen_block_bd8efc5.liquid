{% doc %}
  @prompt
    create a section with sub heading, heading, text, sub text. Under it is 3 card on 1 line. Each card have icon on the left, text elementor on the right, then title, subtitle, text, sub text. have content position for me to adjust., add subtext below card, add 1 text element below 3 cards
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-feature-section__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-feature-section__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.content_position }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-feature-section__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-feature-section__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    line-height: 1.2;
  }

  .ai-feature-section__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.text_spacing }}px;
    line-height: 1.6;
  }

  .ai-feature-section__subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.subtext_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-feature-section__cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin-bottom: {{ block.settings.cards_bottom_spacing }}px;
  }

  .ai-feature-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.card_content_gap }}px;
    padding: {{ block.settings.card_padding }}px;
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
  }

  .ai-feature-card__inner-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_content_gap }}px;
  }

  .ai-feature-card__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-card__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_color }};
  }

  .ai-feature-card__content-{{ ai_gen_id }} {
    flex-grow: 1;
    text-align: {{ block.settings.card_content_position }};
  }

  .ai-feature-card__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 {{ block.settings.card_title_spacing }}px;
    font-weight: 600;
  }

  .ai-feature-card__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_subtitle_size }}px;
    color: {{ block.settings.card_subtitle_color }};
    margin: 0 0 {{ block.settings.card_subtitle_spacing }}px;
  }

  .ai-feature-card__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    margin: 0 0 {{ block.settings.card_text_spacing }}px;
    line-height: 1.5;
  }

  .ai-feature-card__subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_subtext_size }}px;
    color: {{ block.settings.card_subtext_color }};
    margin: 0;
    line-height: 1.4;
  }

  .ai-feature-card__bottom-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_bottom_subtext_size }}px;
    color: {{ block.settings.card_bottom_subtext_color }};
    margin: 0;
    line-height: 1.4;
    text-align: {{ block.settings.card_content_position }};
    padding-top: {{ block.settings.card_bottom_subtext_spacing }}px;
  }

  .ai-feature-section__footer-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.footer_text_size }}px;
    color: {{ block.settings.footer_text_color }};
    text-align: {{ block.settings.footer_text_position }};
    margin: 0;
    line-height: 1.6;
  }

  @media screen and (max-width: 989px) {
    .ai-feature-section__cards-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-feature-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px {{ block.settings.section_padding_horizontal | times: 0.7 }}px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-feature-section__cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-feature-section__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<feature-section-{{ ai_gen_id }} class="ai-feature-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-section__container-{{ ai_gen_id }}">
    <div class="ai-feature-section__header-{{ ai_gen_id }}">
      {% if block.settings.subheading != blank %}
        <div class="ai-feature-section__subheading-{{ ai_gen_id }}">
          {{ block.settings.subheading }}
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-feature-section__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-feature-section__text-{{ ai_gen_id }}">
          {{ block.settings.text }}
        </div>
      {% endif %}

      {% if block.settings.subtext != blank %}
        <div class="ai-feature-section__subtext-{{ ai_gen_id }}">
          {{ block.settings.subtext }}
        </div>
      {% endif %}
    </div>

    <div class="ai-feature-section__cards-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign title_key = 'card_' | append: i | append: '_title'
          assign subtitle_key = 'card_' | append: i | append: '_subtitle'
          assign text_key = 'card_' | append: i | append: '_text'
          assign subtext_key = 'card_' | append: i | append: '_subtext'
          assign bottom_subtext_key = 'card_' | append: i | append: '_bottom_subtext'
          assign icon_key = 'card_' | append: i | append: '_icon'

          assign card_title = block.settings[title_key]
          assign card_subtitle = block.settings[subtitle_key]
          assign card_text = block.settings[text_key]
          assign card_subtext = block.settings[subtext_key]
          assign card_bottom_subtext = block.settings[bottom_subtext_key]
          assign card_icon = block.settings[icon_key]
        %}

        <div class="ai-feature-card-{{ ai_gen_id }}">
          <div class="ai-feature-card__inner-{{ ai_gen_id }}">
            <div class="ai-feature-card__icon-{{ ai_gen_id }}">
              {% case card_icon %}
                {% when 'check' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                {% when 'star' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
                {% when 'heart' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                {% when 'shield' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
                {% when 'truck' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                  </svg>
                {% when 'gift' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 12 20 22 4 22 4 12"></polyline>
                    <rect x="2" y="7" width="20" height="5"></rect>
                    <line x1="12" y1="22" x2="12" y2="7"></line>
                    <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                    <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                  </svg>
                {% else %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
              {% endcase %}
            </div>

            <div class="ai-feature-card__content-{{ ai_gen_id }}">
              {% if card_title != blank %}
                <h3 class="ai-feature-card__title-{{ ai_gen_id }}">
                  {{ card_title }}
                </h3>
              {% endif %}

              {% if card_subtitle != blank %}
                <div class="ai-feature-card__subtitle-{{ ai_gen_id }}">
                  {{ card_subtitle }}
                </div>
              {% endif %}

              {% if card_text != blank %}
                <div class="ai-feature-card__text-{{ ai_gen_id }}">
                  {{ card_text }}
                </div>
              {% endif %}

              {% if card_subtext != blank %}
                <div class="ai-feature-card__subtext-{{ ai_gen_id }}">
                  {{ card_subtext }}
                </div>
              {% endif %}
            </div>
          </div>

          {% if card_bottom_subtext != blank %}
            <div class="ai-feature-card__bottom-subtext-{{ ai_gen_id }}">
              {{ card_bottom_subtext }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if block.settings.footer_text != blank %}
      <div class="ai-feature-section__footer-text-{{ ai_gen_id }}">
        {{ block.settings.footer_text }}
      </div>
    {% endif %}
  </div>
</feature-section-{{ ai_gen_id }}>

<script>
  (function() {
    class FeatureSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('feature-section-{{ ai_gen_id }}', FeatureSection{{ ai_gen_id }});
  })();
</script>

