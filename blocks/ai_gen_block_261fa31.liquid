{% doc %}
  @prompt
    Create a section with structure like this:
    
    Section 1: introduction
    - heading
    - 4 card in 1 line. each card have icon and title. 
    
    Section 2: needed
    - 4 horizontal card, 1 line 1 card
    - each card have numberic on left, title, text. 
    
    section 3:
    - heading
    - text
    - button
    
    allow me to adjust text, size, color, background of each element, card, etc independently. keep all content and card in container, have position aligment,., allow me to change icon color and choose icon from library
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-multi-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-multi-section-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.container_padding_vertical }}px {{ block.settings.container_padding_horizontal }}px;
  }

  .ai-section-intro-{{ ai_gen_id }} {
    text-align: {{ block.settings.intro_alignment }};
    margin-bottom: {{ block.settings.intro_spacing }}px;
  }

  .ai-section-intro-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.intro_heading_size }}px;
    color: {{ block.settings.intro_heading_color }};
    margin: 0 0 {{ block.settings.intro_heading_margin }}px;
  }

  .ai-intro-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.intro_cards_gap }}px;
    margin-top: {{ block.settings.intro_cards_spacing }}px;
  }

  .ai-intro-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.intro_card_bg }};
    border: {{ block.settings.intro_card_border_width }}px solid {{ block.settings.intro_card_border_color }};
    border-radius: {{ block.settings.intro_card_radius }}px;
    padding: {{ block.settings.intro_card_padding }}px;
    text-align: {{ block.settings.intro_card_alignment }};
  }

  .ai-intro-card-icon-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.intro_icon_color }};
    margin-bottom: {{ block.settings.intro_icon_spacing }}px;
  }

  .ai-intro-card-icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.intro_icon_size }}px;
    height: {{ block.settings.intro_icon_size }}px;
    fill: currentColor;
  }

  .ai-intro-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.intro_card_title_size }}px;
    color: {{ block.settings.intro_card_title_color }};
    margin: 0;
  }

  .ai-section-needed-{{ ai_gen_id }} {
    margin-top: {{ block.settings.needed_section_spacing }}px;
  }

  .ai-needed-cards-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.needed_cards_gap }}px;
  }

  .ai-needed-card-{{ ai_gen_id }} {
    display: flex;
    align-items: {{ block.settings.needed_card_align }};
    gap: {{ block.settings.needed_card_gap }}px;
    background-color: {{ block.settings.needed_card_bg }};
    border: {{ block.settings.needed_card_border_width }}px solid {{ block.settings.needed_card_border_color }};
    border-radius: {{ block.settings.needed_card_radius }}px;
    padding: {{ block.settings.needed_card_padding }}px;
  }

  .ai-needed-number-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.needed_number_size }}px;
    height: {{ block.settings.needed_number_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.needed_number_bg }};
    color: {{ block.settings.needed_number_color }};
    border-radius: {{ block.settings.needed_number_radius }}px;
    font-size: {{ block.settings.needed_number_font_size }}px;
    font-weight: 700;
  }

  .ai-needed-content-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-needed-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.needed_title_size }}px;
    color: {{ block.settings.needed_title_color }};
    margin: 0 0 {{ block.settings.needed_title_margin }}px;
  }

  .ai-needed-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.needed_text_size }}px;
    color: {{ block.settings.needed_text_color }};
    margin: 0;
  }

  .ai-section-cta-{{ ai_gen_id }} {
    text-align: {{ block.settings.cta_alignment }};
    margin-top: {{ block.settings.cta_section_spacing }}px;
  }

  .ai-cta-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.cta_heading_size }}px;
    color: {{ block.settings.cta_heading_color }};
    margin: 0 0 {{ block.settings.cta_heading_margin }}px;
  }

  .ai-cta-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.cta_text_size }}px;
    color: {{ block.settings.cta_text_color }};
    margin: 0 0 {{ block.settings.cta_text_margin }}px;
  }

  .ai-cta-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.cta_button_padding_vertical }}px {{ block.settings.cta_button_padding_horizontal }}px;
    background-color: {{ block.settings.cta_button_bg }};
    color: {{ block.settings.cta_button_color }};
    border: {{ block.settings.cta_button_border_width }}px solid {{ block.settings.cta_button_border_color }};
    border-radius: {{ block.settings.cta_button_radius }}px;
    font-size: {{ block.settings.cta_button_font_size }}px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-cta-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_button_hover_bg }};
    color: {{ block.settings.cta_button_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-intro-cards-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstyle %}

<div class="ai-multi-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-multi-section-container-{{ ai_gen_id }}">
    <div class="ai-section-intro-{{ ai_gen_id }}">
      {% if block.settings.intro_heading != blank %}
        <h2 class="ai-section-intro-heading-{{ ai_gen_id }}">{{ block.settings.intro_heading }}</h2>
      {% endif %}

      <div class="ai-intro-cards-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% liquid
            assign card_icon_key = 'intro_card_' | append: i | append: '_icon'
            assign card_title_key = 'intro_card_' | append: i | append: '_title'
            assign card_icon = block.settings[card_icon_key]
            assign card_title = block.settings[card_title_key]
          %}
          <div class="ai-intro-card-{{ ai_gen_id }}">
            {% if card_icon != blank %}
              <div class="ai-intro-card-icon-{{ ai_gen_id }}">
                {% case card_icon %}
                  {% when 'checkmark' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
                  {% when 'star' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27z"/></svg>
                  {% when 'heart' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                  {% when 'lightning' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M7 2v11h3v9l7-12h-4l4-8z"/></svg>
                  {% when 'shield' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
                  {% when 'gift' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M20 6h-2.18c.11-.31.18-.65.18-1a2.996 2.996 0 0 0-5.5-1.65l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm11 15H4v-2h16v2zm0-5H4V8h5.08L7 10.83 8.62 12 11 8.76l1-1.36 1 1.36L15.38 12 17 10.83 14.92 8H20v6z"/></svg>
                  {% when 'truck' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M18 18.5a1.5 1.5 0 0 1-1.5-1.5 1.5 1.5 0 0 1 1.5-1.5 1.5 1.5 0 0 1 1.5 1.5 1.5 1.5 0 0 1-1.5 1.5m1.5-9l1.96 2.5H17V9.5m-11 9A1.5 1.5 0 0 1 4.5 17 1.5 1.5 0 0 1 6 15.5 1.5 1.5 0 0 1 7.5 17 1.5 1.5 0 0 1 6 18.5M20 8h-3V4H3c-1.11 0-2 .89-2 2v11h2a3 3 0 0 0 3 3 3 3 0 0 0 3-3h6a3 3 0 0 0 3 3 3 3 0 0 0 3-3h2v-5l-3-4z"/></svg>
                  {% when 'clock' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm4.2 14.2L11 13V7h1.5v5.2l4.5 2.7-.8 1.3z"/></svg>
                  {% when 'globe' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
                  {% else %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
                {% endcase %}
              </div>
            {% endif %}
            {% if card_title != blank %}
              <h3 class="ai-intro-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="ai-section-needed-{{ ai_gen_id }}">
      <div class="ai-needed-cards-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% liquid
            assign card_title_key = 'needed_card_' | append: i | append: '_title'
            assign card_text_key = 'needed_card_' | append: i | append: '_text'
            assign card_title = block.settings[card_title_key]
            assign card_text = block.settings[card_text_key]
          %}
          <div class="ai-needed-card-{{ ai_gen_id }}">
            <div class="ai-needed-number-{{ ai_gen_id }}">{{ i }}</div>
            <div class="ai-needed-content-{{ ai_gen_id }}">
              {% if card_title != blank %}
                <h3 class="ai-needed-title-{{ ai_gen_id }}">{{ card_title }}</h3>
              {% endif %}
              {% if card_text != blank %}
                <p class="ai-needed-text-{{ ai_gen_id }}">{{ card_text }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="ai-section-cta-{{ ai_gen_id }}">
      {% if block.settings.cta_heading != blank %}
        <h2 class="ai-cta-heading-{{ ai_gen_id }}">{{ block.settings.cta_heading }}</h2>
      {% endif %}
      {% if block.settings.cta_text != blank %}
        <p class="ai-cta-text-{{ ai_gen_id }}">{{ block.settings.cta_text }}</p>
      {% endif %}
      {% if block.settings.cta_button_text != blank %}
        <a href="{{ block.settings.cta_button_link }}" class="ai-cta-button-{{ ai_gen_id }}">
          {{ block.settings.cta_button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
