{% doc %}
  @prompt
    AI generated
    
    
    Create a section with structure like this:
    
    Section 1: introduction
    - heading
    - 4 card in 1 line. each card have icon and title. 
    - icon color can be change and choose from library
    Section 2: needed
    - heading
    - 4 horizontal card, 1 line 1 card
    - each card have numberic on left, title, text. 
    
    section 3:
    - heading
    - text
    - button
    
    allow me to adjust text, size, color, background of each element, card, etc independently. keep all content and card in container, have position aligment,., allow me to change icon color and choose icon from library
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-multi-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-multi-section-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.container_padding }}px;
  }

  .ai-section-1-{{ ai_gen_id }} {
    background-color: {{ block.settings.section_1_bg }};
    padding: {{ block.settings.section_1_padding }}px 0;
    text-align: {{ block.settings.section_1_alignment }};
  }

  .ai-section-1-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_1_heading_size }}px;
    color: {{ block.settings.section_1_heading_color }};
    margin: 0 0 {{ block.settings.section_1_heading_margin }}px;
  }

  .ai-section-1-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.section_1_card_gap }}px;
    margin-top: {{ block.settings.section_1_cards_margin }}px;
  }

  .ai-section-1-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.section_1_card_bg }};
    border: {{ block.settings.section_1_card_border_width }}px solid {{ block.settings.section_1_card_border_color }};
    border-radius: {{ block.settings.section_1_card_radius }}px;
    padding: {{ block.settings.section_1_card_padding }}px;
    text-align: center;
  }

  .ai-section-1-icon-{{ ai_gen_id }} {
    width: {{ block.settings.section_1_icon_size }}px;
    height: {{ block.settings.section_1_icon_size }}px;
    margin: 0 auto {{ block.settings.section_1_icon_margin }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-section-1-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.section_1_icon_color }};
  }

  .ai-section-1-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_1_card_title_size }}px;
    color: {{ block.settings.section_1_card_title_color }};
    margin: 0;
  }

  .ai-section-2-{{ ai_gen_id }} {
    background-color: {{ block.settings.section_2_bg }};
    padding: {{ block.settings.section_2_padding }}px 0;
    text-align: {{ block.settings.section_2_alignment }};
  }

  .ai-section-2-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_2_heading_size }}px;
    color: {{ block.settings.section_2_heading_color }};
    margin: 0 0 {{ block.settings.section_2_heading_margin }}px;
  }

  .ai-section-2-cards-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.section_2_card_gap }}px;
    margin-top: {{ block.settings.section_2_cards_margin }}px;
  }

  .ai-section-2-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.section_2_card_bg }};
    border: {{ block.settings.section_2_card_border_width }}px solid {{ block.settings.section_2_card_border_color }};
    border-radius: {{ block.settings.section_2_card_radius }}px;
    padding: {{ block.settings.section_2_card_padding }}px;
    display: flex;
    align-items: center;
    gap: {{ block.settings.section_2_card_inner_gap }}px;
    text-align: left;
  }

  .ai-section-2-number-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_2_number_size }}px;
    color: {{ block.settings.section_2_number_color }};
    font-weight: bold;
    flex-shrink: 0;
    width: {{ block.settings.section_2_number_width }}px;
    text-align: center;
  }

  .ai-section-2-content-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-section-2-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_2_card_title_size }}px;
    color: {{ block.settings.section_2_card_title_color }};
    margin: 0 0 {{ block.settings.section_2_title_margin }}px;
  }

  .ai-section-2-card-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_2_card_text_size }}px;
    color: {{ block.settings.section_2_card_text_color }};
    margin: 0;
  }

  .ai-section-3-{{ ai_gen_id }} {
    background-color: {{ block.settings.section_3_bg }};
    padding: {{ block.settings.section_3_padding }}px 0;
    text-align: {{ block.settings.section_3_alignment }};
  }

  .ai-section-3-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_3_heading_size }}px;
    color: {{ block.settings.section_3_heading_color }};
    margin: 0 0 {{ block.settings.section_3_heading_margin }}px;
  }

  .ai-section-3-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_3_text_size }}px;
    color: {{ block.settings.section_3_text_color }};
    margin: 0 0 {{ block.settings.section_3_text_margin }}px;
  }

  .ai-section-3-button-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.section_3_button_bg }};
    color: {{ block.settings.section_3_button_text_color }};
    font-size: {{ block.settings.section_3_button_text_size }}px;
    padding: {{ block.settings.section_3_button_padding_v }}px {{ block.settings.section_3_button_padding_h }}px;
    border-radius: {{ block.settings.section_3_button_radius }}px;
    text-decoration: none;
    border: {{ block.settings.section_3_button_border_width }}px solid {{ block.settings.section_3_button_border_color }};
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-section-3-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.section_3_button_hover_bg }};
    color: {{ block.settings.section_3_button_hover_text }};
  }

  @media screen and (max-width: 749px) {
    .ai-section-1-cards-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-section-2-card-{{ ai_gen_id }} {
      flex-direction: column;
      text-align: center;
    }

    .ai-section-2-content-{{ ai_gen_id }} {
      text-align: center;
    }
  }
{% endstyle %}

<div class="ai-multi-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-section-1-{{ ai_gen_id }}">
    <div class="ai-multi-section-container-{{ ai_gen_id }}">
      {% if block.settings.section_1_heading != blank %}
        <h2 class="ai-section-1-heading-{{ ai_gen_id }}">{{ block.settings.section_1_heading }}</h2>
      {% endif %}

      <div class="ai-section-1-cards-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% liquid
            assign card_title_key = 'section_1_card_' | append: i | append: '_title'
            assign card_icon_key = 'section_1_card_' | append: i | append: '_icon'
            assign card_title = block.settings[card_title_key]
            assign card_icon = block.settings[card_icon_key]
          %}

          <div class="ai-section-1-card-{{ ai_gen_id }}">
            <div class="ai-section-1-icon-{{ ai_gen_id }}">
              {% if card_icon == 'check' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              {% elsif card_icon == 'star' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              {% elsif card_icon == 'heart' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              {% elsif card_icon == 'shield' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
              {% elsif card_icon == 'gift' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M20 6h-2.18c.11-.31.18-.65.18-1a2.996 2.996 0 0 0-5.5-1.65l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm11 15H4v-2h16v2zm0-5H4V8h5.08L7 10.83 8.62 12 11 8.76l1-1.36 1 1.36L15.38 12 17 10.83 14.92 8H20v6z"/></svg>
              {% elsif card_icon == 'truck' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M18 18.5a1.5 1.5 0 0 1-1.5-1.5 1.5 1.5 0 0 1 1.5-1.5 1.5 1.5 0 0 1 1.5 1.5 1.5 1.5 0 0 1-1.5 1.5m1.5-9l1.96 2.5H17V9.5m-11 9A1.5 1.5 0 0 1 4.5 17 1.5 1.5 0 0 1 6 15.5 1.5 1.5 0 0 1 7.5 17 1.5 1.5 0 0 1 6 18.5M20 8h-3V4H3c-1.11 0-2 .89-2 2v11h2a3 3 0 0 0 3 3 3 3 0 0 0 3-3h6a3 3 0 0 0 3 3 3 3 0 0 0 3-3h2v-5l-3-4z"/></svg>
              {% elsif card_icon == 'clock' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm4.2 14.2L11 13V7h1.5v5.2l4.5 2.7-.8 1.3z"/></svg>
              {% elsif card_icon == 'tag' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/></svg>
              {% else %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg>
              {% endif %}
            </div>
            {% if card_title != blank %}
              <h3 class="ai-section-1-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="ai-section-2-{{ ai_gen_id }}">
    <div class="ai-multi-section-container-{{ ai_gen_id }}">
      {% if block.settings.section_2_heading != blank %}
        <h2 class="ai-section-2-heading-{{ ai_gen_id }}">{{ block.settings.section_2_heading }}</h2>
      {% endif %}

      <div class="ai-section-2-cards-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% liquid
            assign card_title_key = 'section_2_card_' | append: i | append: '_title'
            assign card_text_key = 'section_2_card_' | append: i | append: '_text'
            assign card_title = block.settings[card_title_key]
            assign card_text = block.settings[card_text_key]
          %}

          <div class="ai-section-2-card-{{ ai_gen_id }}">
            <div class="ai-section-2-number-{{ ai_gen_id }}">{{ i }}</div>
            <div class="ai-section-2-content-{{ ai_gen_id }}">
              {% if card_title != blank %}
                <h3 class="ai-section-2-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
              {% endif %}
              {% if card_text != blank %}
                <p class="ai-section-2-card-text-{{ ai_gen_id }}">{{ card_text }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="ai-section-3-{{ ai_gen_id }}">
    <div class="ai-multi-section-container-{{ ai_gen_id }}">
      {% if block.settings.section_3_heading != blank %}
        <h2 class="ai-section-3-heading-{{ ai_gen_id }}">{{ block.settings.section_3_heading }}</h2>
      {% endif %}
      {% if block.settings.section_3_text != blank %}
        <p class="ai-section-3-text-{{ ai_gen_id }}">{{ block.settings.section_3_text }}</p>
      {% endif %}
      {% if block.settings.section_3_button_text != blank %}
        <a href="{{ block.settings.section_3_button_link }}" class="ai-section-3-button-{{ ai_gen_id }}">
          {{ block.settings.section_3_button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
