{% comment %}
  Hero with card — HLT One.

  ── ALIGNMENT ────────────────────────────────────────────────────────────────
  The card used to be positioned by padding on the outer wrapper, which measures
  from the viewport edge. The header logo measures from the theme's page
  container, which has a max-width and its own gutter. Those two only coincide
  at one screen width; everywhere else the card drifts, and the wider the screen
  the worse it gets.

  The card now sits inside an inner wrapper that mirrors the page container, so
  its left edge tracks the logo and the trust row at every width.

  "Match theme" reads --page-width and --page-margin straight off the theme, so
  it follows automatically if those ever change. If the theme doesn't define
  them, or defines them differently from the header, switch to Custom and dial
  the two numbers in from DevTools.
{% endcomment %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign card_bg_rgb = block.settings.card_background | color_to_rgb | remove: 'rgb(' | remove: ')'
  if card_bg_rgb == blank
    assign card_bg_rgb = '255, 255, 255'
  endif
  assign opacity_decimal = block.settings.card_background_opacity | divided_by: 100.0

  assign scrim_rgb = block.settings.overlay_color | color_to_rgb | remove: 'rgb(' | remove: ')'
  if scrim_rgb == blank
    assign scrim_rgb = '0, 0, 0'
  endif
  assign scrim_alpha = block.settings.overlay_opacity | divided_by: 100.0
%}

{% style %}
  .ai-hero-card-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.section_height }}px;
    display: flex;
    align-items: {{ block.settings.vertical_alignment }};
    /* vertical only: the horizontal inset now comes from the inner container,
       which is the whole point of the alignment fix */
    padding-block: {{ block.settings.section_padding }}px;
    overflow: hidden;
  }

  .ai-hero-card__background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .ai-hero-card__background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.image_position }};
    display: block;
  }

  .ai-hero-card__background-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.background_color }};
  }

  .ai-hero-card__background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Desktop: show desktop image, hide mobile image */
  .ai-hero-card__bg-desktop-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ai-hero-card__bg-mobile-{{ ai_gen_id }} {
    display: none;
    width: 100%;
    height: 100%;
  }

  /* Readability scrim. Sits above the photo, below the card. */
  .ai-hero-card__scrim-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    {%- case block.settings.overlay_style -%}
      {%- when 'left' -%}
    background: linear-gradient(to right,
      rgba({{ scrim_rgb }}, {{ scrim_alpha }}) 0%,
      rgba({{ scrim_rgb }}, {{ scrim_alpha }}) 28%,
      rgba({{ scrim_rgb }}, 0) 62%);
      {%- when 'right' -%}
    background: linear-gradient(to left,
      rgba({{ scrim_rgb }}, {{ scrim_alpha }}) 0%,
      rgba({{ scrim_rgb }}, {{ scrim_alpha }}) 28%,
      rgba({{ scrim_rgb }}, 0) 62%);
      {%- when 'bottom' -%}
    background: linear-gradient(to top,
      rgba({{ scrim_rgb }}, {{ scrim_alpha }}) 0%,
      rgba({{ scrim_rgb }}, 0) 65%);
      {%- when 'full' -%}
    background: rgba({{ scrim_rgb }}, {{ scrim_alpha }});
      {%- else -%}
    display: none;
    {%- endcase %}
  }

  /* ---- The alignment fix ----
     Mirrors the theme page container so the card's edge tracks the header
     logo and the trust row instead of the viewport edge. */
  .ai-hero-card__inner-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    justify-content: {{ block.settings.horizontal_alignment }};
    {%- if block.settings.container_mode == 'theme' %}
    max-width: var(--page-width, {{ block.settings.content_max_width }}px);
    padding-inline: var(--page-margin, {{ block.settings.content_padding }}px);
    {%- else %}
    max-width: {{ block.settings.content_max_width }}px;
    padding-inline: {{ block.settings.content_padding }}px;
    {%- endif %}
    margin-inline: auto;
  }

  .ai-hero-card__content-{{ ai_gen_id }} {
    max-width: {{ block.settings.card_max_width }}px;
    width: 100%;
    padding: {{ block.settings.card_padding }}px;
    border-radius: {{ block.settings.card_border_radius }}px;
    text-align: {{ block.settings.text_alignment }};
    background-color: rgba({{ card_bg_rgb }}, {{ opacity_decimal }});
    {%- if block.settings.card_blur > 0 %}
    /* frosts whatever sits behind the card, so a translucent card stays
       readable over a busy photo instead of only over flat areas */
    -webkit-backdrop-filter: blur({{ block.settings.card_blur }}px);
            backdrop-filter: blur({{ block.settings.card_blur }}px);
    {%- endif %}
  }

  .ai-hero-card__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    font-weight: {{ block.settings.heading_weight }};
  }

  .ai-hero-card__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
    line-height: 1.6;
  }

  .ai-hero-card__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    transition: background-color 0.3s ease;
  }

  .ai-hero-card__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  @media screen and (max-width: 749px) {
    .ai-hero-card-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_section_height }}px;
      padding-block: {{ block.settings.mobile_section_padding }}px;
      align-items: {{ block.settings.mobile_vertical_alignment }};
    }

    .ai-hero-card__inner-{{ ai_gen_id }} {
      justify-content: {{ block.settings.mobile_horizontal_alignment }};
      padding-inline: {{ block.settings.mobile_section_padding }}px;
    }

    /* Swap background images at mobile breakpoint */
    .ai-hero-card__bg-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-hero-card__bg-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-hero-card__content-{{ ai_gen_id }} {
      max-width: 100%;
      padding: {{ block.settings.card_padding | times: 0.75 | round }}px;
    }

    .ai-hero-card__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.65 | round }}px;
    }

    .ai-hero-card__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 | round }}px;
    }
  }
{% endstyle %}

<div class="ai-hero-card-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-card__background-{{ ai_gen_id }}">

    {%- comment -%} Desktop background image {%- endcomment -%}
    <div class="ai-hero-card__bg-desktop-{{ ai_gen_id }}">
      {% if block.settings.background_image %}
        <img
          src="{{ block.settings.background_image | image_url: width: 2000 }}"
          srcset="{{ block.settings.background_image | image_url: width: 1000 }} 1000w,
                  {{ block.settings.background_image | image_url: width: 1500 }} 1500w,
                  {{ block.settings.background_image | image_url: width: 2000 }} 2000w,
                  {{ block.settings.background_image | image_url: width: 2600 }} 2600w"
          sizes="100vw"
          alt="{{ block.settings.background_image.alt | escape }}"
          width="{{ block.settings.background_image.width }}"
          height="{{ block.settings.background_image.height }}"
          {%- comment -%}
            This is the largest thing above the fold, so it is the LCP element.
            Lazy-loading it makes the browser wait for layout before it even asks
            for the file, which is exactly the wrong order for a hero.
          {%- endcomment -%}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      {% else %}
        <div class="ai-hero-card__background-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    {%- comment -%} Mobile background image — falls back to desktop image if not set {%- endcomment -%}
    <div class="ai-hero-card__bg-mobile-{{ ai_gen_id }}">
      {% if block.settings.background_image_mobile %}
        <img
          src="{{ block.settings.background_image_mobile | image_url: width: 900 }}"
          srcset="{{ block.settings.background_image_mobile | image_url: width: 500 }} 500w,
                  {{ block.settings.background_image_mobile | image_url: width: 900 }} 900w,
                  {{ block.settings.background_image_mobile | image_url: width: 1300 }} 1300w"
          sizes="100vw"
          alt="{{ block.settings.background_image_mobile.alt | escape }}"
          width="{{ block.settings.background_image_mobile.width }}"
          height="{{ block.settings.background_image_mobile.height }}"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      {% elsif block.settings.background_image %}
        <img
          src="{{ block.settings.background_image | image_url: width: 900 }}"
          srcset="{{ block.settings.background_image | image_url: width: 500 }} 500w,
                  {{ block.settings.background_image | image_url: width: 900 }} 900w,
                  {{ block.settings.background_image | image_url: width: 1300 }} 1300w"
          sizes="100vw"
          alt="{{ block.settings.background_image.alt | escape }}"
          width="{{ block.settings.background_image.width }}"
          height="{{ block.settings.background_image.height }}"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      {% else %}
        <div class="ai-hero-card__background-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

  </div>

  {% if block.settings.overlay_style != 'none' %}
    <span class="ai-hero-card__scrim-{{ ai_gen_id }}" aria-hidden="true"></span>
  {% endif %}

  <div class="ai-hero-card__inner-{{ ai_gen_id }}">
    <div class="ai-hero-card__content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-hero-card__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-hero-card__text-{{ ai_gen_id }}">
          {{ block.settings.text }}
        </div>
      {% endif %}

      {% if block.settings.button_text != blank and block.settings.button_link != blank %}
        <a
          href="{{ block.settings.button_link }}"
          class="ai-hero-card__button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
