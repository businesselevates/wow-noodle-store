{% doc %}
  @prompt
    Subheading, heading, text 1 in a left-aligned centered column with adjustable tight spacing. Text 2 is centered with its own width, side padding, and top spacing.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-text-block-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-text-block__content-{{ ai_gen_id }} {
    display: block;
  }

  .ai-text-block__centered-group-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.group_spacing }}px;
    margin: 0 auto;
    max-width: {{ block.settings.content_max_width }}%;
    padding: 0 {{ block.settings.content_side_padding }}px;
  }

  .ai-text-block__subheading-{{ ai_gen_id }} {
    text-align: {{ block.settings.group_alignment }};
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0;
  }

  .ai-text-block__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.group_alignment }};
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0;
  }

  .ai-text-block__subheading-{{ ai_gen_id }} p,
  .ai-text-block__heading-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-text-block__text1-{{ ai_gen_id }} {
    text-align: {{ block.settings.group_alignment }};
    color: {{ block.settings.text1_color }};
    font-size: {{ block.settings.text1_size }}px;
  }

  .ai-text-block__text2-{{ ai_gen_id }} {
    text-align: {{ block.settings.text2_alignment }};
    color: {{ block.settings.text2_color }};
    font-size: {{ block.settings.text2_size }}px;
    max-width: {{ block.settings.text2_max_width }}%;
    margin: {{ block.settings.text2_top_spacing }}px auto 0 auto;
    padding: 0 {{ block.settings.text2_side_padding }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-text-block-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.padding_top | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px {{ block.settings.padding_bottom | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px;
    }

    .ai-text-block__centered-group-{{ ai_gen_id }} {
      max-width: 100%;
      padding: 0;
    }

    .ai-text-block__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 | round: 0 }}px;
    }

    .ai-text-block__text2-{{ ai_gen_id }} {
      max-width: 100%;
      padding: 0 {{ block.settings.text2_side_padding | times: 0.7 }}px;
    }
  }
{% endstyle %}

<div class="ai-text-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-text-block__content-{{ ai_gen_id }}">
    <div class="ai-text-block__centered-group-{{ ai_gen_id }}">
      {% if block.settings.subheading != blank %}
        <div class="ai-text-block__subheading-{{ ai_gen_id }}">
          {{ block.settings.subheading }}
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-text-block__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.text1 != blank %}
        <div class="ai-text-block__text1-{{ ai_gen_id }}">
          {{ block.settings.text1 }}
        </div>
      {% endif %}
    </div>

    {% if block.settings.text2 != blank %}
      <div class="ai-text-block__text2-{{ ai_gen_id }}">
        {{ block.settings.text2 }}
      </div>
    {% endif %}
  </div>
</div>

