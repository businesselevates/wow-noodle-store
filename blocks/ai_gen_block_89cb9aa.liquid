{% doc %}
  @prompt
    create a section with sub head, heading, text on the left. and 3 vertical image card on the right, allow me to adjust padding of this section, remove title and description in image card
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-content-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: {{ block.settings.padding_left }}px;
    padding-right: {{ block.settings.padding_right }}px;
  }

  .ai-split-content-container-{{ ai_gen_id }} {
    display: flex;
    gap: 40px;
    align-items: flex-start;
    width: 100%;
  }

  .ai-split-content-left-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-split-content-subhead-{{ ai_gen_id }} {
    font-size: {{ block.settings.subhead_size }}px;
    color: {{ block.settings.subhead_color }};
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ai-split-content-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-split-content-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-split-content-right-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-split-content-card-{{ ai_gen_id }} {
    flex: 1;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    border: {{ block.settings.card_border_thickness }}px solid {{ block.settings.card_border_color }};
    box-shadow: 0 {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
  }

  .ai-split-content-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.card_image_height }}px;
    position: relative;
  }

  .ai-split-content-card-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-split-content-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-split-content-card-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-split-content-{{ ai_gen_id }} {
      padding-left: {{ block.settings.padding_left | times: 0.5 }}px;
      padding-right: {{ block.settings.padding_right | times: 0.5 }}px;
    }

    .ai-split-content-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 32px;
    }

    .ai-split-content-right-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-split-content-card-image-{{ ai_gen_id }} {
      height: {{ block.settings.card_image_height | times: 0.8 }}px;
    }
  }
{% endstyle %}

<split-content-{{ ai_gen_id }} class="ai-split-content-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-split-content-container-{{ ai_gen_id }}">
    <div class="ai-split-content-left-{{ ai_gen_id }}">
      {% if block.settings.subhead != blank %}
        <div class="ai-split-content-subhead-{{ ai_gen_id }}">
          {{ block.settings.subhead }}
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-split-content-heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-split-content-text-{{ ai_gen_id }}">
          {{ block.settings.text }}
        </div>
      {% endif %}
    </div>

    <div class="ai-split-content-right-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'card_' | append: i | append: '_image'
          assign card_image = block.settings[image_key]
        %}

        <div class="ai-split-content-card-{{ ai_gen_id }}">
          <div class="ai-split-content-card-image-{{ ai_gen_id }}">
            {% if card_image %}
              <img
                src="{{ card_image | image_url: width: 600 }}"
                alt="{{ card_image.alt | escape }}"
                loading="lazy"
                width="{{ card_image.width }}"
                height="{{ card_image.height }}"
              >
            {% else %}
              <div class="ai-split-content-card-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</split-content-{{ ai_gen_id }}>

<script>
  (function() {
    class SplitContent{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('split-content-{{ ai_gen_id }}', SplitContent{{ ai_gen_id }});
  })();
</script>

