{% doc %}
  @prompt
    Testimonials section with 6 text-only cards (3 per row). Section has
    subheading, heading, and intro text. Each card has title, subtitle,
    text, and subtext. No images, no badges.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonials-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-testimonials-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .ai-testimonials-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-testimonials-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
  }

  .ai-testimonials-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    max-width: 700px;
    margin: 0 auto;
  }

  .ai-testimonials-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin: 0 auto;
    max-width: 1200px;
  }

  .ai-testimonial-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-testimonial-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-testimonial-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.card_title_color }};
    margin: 0;
  }

  .ai-testimonial-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_subtitle_size }}px;
    color: {{ block.settings.card_subtitle_color }};
    margin: 0;
  }

  .ai-testimonial-text-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    line-height: 1.6;
  }

  .ai-testimonial-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_subtext_size }}px;
    color: {{ block.settings.card_subtext_color }};
    font-style: italic;
  }

  @media screen and (max-width: 989px) {
    .ai-testimonials-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-testimonials-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-testimonials-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }
{% endstyle %}

<div class="ai-testimonials-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-testimonials-header-{{ ai_gen_id }}">
    {% if block.settings.subheading != blank %}
      <div class="ai-testimonials-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
    {% endif %}
    {% if block.settings.heading != blank %}
      <h2 class="ai-testimonials-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}
    {% if block.settings.text != blank %}
      <div class="ai-testimonials-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
    {% endif %}
  </div>

  <div class="ai-testimonials-grid-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign title_key = 'card_' | append: i | append: '_title'
        assign subtitle_key = 'card_' | append: i | append: '_subtitle'
        assign text_key = 'card_' | append: i | append: '_text'
        assign subtext_key = 'card_' | append: i | append: '_subtext'

        assign card_title = block.settings[title_key]
        assign card_subtitle = block.settings[subtitle_key]
        assign card_text = block.settings[text_key]
        assign card_subtext = block.settings[subtext_key]
      %}

      <div class="ai-testimonial-card-{{ ai_gen_id }}">
        <div class="ai-testimonial-content-{{ ai_gen_id }}">
          {% if card_title != blank %}
            <h3 class="ai-testimonial-title-{{ ai_gen_id }}">{{ card_title }}</h3>
          {% endif %}
          {% if card_subtitle != blank %}
            <div class="ai-testimonial-subtitle-{{ ai_gen_id }}">{{ card_subtitle }}</div>
          {% endif %}
          {% if card_text != blank %}
            <div class="ai-testimonial-text-content-{{ ai_gen_id }}">{{ card_text }}</div>
          {% endif %}
          {% if card_subtext != blank %}
            <div class="ai-testimonial-subtext-{{ ai_gen_id }}">{{ card_subtext }}</div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Section header" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Testimonials" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Hear from our satisfied customers about their experiences with our products and services.</p>" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "center" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },

    { "type": "header", "content": "Section style" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f9f7f1" },
    { "type": "color", "id": "subheading_color", "label": "Subheading color", "default": "#c8a882" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#192e59" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#5a6b8c" },
    { "type": "range", "id": "subheading_size", "label": "Subheading size", "min": 10, "max": 30, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 60, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },

    { "type": "header", "content": "Card style" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ffffff" },
    { "type": "range", "id": "card_border_radius", "label": "Card border radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "card_padding", "label": "Card padding", "min": 10, "max": 50, "step": 5, "unit": "px", "default": 20 },
    { "type": "range", "id": "card_gap", "label": "Gap between cards", "min": 10, "max": 50, "step": 5, "unit": "px", "default": 20 },
    { "type": "range", "id": "card_shadow_vertical", "label": "Shadow vertical offset", "min": 0, "max": 20, "step": 2, "unit": "px", "default": 4 },
    { "type": "range", "id": "card_shadow_blur", "label": "Shadow blur", "min": 0, "max": 40, "step": 5, "unit": "px", "default": 10 },
    { "type": "range", "id": "card_shadow_opacity", "label": "Shadow opacity", "min": 0, "max": 1, "step": 0.1, "default": 0.1 },
    { "type": "color", "id": "card_title_color", "label": "Card title color", "default": "#192e59" },
    { "type": "color", "id": "card_subtitle_color", "label": "Card subtitle color", "default": "#c8a882" },
    { "type": "color", "id": "card_text_color", "label": "Card text color", "default": "#5a6b8c" },
    { "type": "color", "id": "card_subtext_color", "label": "Card subtext color", "default": "#8baf65" },
    { "type": "range", "id": "card_title_size", "label": "Card title size", "min": 14, "max": 32, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "card_subtitle_size", "label": "Card subtitle size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "card_text_size", "label": "Card text size", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "card_subtext_size", "label": "Card subtext size", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 13 },

    { "type": "header", "content": "Card 1" },
    { "type": "text", "id": "card_1_title", "label": "Title", "default": "Excellent quality" },
    { "type": "text", "id": "card_1_subtitle", "label": "Subtitle", "default": "Sarah Johnson" },
    { "type": "richtext", "id": "card_1_text", "label": "Text", "default": "<p>The product exceeded my expectations. Highly recommend to anyone looking for quality.</p>" },
    { "type": "text", "id": "card_1_subtext", "label": "Subtext", "default": "Verified customer" },

    { "type": "header", "content": "Card 2" },
    { "type": "text", "id": "card_2_title", "label": "Title", "default": "Fast shipping" },
    { "type": "text", "id": "card_2_subtitle", "label": "Subtitle", "default": "Michael Chen" },
    { "type": "richtext", "id": "card_2_text", "label": "Text", "default": "<p>Arrived quickly and in perfect condition. Great customer service throughout.</p>" },
    { "type": "text", "id": "card_2_subtext", "label": "Subtext", "default": "Verified customer" },

    { "type": "header", "content": "Card 3" },
    { "type": "text", "id": "card_3_title", "label": "Title", "default": "Love it" },
    { "type": "text", "id": "card_3_subtitle", "label": "Subtitle", "default": "Emma Davis" },
    { "type": "richtext", "id": "card_3_text", "label": "Text", "default": "<p>Absolutely love this purchase. Will definitely be ordering again soon.</p>" },
    { "type": "text", "id": "card_3_subtext", "label": "Subtext", "default": "Verified customer" },

    { "type": "header", "content": "Card 4" },
    { "type": "text", "id": "card_4_title", "label": "Title", "default": "Great value" },
    { "type": "text", "id": "card_4_subtitle", "label": "Subtitle", "default": "James Wilson" },
    { "type": "richtext", "id": "card_4_text", "label": "Text", "default": "<p>Amazing quality for the price. Couldn't be happier with my purchase.</p>" },
    { "type": "text", "id": "card_4_subtext", "label": "Subtext", "default": "Verified customer" },

    { "type": "header", "content": "Card 5" },
    { "type": "text", "id": "card_5_title", "label": "Title", "default": "Highly recommend" },
    { "type": "text", "id": "card_5_subtitle", "label": "Subtitle", "default": "Lisa Anderson" },
    { "type": "richtext", "id": "card_5_text", "label": "Text", "default": "<p>This has become my go-to store. Consistent quality and excellent service.</p>" },
    { "type": "text", "id": "card_5_subtext", "label": "Subtext", "default": "Verified customer" },

    { "type": "header", "content": "Card 6" },
    { "type": "text", "id": "card_6_title", "label": "Title", "default": "Perfect" },
    { "type": "text", "id": "card_6_subtitle", "label": "Subtitle", "default": "David Martinez" },
    { "type": "richtext", "id": "card_6_text", "label": "Text", "default": "<p>Exactly what I was looking for. Five stars all around.</p>" },
    { "type": "text", "id": "card_6_subtext", "label": "Subtext", "default": "Verified customer" }
  ],
  "presets": [
    { "name": "Testimonials" }
  ]
}
{% endschema %}
