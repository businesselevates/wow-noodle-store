      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Section padding top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Section padding bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fffbf1"
    },
    {
      "type": "color",
      "id": "subhead_color",
      "label": "Subheading",
      "default": "#910f3f"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#1a2c56"
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Content",
      "default": "#1a2c56"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "subhead_size",
      "label": "Subheading size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
