{%- comment -%}
  Comparison Table section
  Online Store 2.0, block-driven, theme color/font agnostic.
  Everything (heading, subheading, buttons, table, rows) is a block so the
  merchant can add, remove and reorder pieces from the theme editor.
{%- endcomment -%}

{%- assign scheme = section.settings.color_scheme.settings -%}
{%- assign cmp_bg = scheme.background | default: 'currentColor' -%}
{%- assign cmp_text = scheme.text | default: scheme.foreground | default: scheme.foreground_heading | default: 'currentColor' -%}
{%- assign cmp_accent = scheme.button | default: scheme.primary_button_background | default: scheme.primary | default: scheme.accent | default: cmp_text -%}
{%- assign cmp_accent_contrast = scheme.button_label | default: scheme.primary_button_text | default: scheme.background | default: cmp_bg -%}

{%- if section.settings.highlight_color != blank -%}
  {%- assign cmp_accent = section.settings.highlight_color -%}
{%- endif -%}

{%- assign cmp_competitor_icon_override = section.settings.competitor_icon_color -%}

{%- assign pad_top_d = section.settings.padding_top -%}
{%- assign pad_bottom_d = section.settings.padding_bottom -%}
{%- assign pad_top_m = section.settings.padding_top_mobile -%}
{%- assign pad_bottom_m = section.settings.padding_bottom_mobile -%}
{%- assign radius = section.settings.corner_radius -%}
{%- assign content_max_width = section.settings.content_max_width -%}

{%- comment -%} Find the (single) table block, if any, and whether any row blocks exist. {%- endcomment -%}
{%- assign table_block = nil -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'table' -%}
    {%- assign table_block = block -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- assign has_rows = false -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'row' -%}
    {%- assign has_rows = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%}
  Free-text fields (the three column labels, the default badge word) are read
  WITHOUT a Liquid `default` filter whenever a table block exists, so a
  merchant can intentionally blank them (an empty label, or no badge at all).
  The fallback text below only kicks in when there is no table block yet at
  all, which is a different situation from a merchant clearing a field.
{%- endcomment -%}
{%- if table_block -%}
  {%- assign col1_label = table_block.settings.col1_label -%}
  {%- assign col2_label = table_block.settings.col2_label -%}
  {%- assign col3_label = table_block.settings.col3_label -%}
  {%- assign default_badge = table_block.settings.default_badge -%}
{%- else -%}
  {%- assign col1_label = 'Ingredient' -%}
  {%- assign col2_label = 'Your product' -%}
  {%- assign col3_label = 'Leading competitor' -%}
  {%- assign default_badge = '' -%}
{%- endif -%}

{%- assign col2_image = table_block.settings.col2_image -%}
{%- assign col3_image = table_block.settings.col3_image -%}
{%- assign col2_alt = col2_image.alt | default: col2_label -%}
{%- if col2_alt == blank -%}{%- assign col2_alt = 'Product image' -%}{%- endif -%}
{%- assign col3_alt = col3_image.alt | default: col3_label -%}
{%- if col3_alt == blank -%}{%- assign col3_alt = 'Competitor product image' -%}{%- endif -%}

{%- assign image_height = table_block.settings.image_height | default: 110 -%}
{%- assign table_width = table_block.settings.table_width | default: 'medium' -%}
{%- assign mobile_layout = table_block.settings.mobile_layout | default: 'compact' -%}

{%- assign float_images = true -%}
{%- if table_block != nil and table_block.settings.float_images == false -%}
  {%- assign float_images = false -%}
{%- endif -%}

{%- assign show_check_icons = true -%}
{%- if table_block != nil and table_block.settings.show_check_icons == false -%}
  {%- assign show_check_icons = false -%}
{%- endif -%}

{%- assign show_icons_mobile = false -%}
{%- if table_block != nil and table_block.settings.show_icons_mobile == true -%}
  {%- assign show_icons_mobile = true -%}
{%- endif -%}

{%- comment -%} Type size settings: px, desktop / mobile pairs. {%- endcomment -%}
{%- assign table_line_height = table_block.settings.table_line_height | default: 130 | divided_by: 100.0 -%}
{%- assign value_text_size = table_block.settings.value_text_size | default: 18 -%}
{%- assign value_text_size_mobile = table_block.settings.value_text_size_mobile | default: 14 -%}
{%- assign detail_text_size = table_block.settings.detail_text_size | default: 13 -%}
{%- assign detail_text_size_mobile = table_block.settings.detail_text_size_mobile | default: 11 -%}
{%- assign ingredient_text_size = table_block.settings.ingredient_text_size | default: 15 -%}
{%- assign ingredient_text_size_mobile = table_block.settings.ingredient_text_size_mobile | default: 13 -%}
{%- assign header_text_size = table_block.settings.header_text_size | default: 11 -%}
{%- assign header_text_size_mobile = table_block.settings.header_text_size_mobile | default: 10 -%}

{%- comment -%} Header font, case and letter spacing. Color always stays on the theme's own color scheme (unchanged). {%- endcomment -%}
{%- assign header_font_setting = table_block.settings.header_font | default: 'body' -%}
{%- if header_font_setting == 'heading' -%}
  {%- assign header_font_family_css = 'var(--font-heading-family, var(--font-heading--family, var(--heading-font-family, inherit)))' -%}
{%- else -%}
  {%- assign header_font_family_css = 'var(--font-body-family, var(--font-body--family, var(--text-font-family, inherit)))' -%}
{%- endif -%}

{%- assign header_uppercase = true -%}
{%- if table_block != nil and table_block.settings.header_uppercase == false -%}
  {%- assign header_uppercase = false -%}
{%- endif -%}
{%- assign header_transform_css = 'none' -%}
{%- if header_uppercase -%}{%- assign header_transform_css = 'uppercase' -%}{%- endif -%}

{%- assign header_letter_spacing_setting = table_block.settings.header_letter_spacing | default: 'small' -%}
{%- case header_letter_spacing_setting -%}
  {%- when 'none' -%}{%- assign header_letter_spacing_css = '0' -%}
  {%- when 'wide' -%}{%- assign header_letter_spacing_css = '0.14em' -%}
  {%- else -%}{%- assign header_letter_spacing_css = '0.06em' -%}
{%- endcase -%}

{%- comment -%} Mobile first-column width; the two product columns split the rest equally. {%- endcomment -%}
{%- assign mobile_col1_setting = table_block.settings.mobile_col1_width | default: 'narrow' -%}
{%- case mobile_col1_setting -%}
  {%- when 'narrow' -%}{%- assign mobile_col1_pct = 28 -%}
  {%- when 'wide' -%}{%- assign mobile_col1_pct = 40 -%}
  {%- else -%}{%- assign mobile_col1_pct = 34 -%}
{%- endcase -%}

{%- comment -%} aria-label: prefer the section heading, fall back to the two column labels, then a generic label. {%- endcomment -%}
{%- assign heading_text = '' -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'heading' -%}
    {%- assign heading_text = block.settings.heading | strip_html -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- if heading_text != blank -%}
  {%- assign table_aria_label = heading_text -%}
{%- elsif col2_label != blank or col3_label != blank -%}
  {%- assign table_aria_label = col2_label | append: ' vs ' | append: col3_label -%}
{%- else -%}
  {%- assign table_aria_label = 'Comparison table' -%}
{%- endif -%}

{%- capture cmp_check_svg -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>{%- endcapture -%}
{%- capture cmp_cross_svg -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>{%- endcapture -%}
{%- capture cmp_arrow_svg -%}<svg class="cmp-btn__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>{%- endcapture -%}

{%- comment -%}
  Build the whole table once. It is referenced either where the table block
  sits in the block order, or at the end if rows exist with no table block.
{%- endcomment -%}
{%- assign stacked_cards_accum = '' -%}

{%- capture cmp_table_markup -%}
  <div
    class="cmp-table-wrap cmp-table-wrap--{{ table_width }}"
    data-mobile-layout="{{ mobile_layout }}"
    data-icons-mobile="{{ show_icons_mobile }}"
    {% if table_block %}{{ table_block.shopify_attributes }}{% endif %}
  >
    <div
      class="cmp-table-grid{% unless float_images %} cmp-table-grid--no-float{% endunless %}"
      role="table"
      aria-label="{{ table_aria_label | escape }}"
    >
      <div class="cmp-header-cell cmp-header-cell--muted{% unless float_images %} cmp-header-cell--no-float{% endunless %}" role="columnheader"{% if col1_label == blank %} aria-label="Feature"{% endif %}>
        <span>{{ col1_label }}</span>
      </div>

      <div class="cmp-header-cell cmp-header-cell--main{% unless float_images %} cmp-header-cell--no-float{% endunless %}" role="columnheader"{% if col2_label == blank %} aria-label="Your product"{% endif %}>
        {%- if col2_image -%}
          {{ col2_image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '100, 200, 300, 400', sizes: '(min-width: 750px) 200px, 120px', alt: col2_alt, class: 'cmp-col-image' }}
        {%- elsif request.design_mode -%}
          {{ 'product-1' | placeholder_svg_tag: 'cmp-col-image placeholder-svg' }}
        {%- endif -%}
        <span>{{ col2_label }}</span>
      </div>

      <div class="cmp-header-cell cmp-header-cell--muted{% unless float_images %} cmp-header-cell--no-float{% endunless %}" role="columnheader"{% if col3_label == blank %} aria-label="Leading competitor"{% endif %}>
        {%- if col3_image -%}
          {{ col3_image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '100, 200, 300, 400', sizes: '(min-width: 750px) 200px, 120px', alt: col3_alt, class: 'cmp-col-image' }}
        {%- elsif request.design_mode -%}
          {{ 'product-2' | placeholder_svg_tag: 'cmp-col-image placeholder-svg' }}
        {%- endif -%}
        <span>{{ col3_label }}</span>
      </div>

      {%- for row_block in section.blocks -%}
        {%- if row_block.type == 'row' -%}
          {%- assign row_badge = row_block.settings.our_badge -%}
          {%- if row_block.settings.hide_badge or row_badge == 'none' -%}
            {%- assign row_badge = blank -%}
          {%- elsif row_badge == blank -%}
            {%- assign row_badge = default_badge -%}
          {%- endif -%}

          <div class="cmp-cell cmp-cell--ingredient" role="rowheader" {{ row_block.shopify_attributes }}>
            <span class="cmp-ingredient-name">{{ row_block.settings.ingredient_name }}</span>
          </div>

          <div class="cmp-cell cmp-cell--highlight" role="cell">
            <div class="cmp-cell-grid">
              <span class="cmp-cell-icon">
                {%- if show_check_icons -%}
                  {%- case row_block.settings.our_icon -%}
                    {%- when 'check' -%}
                      <span class="cmp-icon cmp-icon--check-accent">{{ cmp_check_svg }}</span><span class="cmp-visually-hidden">Included</span>
                    {%- when 'cross' -%}
                      <span class="cmp-icon cmp-icon--cross">{{ cmp_cross_svg }}</span><span class="cmp-visually-hidden">Not included</span>
                  {%- endcase -%}
                {%- endif -%}
              </span>
              <div class="cmp-cell-text">
                <div class="cmp-value-badge">
                  <span class="cmp-our-value">{{ row_block.settings.our_value }}</span>
                  {%- if row_badge != blank -%}<span class="cmp-badge">{{ row_badge }}</span>{%- endif -%}
                </div>
                {%- if row_block.settings.our_detail != blank -%}<div class="cmp-detail">{{ row_block.settings.our_detail }}</div>{%- endif -%}
              </div>
            </div>
          </div>

          <div class="cmp-cell" role="cell">
            <div class="cmp-cell-grid">
              <span class="cmp-cell-icon">
                {%- if show_check_icons -%}
                  {%- case row_block.settings.competitor_icon -%}
                    {%- when 'check' -%}
                      <span class="cmp-icon cmp-icon--check-muted">{{ cmp_check_svg }}</span><span class="cmp-visually-hidden">Included</span>
                    {%- when 'cross' -%}
                      <span class="cmp-icon cmp-icon--cross">{{ cmp_cross_svg }}</span><span class="cmp-visually-hidden">Not included</span>
                  {%- endcase -%}
                {%- endif -%}
              </span>
              <div class="cmp-cell-text">
                <span class="cmp-competitor-value">{{ row_block.settings.competitor_value }}</span>
                {%- if row_block.settings.competitor_detail != blank -%}<div class="cmp-detail">{{ row_block.settings.competitor_detail }}</div>{%- endif -%}
              </div>
            </div>
          </div>

          {%- if mobile_layout == 'stacked' -%}
            {%- capture row_stacked -%}
              <div class="cmp-stacked-card" {{ row_block.shopify_attributes }}>
                <div class="cmp-stacked-card-title cmp-cell--ingredient">{{ row_block.settings.ingredient_name }}</div>
                <div class="cmp-stacked-halves">
                  <div class="cmp-stacked-half cmp-stacked-half--highlight">
                    <div class="cmp-stacked-caption">{{ col2_label }}</div>
                    <div class="cmp-cell-grid">
                      <span class="cmp-cell-icon">
                        {%- if show_check_icons -%}
                          {%- case row_block.settings.our_icon -%}
                            {%- when 'check' -%}
                              <span class="cmp-icon cmp-icon--check-accent">{{ cmp_check_svg }}</span><span class="cmp-visually-hidden">Included</span>
                            {%- when 'cross' -%}
                              <span class="cmp-icon cmp-icon--cross">{{ cmp_cross_svg }}</span><span class="cmp-visually-hidden">Not included</span>
                          {%- endcase -%}
                        {%- endif -%}
                      </span>
                      <div class="cmp-cell-text">
                        <div class="cmp-value-badge">
                          <span class="cmp-our-value">{{ row_block.settings.our_value }}</span>
                          {%- if row_badge != blank -%}<span class="cmp-badge">{{ row_badge }}</span>{%- endif -%}
                        </div>
                        {%- if row_block.settings.our_detail != blank -%}<div class="cmp-detail">{{ row_block.settings.our_detail }}</div>{%- endif -%}
                      </div>
                    </div>
                  </div>
                  <div class="cmp-stacked-half">
                    <div class="cmp-stacked-caption">{{ col3_label }}</div>
                    <div class="cmp-cell-grid">
                      <span class="cmp-cell-icon">
                        {%- if show_check_icons -%}
                          {%- case row_block.settings.competitor_icon -%}
                            {%- when 'check' -%}
                              <span class="cmp-icon cmp-icon--check-muted">{{ cmp_check_svg }}</span><span class="cmp-visually-hidden">Included</span>
                            {%- when 'cross' -%}
                              <span class="cmp-icon cmp-icon--cross">{{ cmp_cross_svg }}</span><span class="cmp-visually-hidden">Not included</span>
                          {%- endcase -%}
                        {%- endif -%}
                      </span>
                      <div class="cmp-cell-text">
                        <span class="cmp-competitor-value">{{ row_block.settings.competitor_value }}</span>
                        {%- if row_block.settings.competitor_detail != blank -%}<div class="cmp-detail">{{ row_block.settings.competitor_detail }}</div>{%- endif -%}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            {%- endcapture -%}
            {%- assign stacked_cards_accum = stacked_cards_accum | append: row_stacked -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if mobile_layout == 'stacked' -%}
      <div class="cmp-stacked-list">
        {{ stacked_cards_accum }}
      </div>
    {%- endif -%}
  </div>
{%- endcapture -%}

<div class="color-{{ section.settings.color_scheme }} gradient cmp-section">
  {%- style -%}
    .cmp-root--{{ section.id }} {
      --cmp-bg: {{ cmp_bg }};
      --cmp-text: {{ cmp_text }};
      --cmp-accent: {{ cmp_accent }};
      --cmp-accent-contrast: {{ cmp_accent_contrast }};
      --cmp-competitor-icon-override: {{ cmp_competitor_icon_override | default: 'initial' }};
      --cmp-padding-top: {{ pad_top_d }}px;
      --cmp-padding-bottom: {{ pad_bottom_d }}px;
      --cmp-padding-top-mobile: {{ pad_top_m }}px;
      --cmp-padding-bottom-mobile: {{ pad_bottom_m }}px;
      --cmp-radius: {{ radius }}px;
      --cmp-content-max-width: {{ content_max_width }}px;
      --cmp-image-height: {{ image_height }}px;
      --cmp-value-size: {{ value_text_size }}px;
      --cmp-line-height: {{ table_line_height }};
      --cmp-detail-size: {{ detail_text_size }}px;
      --cmp-ingredient-size: {{ ingredient_text_size }}px;
      --cmp-header-size: {{ header_text_size }}px;
      --cmp-header-font-family: {{ header_font_family_css }};
      --cmp-header-transform: {{ header_transform_css }};
      --cmp-header-letter-spacing: {{ header_letter_spacing_css }};
      --cmp-mobile-col1-width: {{ mobile_col1_pct }}%;
    }
    @media screen and (max-width: 749px) {
      .cmp-root--{{ section.id }} {
        --cmp-image-height: {{ image_height | times: 0.6 | round }}px;
        --cmp-value-size: {{ value_text_size_mobile }}px;
        --cmp-detail-size: {{ detail_text_size_mobile }}px;
        --cmp-ingredient-size: {{ ingredient_text_size_mobile }}px;
        --cmp-header-size: {{ header_text_size_mobile }}px;
      }
    }
  {%- endstyle -%}

  <div class="cmp-root cmp-root--{{ section.id }}">
    <div class="cmp-inner">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'heading' -%}
            {%- assign h_size = block.settings.heading_size -%}
            {%- case h_size -%}
              {%- when 'small' -%}{%- assign h_class = 'h2' -%}
              {%- when 'large' -%}{%- assign h_class = 'h0' -%}
              {%- else -%}{%- assign h_class = 'h1' -%}
            {%- endcase -%}
            <h2
              class="cmp-heading {{ h_class }} cmp-heading--{{ h_size }} cmp-align-{{ block.settings.heading_align }}"
              style="margin-bottom: {{ block.settings.space_below }}px;"
              {{ block.shopify_attributes }}
            >{{ block.settings.heading }}</h2>

          {%- when 'text' -%}
            <div
              class="cmp-text cmp-text--{{ block.settings.text_size }} cmp-align-{{ block.settings.text_align }} rte"
              style="margin-bottom: {{ block.settings.space_below }}px;"
              {{ block.shopify_attributes }}
            >{{ block.settings.text }}</div>

          {%- when 'button' -%}
            {%- liquid
              assign btn_classes = 'cmp-align-' | append: block.settings.button_align
              assign btn_style_setting = block.settings.button_style
              assign btn_is_hlt = false
              case btn_style_setting
                when 'hlt'
                  assign btn_is_hlt = true
                  assign btn_theme_class = 'hlt-btn'
                when 'hlt-splash'
                  assign btn_is_hlt = true
                  assign btn_theme_class = 'hlt-btn hlt-btn--splash'
                when 'hlt-splash-white'
                  assign btn_is_hlt = true
                  assign btn_theme_class = 'hlt-btn hlt-btn--splash hlt-btn--white-text'
                else
                  if block.settings.use_theme_styles
                    if btn_style_setting == 'secondary'
                      assign btn_theme_class = 'button button--secondary'
                    else
                      assign btn_theme_class = 'button button--primary'
                    endif
                  else
                    assign btn_theme_class = 'cmp-btn cmp-btn--' | append: btn_style_setting
                  endif
              endcase
              if block.settings.full_width_mobile
                assign btn_theme_class = btn_theme_class | append: ' cmp-btn-full-mobile'
              endif

              comment
                HLT styles take their size and weight from the HLT button CSS,
                exactly like the HLT Hero / Image with text CTA. The size and
                bold settings below only apply to Primary and Secondary.
              endcomment
              assign btn_style = ''
              unless btn_is_hlt
                assign btn_style = 'font-size: ' | append: block.settings.text_size | append: 'px;'
                if block.settings.bold_text
                  assign btn_style = btn_style | append: ' font-weight: 700;'
                endif
              endunless

              assign btn_scroll = false
              assign btn_scroll_target = block.settings.scroll_target | default: '#hlt-buy-box'
              if block.settings.scroll_to_target
                assign btn_scroll = true
                assign btn_href = btn_scroll_target
              else
                assign btn_href = block.settings.button_link
              endif
            -%}
            <div
              class="cmp-button-wrap {{ btn_classes }}"
              style="margin-top: {{ block.settings.space_above }}px; margin-bottom: {{ block.settings.space_below }}px;"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.button_label != blank -%}
                {%- if btn_href != blank -%}
                  <a
                    class="{{ btn_theme_class }}"
                    href="{{ btn_href }}"
                    {% if btn_scroll %}data-hlt-scroll-to="{{ btn_scroll_target }}"{% endif %}
                    {% if btn_style != blank %}style="{{ btn_style }}"{% endif %}
                    {% if block.settings.open_in_new_tab and btn_scroll == false %}target="_blank" rel="noopener"{% endif %}
                  >
                    {%- if btn_is_hlt -%}
                      {{- block.settings.button_label -}}
                      {%- if block.settings.show_arrow %} {% render 'hlt-icon', name: 'arrow-right', size: 20 %}{% endif -%}
                    {%- else -%}
                      <span>{{ block.settings.button_label }}</span>{% if block.settings.show_arrow %}{{ cmp_arrow_svg }}{% endif %}
                    {%- endif -%}
                  </a>
                {%- else -%}
                  {%- comment -%}
                    No link yet: in the theme editor this still needs to look
                    like a normal button so the merchant can judge it while
                    building the section. Only the live storefront, where a
                    customer could actually click a dead link, falls back to
                    the visibly-disabled look.
                  {%- endcomment -%}
                  <a
                    role="link"
                    aria-disabled="true"
                    class="{{ btn_theme_class }}{% unless request.design_mode %} cmp-btn--disabled{% endunless %}"
                    {% if btn_style != blank %}style="{{ btn_style }}"{% endif %}
                  >
                    {%- if btn_is_hlt -%}
                      {{- block.settings.button_label -}}
                      {%- if block.settings.show_arrow %} {% render 'hlt-icon', name: 'arrow-right', size: 20 %}{% endif -%}
                    {%- else -%}
                      <span>{{ block.settings.button_label }}</span>{% if block.settings.show_arrow %}{{ cmp_arrow_svg }}{% endif %}
                    {%- endif -%}
                  </a>
                {%- endif -%}
              {%- endif -%}
            </div>

          {%- when 'table' -%}
            {{ cmp_table_markup }}

          {%- when 'row' -%}
            {%- comment -%} rows never render in the flow; they render inside the table block above {%- endcomment -%}

        {%- endcase -%}
      {%- endfor -%}

      {%- if table_block == nil and has_rows -%}
        {{ cmp_table_markup }}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "class": "cmp-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Color overrides"
    },
    {
