{% endschema %}

{% stylesheet %}
  .cmp-section {
    /* Fixed, explicit base: some themes (Dawn) set html{font-size:62.5%} so
       1rem is 10px there and 16px almost everywhere else. Never use rem in
       this file; every type size, padding and gap below is em (relative to
       this base) or a plain px value instead. */
    font-size: calc(var(--font-body-scale, 1) * 16px);
    background: var(--cmp-bg);
    color: var(--cmp-text);
  }

  .cmp-root {
    padding-top: var(--cmp-padding-top-mobile);
    padding-bottom: var(--cmp-padding-bottom-mobile);
  }

  @media screen and (min-width: 750px) {
    .cmp-root {
      padding-top: var(--cmp-padding-top);
      padding-bottom: var(--cmp-padding-bottom);
    }
  }

  .cmp-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .cmp-heading,
  .cmp-text {
    max-width: var(--cmp-content-max-width);
    margin-left: auto;
    margin-right: auto;
  }

  .cmp-heading {
    font-family: var(--font-heading-family, var(--font-heading--family, var(--heading-font-family, inherit)));
    font-weight: var(--font-heading-weight, var(--font-heading--weight, var(--heading-font-weight, inherit)));
    margin-top: 0;
  }

  /* Our own clamp()-based sizes on top of the theme's h0/h1/h2 classes, in
     case a theme's heading classes are small, missing, or oddly scaled. */
  .cmp-heading--small { font-size: clamp(22px, 3vw + 10px, 32px); }
  .cmp-heading--medium { font-size: clamp(28px, 4vw + 12px, 48px); }
  .cmp-heading--large { font-size: clamp(34px, 5vw + 14px, 64px); }

  .cmp-text {
    font-family: var(--font-body-family, var(--font-body--family, var(--text-font-family, inherit)));
    margin-top: 0;
  }

  .cmp-text--small { font-size: 0.9em; }
  .cmp-text--medium { font-size: 1.05em; }

  .cmp-align-left { text-align: left; }
  .cmp-align-center { text-align: center; margin-left: auto; margin-right: auto; }
  .cmp-align-right { text-align: right; margin-left: auto; margin-right: 0; }

  .cmp-button-wrap {
    display: flex;
  }
  .cmp-button-wrap.cmp-align-left { justify-content: flex-start; }
  .cmp-button-wrap.cmp-align-center { justify-content: center; }
  .cmp-button-wrap.cmp-align-right { justify-content: flex-end; }

  .cmp-btn {
    display: inline-block;
    padding: 0.85em 1.75em;
    border-radius: var(--buttons-radius, var(--button-border-radius, 999px));
    text-decoration: none;
    font-family: var(--font-body-family, var(--font-body--family, var(--text-font-family, inherit)));
    cursor: pointer;
    border: 1px solid transparent;
  }
  .cmp-btn--primary {
    background: var(--cmp-accent);
    color: var(--cmp-accent-contrast);
  }
  .cmp-btn--secondary {
    background: transparent;
    color: var(--cmp-text);
    border-color: color-mix(in srgb, var(--cmp-text) 30%, transparent);
  }

  /* HLT styles use the real .hlt-btn classes, so the global HLT stylesheet
     styles this button exactly like the HLT Hero / Image with text CTA.
     The rules below sit inside :where() (zero specificity) so they are only
     a safety net: any real .hlt-btn rule from the HLT stylesheet wins. */
  :where(.cmp-button-wrap .hlt-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 32px;
    border-radius: 999px;
    background: var(--hlt-navy, #1c2754);
    color: #ffffff;
    font-weight: 800;
    text-decoration: none;
  }
  :where(.cmp-button-wrap .hlt-btn svg) {
    flex-shrink: 0;
  }

  .cmp-btn__arrow {
    width: 1.05em;
    height: 1.05em;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  .cmp-button-wrap a:hover .cmp-btn__arrow {
    transform: translateX(3px);
  }
  .cmp-button-wrap .button .cmp-btn__arrow {
    margin-left: 0.5em;
    vertical-align: -0.15em;
  }

  @media (prefers-reduced-motion: reduce) {
    .cmp-btn__arrow { transition: none; }
    .cmp-button-wrap a:hover .cmp-btn__arrow { transform: none; }
  }

  .cmp-btn--disabled {
    opacity: 0.5;
    cursor: default;
    pointer-events: none;
  }

  .cmp-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .cmp-table-wrap {
    margin: 0 auto;
    width: 100%;
  }
  .cmp-table-wrap--narrow { max-width: 720px; }
  .cmp-table-wrap--medium { max-width: 900px; }
  .cmp-table-wrap--wide { max-width: 1100px; }
  .cmp-table-wrap--full { max-width: 100%; }

  .cmp-table-grid,
  .cmp-stacked-list {
    line-height: var(--cmp-line-height, 1.25);
  }
  .cmp-table-grid .cmp-cell *,
  .cmp-stacked-list * {
    line-height: inherit;
  }

  .cmp-table-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1fr;
    background: color-mix(in srgb, var(--cmp-text) 3%, var(--cmp-bg));
    border: 1px solid color-mix(in srgb, var(--cmp-text) 10%, var(--cmp-bg));
    border-radius: var(--cmp-radius);
    /* No overflow:hidden here on purpose: the floating product images are
       absolutely positioned above this box and must stay fully visible,
       overlapping the top edge. The corner cells (columns 1 and 3, header
       and last row) never carry their own background, so the container's
       own rounded corners still show through correctly without clipping. */
    box-shadow: 0 12px 30px -12px color-mix(in srgb, var(--cmp-text) 25%, transparent);
    margin-top: calc(var(--cmp-image-height) / 2 + 16px);
  }
  .cmp-table-grid--no-float {
    margin-top: 0;
  }

  .cmp-table-grid > * {
    border-bottom: 1px solid color-mix(in srgb, var(--cmp-text) 10%, var(--cmp-bg));
  }
  .cmp-table-grid > *:nth-last-child(-n + 3) {
    border-bottom: none;
  }

  .cmp-cell {
    padding: 18px 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    overflow-wrap: break-word;
  }

  /* The ingredient column specifically: hyphenate real words instead of
     breaking anywhere, so "preservatives" wraps as "preserva-tives" rather
     than at an arbitrary character. Relies on the page's own lang attribute. */
  .cmp-cell--ingredient {
    hyphens: auto;
  }

  .cmp-cell--highlight {
    background: color-mix(in srgb, var(--cmp-accent) 6%, var(--cmp-bg));
    box-shadow: inset 1px 0 0 color-mix(in srgb, var(--cmp-accent) 12%, transparent), inset -1px 0 0 color-mix(in srgb, var(--cmp-accent) 12%, transparent);
  }

  .cmp-header-cell {
    padding: 14px 16px;
    font-family: var(--cmp-header-font-family);
    text-transform: var(--cmp-header-transform);
    font-size: var(--cmp-header-size);
    letter-spacing: var(--cmp-header-letter-spacing);
    font-weight: 600;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    text-align: center;
    position: relative;
    min-width: 0;
    overflow-wrap: break-word;
    min-height: calc(var(--cmp-image-height) / 2 + 34px);
  }
  /* Color always tracks the theme's own color scheme, unchanged. */
  .cmp-header-cell--muted { color: color-mix(in srgb, var(--cmp-text) 65%, var(--cmp-bg)); }
  .cmp-header-cell--main {
    color: var(--cmp-text);
    background: color-mix(in srgb, var(--cmp-accent) 6%, var(--cmp-bg));
  }
  .cmp-header-cell--no-float {
    align-items: center;
    min-height: 0;
    flex-direction: column;
    gap: 6px;
    padding-top: 20px;
  }

  .cmp-col-image {
    position: absolute;
    top: calc(var(--cmp-image-height) / -2);
    left: 50%;
    transform: translateX(-50%);
    height: var(--cmp-image-height);
    width: auto;
    max-width: 90%;
    object-fit: contain;
    filter: drop-shadow(0 8px 16px color-mix(in srgb, var(--cmp-text) 25%, transparent));
  }
  .cmp-header-cell--no-float .cmp-col-image {
    position: static;
    transform: none;
    height: calc(var(--cmp-image-height) * 0.6);
  }

  .cmp-ingredient-name {
    font-weight: 600;
    font-size: var(--cmp-ingredient-size);
  }

  /* Icon (left, fixed track) + text stack (right, flexible track). The icon
     stays aligned with the first line of text instead of sitting above it
     or forcing the value onto its own line when the value text is long. */
  .cmp-cell-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 8px;
    align-items: start;
  }
  .cmp-cell-icon {
    display: inline-flex;
    margin-top: 0.2em;
  }
  .cmp-cell-text {
    min-width: 0;
    overflow-wrap: break-word;
  }

  .cmp-icon {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .cmp-icon--check-accent {
    background: var(--cmp-accent);
    color: var(--cmp-accent-contrast);
  }
  .cmp-icon--check-muted {
    background: var(--cmp-competitor-icon-override, color-mix(in srgb, var(--cmp-text) 55%, var(--cmp-bg)));
    color: var(--cmp-bg);
  }
  .cmp-icon--cross {
    background: transparent;
    color: color-mix(in srgb, var(--cmp-text) 45%, var(--cmp-bg));
    border: 1px solid color-mix(in srgb, var(--cmp-text) 25%, var(--cmp-bg));
  }
  .cmp-icon svg {
    width: 12px;
    height: 12px;
  }

  /* Value and badge flow as inline text: the badge follows the value on the
     same line whenever there is room and only drops below when there is not.
     Values break at spaces, never mid-word (so "+110%" stays whole). */
  .cmp-value-badge {
    display: block;
  }
  .cmp-value-badge .cmp-badge {
    display: inline-block;
    margin-left: 0.3em;
  }

  .cmp-our-value,
  .cmp-competitor-value {
    font-size: var(--cmp-value-size);
    /* .cmp-our-value is a flex item inside .cmp-value-badge; flex items
       default to min-width:auto (shrink-to-fit their single widest
       unbreakable word), which would otherwise cap long values at one word
       wide instead of using the full available width. */
    min-width: 0;
  }
  .cmp-our-value {
    font-weight: 700;
    color: var(--cmp-accent);
  }
  .cmp-competitor-value {
    font-weight: 500;
  }

  .cmp-badge {
    font-size: calc(var(--cmp-value-size) * 0.6);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--cmp-accent);
    background: none;
    padding: 0;
    border-radius: 0;
    white-space: nowrap;
  }

  .cmp-detail {
    font-size: var(--cmp-detail-size);
    color: color-mix(in srgb, var(--cmp-text) 65%, var(--cmp-bg));
    margin-top: 4px;
  }

  .cmp-stacked-list {
    display: none;
  }

  @media screen and (max-width: 749px) {
    /* Scale the floating product images (and everything derived from them:
       the card's top compensation margin, the header cell's min-height) down
       to about 60% of the desktop setting. The mobile value of
       --cmp-image-height, and the mobile type sizes, are set per section in
       the style block above (plain computed values, not self-referencing). */

    .cmp-table-grid {
      grid-template-columns: var(--cmp-mobile-col1-width) 1fr 1fr;
    }

    .cmp-cell {
      padding: 10px 8px;
    }

    .cmp-header-cell {
      padding: 12px 10px;
      min-height: calc(var(--cmp-image-height) / 2 + 26px);
    }

    /* Icons never stack above the text on mobile (the auto/1fr grid already
       prevents that); they just shrink, and a table can opt out of showing
       them on mobile altogether via "Show icons on mobile". */
    .cmp-icon {
      width: 16px;
      height: 16px;
    }
    .cmp-icon svg {
      width: 9px;
      height: 9px;
    }
    .cmp-table-wrap[data-icons-mobile='false'] .cmp-cell-icon {
      display: none;
    }

    .cmp-table-wrap[data-mobile-layout='stacked'] .cmp-table-grid {
      display: none;
    }
    .cmp-table-wrap[data-mobile-layout='stacked'] .cmp-stacked-list {
      display: block;
    }

    .cmp-button-wrap .cmp-btn-full-mobile {
      display: flex;
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }

  .cmp-stacked-card {
    border: 1px solid color-mix(in srgb, var(--cmp-text) 10%, var(--cmp-bg));
    border-radius: var(--cmp-radius);
    background: color-mix(in srgb, var(--cmp-text) 3%, var(--cmp-bg));
    padding: 16px;
    margin-bottom: 12px;
  }
  .cmp-stacked-card:last-child {
    margin-bottom: 0;
  }
  .cmp-stacked-card-title {
    font-weight: 600;
    margin-bottom: 10px;
  }
  .cmp-stacked-halves {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .cmp-stacked-half {
    padding: 10px;
    border-radius: calc(var(--cmp-radius) * 0.6);
  }
  .cmp-stacked-half--highlight {
    background: color-mix(in srgb, var(--cmp-accent) 8%, var(--cmp-bg));
  }
  .cmp-stacked-caption {
    font-size: 0.65em;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--cmp-text) 65%, var(--cmp-bg));
    margin-bottom: 6px;
  }
{% endstylesheet %}
