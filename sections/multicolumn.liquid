{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Pre-header */
  .section-{{ section.id }}-padding .multicolumn__preheader {
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 1.1rem;
    margin-bottom: 0.8rem;
  }

  {%- if section.settings.preheader_color != blank -%}
    .section-{{ section.id }}-padding .multicolumn__preheader,
    .section-{{ section.id }}-padding .multicolumn__preheader * {
      color: {{ section.settings.preheader_color }} !important;
    }
  {%- endif -%}

  /* Center the main heading */
  .section-{{ section.id }}-padding .multicolumn__title {
    justify-content: center;
    text-align: center;
  }

  .section-{{ section.id }}-padding .multicolumn__title .title {
    text-align: center;
  }

  /* Description */
  .section-{{ section.id }}-padding .multicolumn__description {
    text-align: center;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
    margin-top: 1.6rem;
    margin-bottom: 2.4rem;
  }

  /* Footer */
  .section-{{ section.id }}-padding .multicolumn__footer {
    text-align: center;
    max-width: 580px;
    margin-left: auto;
    margin-right: auto;
    margin-top: 2.8rem;
    font-size: 1.2rem;
    opacity: 0.65;
    line-height: 1.6;
  }

  {%- if section.settings.card_style -%}
    /* ══ CARD LAYOUT ══ bordered card, icon circle top-left, left-aligned content */
    .section-{{ section.id }}-padding .multicolumn-list__item {
      display: flex;
    }

    .section-{{ section.id }}-padding .multicolumn-card.content-container {
      border: 1px solid {{ section.settings.card_border_color }} !important;
      border-radius: 16px !important;
      box-shadow: none !important;
      background: {% if section.settings.card_background != blank %}{{ section.settings.card_background }}{% else %}transparent{% endif %} !important;
      padding: 2rem !important;
      height: 100%;
      display: flex;
      flex-direction: column;
      text-align: left;
    }

    /* Icon — bare, no ring, top-left */
    .section-{{ section.id }}-padding .multicolumn-card__image-wrapper {
      width: auto !important;
      margin: 0 0 1.25rem 0 !important;
      padding: 0 !important;
    }

    .section-{{ section.id }}-padding .media {
      width: 40px !important;
      height: 40px !important;
      aspect-ratio: 1 / 1 !important;
      border: none !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      background: transparent !important;
      padding-bottom: 0 !important;
      overflow: visible !important;
      display: flex;
      align-items: center;
      justify-content: flex-start;
    }

    .section-{{ section.id }}-padding .multicolumn-card__icon-svg {
      width: 38px;
      height: 38px;
      display: block;
      color: {% if section.settings.icon_color != blank %}{{ section.settings.icon_color }}{% else %}currentColor{% endif %};
    }

    .section-{{ section.id }}-padding .multicolumn-card__icon-svg svg {
      width: 100%;
      height: 100%;
    }

    .section-{{ section.id }}-padding .multicolumn-card__image {
      width: 60% !important;
      height: 60% !important;
      object-fit: contain !important;
      object-position: center !important;
      border-radius: 0 !important;
    }

    .section-{{ section.id }}-padding .multicolumn-card__info {
      text-align: left;
    }

    {%- if section.settings.card_heading_color != blank -%}
      .section-{{ section.id }}-padding .multicolumn-card__info h3 {
        color: {{ section.settings.card_heading_color }} !important;
      }
    {%- endif -%}

    {%- if section.settings.card_text_color != blank -%}
      .section-{{ section.id }}-padding .multicolumn-card__info .rte,
      .section-{{ section.id }}-padding .multicolumn-card__info .rte p {
        color: {{ section.settings.card_text_color }} !important;
      }
    {%- endif -%}

  {%- elsif section.settings.icon_circle -%}
    /* ══ ROUND LOGO ══ */
    .section-{{ section.id }}-padding .multicolumn-card.content-container {
      border: none !important;
      box-shadow: none !important;
      background: transparent !important;
      padding: 0 !important;
    }

    .section-{{ section.id }}-padding .multicolumn-card__image-wrapper,
    .section-{{ section.id }}-padding .multicolumn-card__image-wrapper.multicolumn-card-spacing {
      padding: 0 !important;
      margin: 0 auto;
    }

    .section-{{ section.id }}-padding .media {
      border-radius: 50% !important;
      overflow: hidden !important;
      aspect-ratio: 1 / 1 !important;
      padding-bottom: 0 !important;
      width: 100%;
      border: 2px solid #d0c8b8 !important;
      box-shadow: none !important;
    }

    .section-{{ section.id }}-padding .multicolumn-card__image {
      width: 82% !important;
      height: 82% !important;
      object-fit: contain !important;
      object-position: center !important;
      border-radius: 0 !important;
      margin: auto;
      display: block;
    }

  {%- else -%}
    /* ══ FREE ICON — no ring, no card ══ */
    .section-{{ section.id }}-padding .multicolumn-card.content-container {
      border: none !important;
      box-shadow: none !important;
      background: transparent !important;
      padding: 0 !important;
    }

    .section-{{ section.id }}-padding .multicolumn-card__image-wrapper,
    .section-{{ section.id }}-padding .multicolumn-card__image-wrapper.multicolumn-card-spacing {
      padding: 0 !important;
      margin: 0 auto;
    }

    .section-{{ section.id }}-padding .media {
      border: none !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      background: transparent !important;
    }
  {%- endif -%}
{%- endstyle -%}

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif
-%}

<div class="multicolumn color-{{ section.settings.color_scheme }} gradient{% unless section.settings.background_style == 'none' and settings.text_boxes_border_thickness > 0 or settings.text_boxes_shadow_opacity > 0 %} background-{{ section.settings.background_style }}{% endunless %}{% if section.settings.title == blank %} no-heading{% endif %}">
  <div
    class="page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >

    {%- unless section.settings.preheader == blank -%}
      <div class="multicolumn__preheader rte center">
        {{ section.settings.preheader }}
      </div>
    {%- endunless -%}

    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin multicolumn__title">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
        {%- if section.settings.button_label != blank and show_mobile_slider -%}
          <a href="{{ section.settings.button_link }}" class="link underlined-link large-up-hide">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endunless -%}

    {%- unless section.settings.description == blank -%}
      <div class="multicolumn__description rte center">
        {{ section.settings.description }}
      </div>
    {%- endunless -%}

    <slider-component class="slider-mobile-gutter">
      <ul
        class="multicolumn-list contains-content-container grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop{% if show_mobile_slider %} slider slider--tablet grid--peek{% endif %}"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- liquid
          assign highest_ratio = 0
          for block in section.blocks
            if block.settings.image.aspect_ratio > highest_ratio
              assign highest_ratio = block.settings.image.aspect_ratio
            endif
          endfor
        -%}
        {%- for block in section.blocks -%}
          {%- assign empty_column = '' -%}
          {%- if block.settings.image == blank
            and block.settings.title == blank
            and block.settings.text == blank
            and block.settings.link_label == blank
          -%}
            {%- assign empty_column = ' multicolumn-list__item--empty' -%}
          {%- endif -%}

          {%- liquid
            assign icon_key = block.settings.icon
            if icon_key == blank or icon_key == 'auto'
              assign t = block.settings.title | downcase
              if t contains 'health'
                assign icon_key = 'leaf'
              elsif t contains 'love'
                assign icon_key = 'heart'
              elsif t contains 'trust'
                assign icon_key = 'shield'
              else
                assign icon_key = 'sparkle'
              endif
            endif
          -%}

          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="multicolumn-list__item grid__item{% if section.settings.swipe_on_mobile %} slider__slide{% endif %}{% if section.settings.column_alignment == 'center' %} center{% endif %}{{ empty_column }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            <div class="multicolumn-card content-container">
              {%- if block.settings.image != blank -%}
                {% if section.settings.image_ratio == 'adapt' or section.settings.image_ratio == 'circle' %}
                  {% assign spaced_image = true %}
                {% endif %}
                <div class="multicolumn-card__image-wrapper multicolumn-card__image-wrapper--{{ section.settings.image_width }}-width{% if section.settings.image_width != 'full' or spaced_image %} multicolumn-card-spacing{% endif %}">
                  <div
                    class="media media--transparent media--{{ section.settings.image_ratio }}"
                    {% if section.settings.image_ratio == 'adapt' %}
                      style="padding-bottom: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"
                    {% endif %}
                  >
                    {%- liquid
                      assign number_of_columns = section.settings.columns_desktop
                      assign number_of_columns_mobile = section.settings.columns_mobile
                      assign grid_space_desktop = number_of_columns | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
                      assign grid_space_tablet = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
                      assign grid_space_mobile = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | divided_by: 2 | plus: 30 | append: 'px'
                      if section.settings.image_width == 'half'
                        assign image_width = 0.5
                      elsif section.settings.image_width == 'third'
                        assign image_width = 0.33
                      else
                        assign image_width = 1
                      endif
                    -%}
                    {% capture sizes %}
                      (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ grid_space_desktop }}) * {{ image_width }} /  {{ number_of_columns }}),
                      (min-width: 990px) calc((100vw - {{ grid_space_desktop }}) * {{ image_width }} / {{ number_of_columns }}),
                      (min-width: 750px) calc((100vw - {{ grid_space_tablet }}) * {{ image_width }} / {{ number_of_columns_mobile }}),
                      calc((100vw - {{ grid_space_mobile }}) * {{ image_width }} / {{ number_of_columns_mobile }})
                    {% endcapture %}
                    {{
                      block.settings.image
                      | image_url: width: 3200
                      | image_tag:
                        widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
                        sizes: sizes,
                        class: 'multicolumn-card__image'
                    }}
                  </div>
                </div>
              {%- elsif section.settings.card_style -%}
                <div class="multicolumn-card__image-wrapper">
                  <div class="media media--transparent media--square">
                    <span class="multicolumn-card__icon-svg">
                      {%- case icon_key -%}
                        {%- when 'leaf' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 21c-5 0-8-3-8-8 0-4 3-9 9-10 4 0 6 2 6 6 0 6-4 12-9 12z"/><path d="M8.5 17.5C11 14 13.5 11 18 9"/></svg>
                        {%- when 'heart' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.5S3.5 15 3.5 8.9A4.4 4.4 0 0 1 12 6.8a4.4 4.4 0 0 1 8.5 2.1C20.5 15 12 20.5 12 20.5z"/></svg>
                        {%- when 'shield' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5.5c0 4.4-3 7.9-7 9.5-4-1.6-7-5.1-7-9.5V6l7-3z"/><path d="M9 12l2 2 4-4.5"/></svg>
                        {%- when 'star' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 17l-5.2 2.6 1-5.8L3.5 9.7l5.9-.9z"/></svg>
                        {%- when 'apple' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7c-1-1.5-3-2-4.5-1C6 7 5 9 5 11.5 5 15 7 19 9.5 19c.9 0 1.5-.4 2.5-.4s1.6.4 2.5.4C17 19 19 15 19 11.5 19 9 18 7 16.5 6c-1.5-1-3.5-.5-4.5 1z"/><path d="M12 7c.2-1.6 1.3-2.7 3-3"/></svg>
                        {%- when 'hand-heart' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 13.5l-2.6-2.6a1.5 1.5 0 0 1 2.1-2.1l.5.5.5-.5a1.5 1.5 0 0 1 2.1 2.1L11 13.5z"/><path d="M3 14l4 4h7l5-2c1.1-.5.8-2.1-.5-2.1l-4 .6"/><path d="M3 12v8"/></svg>
                        {%- when 'home' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11l8-6 8 6"/><path d="M6 10v9h12v-9"/><path d="M10 19v-5h4v5"/></svg>
                        {%- when 'smile' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8.5 14c1 1.2 2.2 1.8 3.5 1.8s2.5-.6 3.5-1.8"/><path d="M9 9.5h.01M15 9.5h.01"/></svg>
                        {%- else -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4l1.6 4.4L18 10l-4.4 1.6L12 16l-1.6-4.4L6 10l4.4-1.6z"/><path d="M18 15.5l.6 1.6 1.6.6-1.6.6-.6 1.6-.6-1.6L15.8 17.7l1.6-.6z"/></svg>
                      {%- endcase -%}
                    </span>
                  </div>
                </div>
              {%- endif -%}
              <div class="multicolumn-card__info">
                {%- if block.settings.title != blank -%}
                  <h3 class="inline-richtext">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.link_label != blank -%}
                  <a
                    class="link animate-arrow"
                    {% if block.settings.link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.link }}"
                    {% endif %}
                  >
                    {{- block.settings.link_label | escape -}}
                    <span class="svg-wrapper"
                      ><span class="icon-wrap">&nbsp;{{ 'icon-arrow.svg' | inline_asset_content }}</span></span
                    >
                  </a>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_mobile_slider -%}
        <div class="slider-buttons large-up-hide">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>

    <div class="center{% if show_mobile_slider %} small-hide medium-hide{% endif %}">
      {%- if section.settings.button_label != blank -%}
        <a
          class="button button--primary"
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>

    {%- unless section.settings.footer_text == blank -%}
      <div class="multicolumn__footer rte center">
        {{ section.settings.footer_text }}
      </div>
    {%- endunless -%}

  </div>
</div>

{% schema %}
{
  "name": "t:sections.multicolumn.name",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "richtext",
      "id": "preheader",
      "label": "Pre-header text",
      "info": "Displayed above the section heading (e.g. 'The values behind the name')"
    },
    {
      "type": "color",
      "id": "preheader_color",
      "label": "Pre-header color",
      "info": "Leave empty to inherit the color scheme."
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.multicolumn.settings.title.default",
      "label": "t:sections.multicolumn.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" },
        { "value": "hxl", "label": "t:sections.all.heading_size.options__4.label" },
        { "value": "hxxl", "label": "t:sections.all.heading_size.options__5.label" }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description text",
      "info": "Displayed below the heading, above the columns"
    },
    {
      "type": "header",
      "content": "Card layout"
    },
    {
      "type": "checkbox",
      "id": "card_style",
      "default": false,
      "label": "Use card layout (border + icon)",
      "info": "Turn on for the values-style cards with a top-left icon. Leave off for logo/icon rows."
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card & icon border color",
      "default": "#e6ded0"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "info": "Leave empty for transparent (shows section background)."
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "info": "Leave empty to inherit text color."
    },
    {
      "type": "color",
      "id": "card_heading_color",
      "label": "Card heading color",
      "info": "Leave empty to inherit."
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card body text color",
      "info": "Leave empty to inherit."
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header_image.content"
    },
    {
      "type": "checkbox",
      "id": "icon_circle",
      "default": true,
      "label": "Show circle around image",
      "info": "For round logos. Ignored when Card layout is on."
    },
    {
      "type": "select",
      "id": "image_width",
      "options": [
        { "value": "third", "label": "t:sections.multicolumn.settings.image_width.options__1.label" },
        { "value": "half", "label": "t:sections.multicolumn.settings.image_width.options__2.label" },
        { "value": "full", "label": "t:sections.multicolumn.settings.image_width.options__3.label" }
      ],
      "default": "full",
      "label": "t:sections.multicolumn.settings.image_width.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "t:sections.multicolumn.settings.image_ratio.options__1.label" },
        { "value": "portrait", "label": "t:sections.multicolumn.settings.image_ratio.options__2.label" },
        { "value": "square", "label": "t:sections.multicolumn.settings.image_ratio.options__3.label" },
        { "value": "circle", "label": "t:sections.multicolumn.settings.image_ratio.options__4.label" }
      ],
      "default": "adapt",
      "label": "t:sections.multicolumn.settings.image_ratio.label"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header_button.content"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "t:sections.multicolumn.settings.button_label.default",
      "label": "t:sections.multicolumn.settings.button_label.label",
      "info": "t:sections.multicolumn.settings.button_label.info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.multicolumn.settings.button_link.label"
    },
    {
      "type": "richtext",
      "id": "footer_text",
      "label": "Footer text",
      "info": "Displayed below the columns in a narrow centered block (e.g. disclaimer or source notes)"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header_layout.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "t:sections.multicolumn.settings.columns_desktop.label"
    },
