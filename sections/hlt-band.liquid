{%- comment -%}
  HLT Band: a thin strip between two rules, for a side audience (business
  visitors, press) that should not pull shoppers away. With no link it stays off
  the live store, since a call to action with nowhere to go is worse than none.
{%- endcomment -%}
{%- liquid
  assign show = true
  if section.settings.link == blank and request.design_mode == false
    assign show = false
  endif
-%}
{%- if show -%}
  <section
    class="hlt hlt--{{ section.settings.background }} hlt-band"
    style="--hlt-pt: {{ section.settings.padding_top }}px; --hlt-pb: {{ section.settings.padding_bottom }}px;"
  >
    <div class="hlt__inner">
      <div class="hlt-band__rule" data-hlt-reveal>
        {%- if section.settings.overline != blank -%}<p class="hlt-overline hlt-band__label">{{ section.settings.overline }}</p>{%- endif -%}
        <div class="hlt-body hlt-band__text hlt-rte">
          {{ section.settings.text }}
          {%- if section.settings.link_label != blank -%}
            <a class="hlt-band__link" href="{{ section.settings.link | default: '#' }}"{% if section.settings.new_tab %} target="_blank" rel="noopener"{% endif %}>{{ section.settings.link_label }}</a>
          {%- endif -%}
        </div>
      </div>
      {%- if section.settings.link == blank and request.design_mode -%}
        <p class="hlt-small" style="margin-top: 10px;">Hidden on the live store until the link is set.</p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .hlt-band__rule {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 28px;
    padding: 24px 0; border-top: 2px solid var(--hlt-splash-deep); border-bottom: 2px solid var(--hlt-splash-deep);
  }
  .hlt-band__label { color: var(--hlt-splash-deep); flex: none; }
  .hlt-band__text { flex: 1 1 320px; min-width: 0; max-width: 72ch; font-size: 15px; }
  .hlt-band__text > p { display: inline; }
  .hlt-band__link { margin-left: 6px; font-weight: 700; color: var(--hlt-heading) !important; text-decoration: underline; text-underline-offset: 4px; }
{% endstylesheet %}

{% schema %}
{
  "name": "HLT Band",
  "tag": "div",
  "class": "hlt-section",
  "settings": [
    { "type": "text", "id": "overline", "label": "Label", "default": "For food makers" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>One or two sentences for a side audience.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Get in touch" },
    { "type": "url", "id": "link", "label": "Link", "info": "For an email address, write mailto:name@example.com. Empty keeps the band off the live store." },
    { "type": "checkbox", "id": "new_tab", "label": "Open the link in a new tab", "default": true },
    { "type": "select", "id": "background", "label": "Colour combination", "default": "paper", "options": [
      { "value": "cream", "label": "Cream" }, { "value": "paper", "label": "Paper" }, { "value": "splash-pale", "label": "Splash pale" }
    ] },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 }
  ],
  "presets": [ { "name": "HLT Band" } ]
}
{% endschema %}
