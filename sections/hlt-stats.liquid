{%- comment -%}
  HLT Number tiles: a heading, a row of figure tiles and a line or two under
  them. Built for a product's headline numbers (protein, fibre, calories, pack
  size). Four across on desktop and two across on phones, never four.
{%- endcomment -%}
{%- assign tiles = section.blocks | where: 'type', 'tile' -%}
{%- assign cta_target = section.settings.scroll_target | default: '#hlt-buy-box' -%}
<section
  class="hlt hlt--{{ section.settings.background }} hlt-stats"
  style="--hlt-pt: {{ section.settings.padding_top }}px; --hlt-pb: {{ section.settings.padding_bottom }}px; --hlt-stats-cols: {{ section.settings.columns }};"
>
  <div class="hlt__inner">
    <div class="hlt-stack hlt-stats__head{% if section.settings.align == 'center' %} hlt-center{% endif %}" data-hlt-stagger>
      {%- if section.settings.overline != blank -%}<p class="hlt-overline" data-hlt-reveal>{{ section.settings.overline }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="hlt-h2" data-hlt-reveal>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="hlt-body hlt-body--lg hlt-maxw hlt-rte" data-hlt-reveal>{{ section.settings.text }}</div>{%- endif -%}
    </div>

    {%- if tiles.size > 0 -%}
      <ul class="hlt-stats__grid" role="list" data-hlt-stagger>
        {%- for block in tiles -%}
          <li class="hlt-stats__tile" data-hlt-reveal {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}<span class="hlt-stats__icon" aria-hidden="true">{% render 'hlt-icon', name: block.settings.icon, size: 26 %}</span>{%- endif -%}
            <span class="hlt-stats__value">{{ block.settings.value }}</span>
            {%- if block.settings.label != blank -%}<span class="hlt-stats__label">{{ block.settings.label }}</span>{%- endif -%}
            {%- if block.settings.detail != blank -%}<span class="hlt-stats__detail">{{ block.settings.detail }}</span>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.body != blank or section.settings.small_print != blank or section.settings.button_label != blank -%}
      <div class="hlt-stack hlt-stats__foot{% if section.settings.align == 'center' %} hlt-center{% endif %}" data-hlt-stagger>
        {%- if section.settings.body != blank -%}<div class="hlt-body hlt-body--lg hlt-maxw hlt-rte" data-hlt-reveal>{{ section.settings.body }}</div>{%- endif -%}
        {%- if section.settings.small_print != blank -%}<p class="hlt-small hlt-maxw" data-hlt-reveal>{{ section.settings.small_print }}</p>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div class="hlt-btn-row" data-hlt-reveal>
            <a class="hlt-btn{% if section.settings.button_style == 'splash' %} hlt-btn--splash{% elsif section.settings.button_style == 'white' %} hlt-btn--white{% endif %}" href="{{ cta_target }}" data-hlt-scroll-to="{{ cta_target }}">
              {{- section.settings.button_label -}}
              {% render 'hlt-icon', name: 'arrow-right', size: 20 %}
            </a>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .hlt-stats__head { max-width: 820px; }
  .hlt-stats__head.hlt-center { margin: 0 auto; }
  .hlt-stats__grid {
    list-style: none; margin: 36px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px;
  }
  @media (min-width: 990px) {
    .hlt-stats__grid { grid-template-columns: repeat(var(--hlt-stats-cols, 4), minmax(0, 1fr)); gap: 18px; margin-top: 44px; }
  }
  .hlt-stats__tile {
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    padding: 26px 16px 24px; text-align: center;
    border-radius: var(--hlt-r-card); background: var(--hlt-paper);
    box-shadow: inset 0 0 0 1.5px rgba(59, 77, 56, 0.08);
  }
  .hlt--paper .hlt-stats__tile { background: var(--hlt-cream); }
  .hlt--navy .hlt-stats__tile, .hlt--deep-navy .hlt-stats__tile { background: rgba(255, 255, 255, 0.08); box-shadow: none; }
  .hlt-stats__icon { color: var(--hlt-splash-deep); margin-bottom: 4px; }
  .hlt-stats__icon .hlt-icon { width: 26px; height: 26px; }
  .hlt-stats__value {
    font-family: var(--hlt-font-display); font-weight: 800;
    font-size: clamp(32px, 3.6vw, 48px); line-height: 1; letter-spacing: -0.02em;
    color: var(--hlt-heading);
  }
  .hlt-stats__label { font-family: var(--hlt-font-body); font-weight: 700; font-size: 17px; line-height: 1.3; color: var(--hlt-heading); }
  .hlt-stats__detail { font-family: var(--hlt-font-mono); font-size: 12px; line-height: 1.45; color: var(--hlt-text); }
  .hlt-stats__foot { margin-top: 32px; }
  .hlt-stats__foot.hlt-center .hlt-maxw { margin-left: auto; margin-right: auto; }
  @media (max-width: 749px) {
    .hlt-stats__tile { padding: 20px 10px 18px; }
    .hlt-stats__label { font-size: 15px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "HLT Number tiles",
  "tag": "div",
  "class": "hlt-section",
  "max_blocks": 8,
  "settings": [
    { "type": "select", "id": "align", "label": "Alignment", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centred" } ] },
    { "type": "text", "id": "overline", "label": "Overline" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The numbers" },
    { "type": "richtext", "id": "text", "label": "Text above the tiles" },
    { "type": "range", "id": "columns", "label": "Tiles per row on desktop", "info": "Phones always show two across.", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "richtext", "id": "body", "label": "Text under the tiles" },
    { "type": "text", "id": "small_print", "label": "Small print" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Label", "info": "Scrolls to the buy box. Leave empty to hide it." },
    { "type": "text", "id": "scroll_target", "label": "Scroll target", "default": "#hlt-buy-box" },
    { "type": "select", "id": "button_style", "label": "Style", "default": "navy", "options": [
      { "value": "navy", "label": "Navy" }, { "value": "splash", "label": "Splash blue" }, { "value": "white", "label": "White" }
    ] },
    { "type": "header", "content": "Colours and spacing" },
    { "type": "select", "id": "background", "label": "Colour combination", "default": "splash-pale", "options": [
      { "value": "cream", "label": "Cream" }, { "value": "paper", "label": "Paper" }, { "value": "splash-pale", "label": "Splash pale" },
      { "value": "splash", "label": "Splash blue" }, { "value": "navy", "label": "Navy" }, { "value": "deep-navy", "label": "Deep navy" }
    ] },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "text", "id": "value", "label": "Figure", "default": "31.9g" },
        { "type": "text", "id": "label", "label": "Label", "default": "protein" },
        { "type": "text", "id": "detail", "label": "Detail line" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "none", "options": [
          { "value": "none", "label": "None" }, { "value": "bowl", "label": "Noodle bowl" }, { "value": "leaf", "label": "Leaf" },
          { "value": "gauge", "label": "Gauge" }, { "value": "clock", "label": "Clock" }, { "value": "package", "label": "Package" }, { "value": "check", "label": "Check" }
        ] }
      ]
    }
  ],
  "presets": [ { "name": "HLT Number tiles", "blocks": [ { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" } ] } ]
}
{% endschema %}
