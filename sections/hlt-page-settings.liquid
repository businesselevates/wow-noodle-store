{%- comment -%}
  Loads the HLT page system for this page, so the sections work in any theme
  without editing its layout (Horizon included). Keep this section at the top of
  a template that uses HLT sections. Loading it twice is harmless.
{%- endcomment -%}
{%- render 'hlt-assets' -%}
{%- if section.settings.hide_menu -%}
  <style>
    .section-header .header__inline-menu,
    .section-header header-drawer,
    .section-header .header__icon--account,
    .section-header .header__search,
    .section-header details-modal.header__search { display: none !important; }
    .section-header .header { grid-template-columns: 1fr auto; }
  </style>
{%- endif -%}
{%- if section.settings.hide_announcement -%}
  <style>.section-announcement-bar, #shopify-section-sections--announcement-bar, .announcement-bar-section { display: none !important; }</style>
{%- endif -%}
{%- if section.settings.roca_files -%}
  {%- comment -%}
    Roca Two, ProTEGO(R)'s display face, is licensed and not on Google Fonts. Upload
    roca-two-regular.woff2, roca-two-bold.woff2 and roca-two-black.woff2 under Content >
    Files (they then survive a change of theme), and tick the setting. Headings use
    Fraunces until then.
  {%- endcomment -%}
  <style>
    @font-face { font-family: 'Roca Two'; src: url('{{ 'roca-two-regular.woff2' | file_url }}') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
    @font-face { font-family: 'Roca Two'; src: url('{{ 'roca-two-bold.woff2' | file_url }}') format('woff2'); font-weight: 700; font-style: normal; font-display: swap; }
    @font-face { font-family: 'Roca Two'; src: url('{{ 'roca-two-black.woff2' | file_url }}') format('woff2'); font-weight: 900; font-style: normal; font-display: swap; }
  </style>
{%- endif -%}
{%- if request.design_mode -%}
  <div class="hlt hlt--splash-pale" style="padding: 10px 20px; font-size: 13px; text-align: center;">
    HLT page settings (only visible in the editor): header menu links are {% if section.settings.hide_menu %}hidden{% else %}shown{% endif %} on this page. Headings use {% if section.settings.roca_files %}Roca Two{% else %}Fraunces, standing in for Roca Two{% endif %}.
  </div>
{%- endif -%}

{% schema %}
{
  "name": "HLT Page settings",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "hide_menu", "label": "Hide header menu links on this page", "info": "Leaves only the logo and cart, as the build spec suggests.", "default": false },
    { "type": "checkbox", "id": "hide_announcement", "label": "Hide the announcement bar on this page", "default": false },
    { "type": "header", "content": "Brand font" },
    { "type": "checkbox", "id": "roca_files", "label": "Roca Two font files are uploaded", "info": "Upload roca-two-regular.woff2, roca-two-bold.woff2 and roca-two-black.woff2 under Content > Files, with exactly those names, then tick this. Until then headings use Fraunces.", "default": false }
  ],
  "presets": [ { "name": "HLT Page settings" } ]
}
{% endschema %}
