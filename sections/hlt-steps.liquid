{%- comment -%}
  HLT Steps: a numbered method in cards, one image per step. Three across on
  desktop, one per row on phones.
{%- endcomment -%}
{%- assign steps = section.blocks | where: 'type', 'step' -%}
{%- assign cta_target = section.settings.scroll_target | default: '#hlt-buy-box' -%}
<section
  class="hlt hlt--{{ section.settings.background }} hlt-steps"
  style="--hlt-pt: {{ section.settings.padding_top }}px; --hlt-pb: {{ section.settings.padding_bottom }}px; --hlt-steps-cols: {{ section.settings.columns }};"
>
  <div class="hlt__inner">
    <div class="hlt-stack hlt-steps__head{% if section.settings.align == 'center' %} hlt-center{% endif %}" data-hlt-stagger>
      {%- if section.settings.overline != blank -%}<p class="hlt-overline" data-hlt-reveal>{{ section.settings.overline }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="hlt-h2" data-hlt-reveal>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="hlt-body hlt-body--lg hlt-maxw hlt-rte" data-hlt-reveal>{{ section.settings.text }}</div>{%- endif -%}
    </div>

    {%- if steps.size > 0 -%}
      <ol class="hlt-steps__grid" role="list" data-hlt-stagger>
        {%- for block in steps -%}
          <li class="hlt-card hlt-steps__card" data-hlt-reveal {{ block.shopify_attributes }}>
            <div class="hlt-media hlt-steps__media" style="--hlt-ratio: {{ section.settings.ratio }};">
              {%- if block.settings.video != blank -%}
                {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '900x' }}
              {%- elsif block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, 100vw' }}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'hlt-placeholder' }}
              {%- endif -%}
              {%- if section.settings.show_numbers -%}<span class="hlt-steps__num" aria-hidden="true">{{ forloop.index }}</span>{%- endif -%}
            </div>
            <div class="hlt-steps__copy">
              {%- if block.settings.title != blank -%}<h3 class="hlt-h4">{{ block.settings.title }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<div class="hlt-body hlt-rte">{{ block.settings.text }}</div>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if section.settings.body != blank or section.settings.button_label != blank -%}
      <div class="hlt-stack hlt-steps__foot{% if section.settings.align == 'center' %} hlt-center{% endif %}" data-hlt-stagger>
        {%- if section.settings.body != blank -%}<div class="hlt-body hlt-body--lg hlt-maxw hlt-rte" data-hlt-reveal>{{ section.settings.body }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div class="hlt-btn-row" data-hlt-reveal>
            <a class="hlt-btn{% if section.settings.button_style == 'splash' %} hlt-btn--splash{% elsif section.settings.button_style == 'white' %} hlt-btn--white{% endif %}" href="{{ cta_target }}" data-hlt-scroll-to="{{ cta_target }}">
              {{- section.settings.button_label -}}
              {% render 'hlt-icon', name: 'arrow-right', size: 20 %}
            </a>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .hlt-steps__head { max-width: 820px; }
  .hlt-steps__head.hlt-center, .hlt-steps__foot.hlt-center .hlt-maxw { margin-left: auto; margin-right: auto; }
  .hlt-steps__grid { list-style: none; margin: 36px 0 0; padding: 0; display: grid; gap: 18px; }
  @media (min-width: 750px) { .hlt-steps__grid { grid-template-columns: repeat(var(--hlt-steps-cols, 3), minmax(0, 1fr)); gap: 20px; margin-top: 44px; } }
  .hlt-steps__card { display: flex; flex-direction: column; overflow: hidden; }
  .hlt-steps__media { border-radius: var(--hlt-r-card) var(--hlt-r-card) 0 0; }
  .hlt-steps__num {
    position: absolute; left: 14px; top: 14px; z-index: 1;
    display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 50%;
    background: var(--hlt-paper); color: var(--hlt-navy);
    font-family: var(--hlt-font-display); font-weight: 800; font-size: 18px;
    box-shadow: 0 6px 16px -8px rgba(31, 77, 58, 0.4);
  }
  .hlt-steps__copy { display: grid; gap: 8px; padding: 20px 22px 24px; }
  .hlt-steps__copy .hlt-h4 { color: var(--hlt-navy); }
  .hlt-steps__copy .hlt-body { font-size: 16px; line-height: 1.6; color: var(--hlt-grey); }
  .hlt-steps__foot { margin-top: 32px; }
{% endstylesheet %}

{% schema %}
{
  "name": "HLT Steps",
  "tag": "div",
  "class": "hlt-section",
  "max_blocks": 6,
  "settings": [
    { "type": "select", "id": "align", "label": "Alignment", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centred" } ] },
    { "type": "text", "id": "overline", "label": "Overline" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three steps." },
    { "type": "richtext", "id": "text", "label": "Text above the steps" },
    { "type": "range", "id": "columns", "label": "Steps per row on desktop", "info": "Phones show one per row.", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "select", "id": "ratio", "label": "Image shape", "default": "4 / 3", "options": [ { "value": "1 / 1", "label": "Square" }, { "value": "4 / 3", "label": "Landscape" }, { "value": "4 / 5", "label": "Portrait" } ] },
    { "type": "checkbox", "id": "show_numbers", "label": "Number the steps on the image", "default": false },
    { "type": "richtext", "id": "body", "label": "Text under the steps" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Label", "info": "Scrolls to the buy box. Leave empty to hide it." },
    { "type": "text", "id": "scroll_target", "label": "Scroll target", "default": "#hlt-buy-box" },
    { "type": "select", "id": "button_style", "label": "Style", "default": "navy", "options": [
      { "value": "navy", "label": "Navy" }, { "value": "splash", "label": "Splash blue" }, { "value": "white", "label": "White" }
    ] },
    { "type": "header", "content": "Colours and spacing" },
    { "type": "select", "id": "background", "label": "Colour combination", "default": "cream", "options": [
      { "value": "cream", "label": "Cream" }, { "value": "paper", "label": "Paper" }, { "value": "splash-pale", "label": "Splash pale" }
    ] },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "video", "id": "video", "label": "Video (replaces image, plays muted on loop)" },
        { "type": "text", "id": "title", "label": "Title", "default": "1. Boil." },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>One line on what to do.</p>" }
      ]
    }
  ],
  "presets": [ { "name": "HLT Steps", "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" } ] } ]
}
{% endschema %}
