{%- comment -%}
  HLT Comparison: a bar chart that makes one argument, then a table for
  everything a number cannot say. Either half can be left out: with no Bar
  blocks there is no chart, with no Table row blocks there is no table.

  Bars are scaled on the figure alone, against the largest figure in the chart
  (or the 'Scale the bars to' setting). The last column is plain text beside
  the bar, so a second number never becomes a second bar.
{%- endcomment -%}
{%- liquid
  assign bars = section.blocks | where: 'type', 'bar'
  assign rows = section.blocks | where: 'type', 'row'
  assign cta_target = section.settings.scroll_target | default: '#hlt-buy-box'

  assign bar_max = section.settings.bar_max | plus: 0.0
  if bar_max <= 0
    assign bar_max = 0.0
    for b in bars
      assign bv = b.settings.value | plus: 0.0
      if bv > bar_max
        assign bar_max = bv
      endif
    endfor
  endif
-%}
<section
  class="hlt hlt--{{ section.settings.background }} hlt-cmp"
  style="--hlt-pt: {{ section.settings.padding_top }}px; --hlt-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="hlt__inner hlt-cmp__inner">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="hlt-stack hlt-cmp__head" data-hlt-stagger>
        {%- if section.settings.overline != blank -%}<p class="hlt-overline" data-hlt-reveal>{{ section.settings.overline }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="hlt-h2" data-hlt-reveal>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="hlt-body hlt-body--lg hlt-rte" data-hlt-reveal>{{ section.settings.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if bars.size > 0 -%}
      <div class="hlt-cmp__chart" role="table" aria-label="{{ section.settings.heading | strip_html | escape }}">
        <div class="hlt-cmp__bar-row hlt-cmp__bar-row--head" role="row">
          <span role="columnheader"><span class="visually-hidden">{{ section.settings.label_heading | default: 'Food' }}</span></span>
          <span aria-hidden="true"></span>
          <span class="hlt-cmp__num" role="columnheader">{{ section.settings.value_heading }}</span>
          <span class="hlt-cmp__num" role="columnheader">{{ section.settings.extra_heading }}</span>
        </div>
        {%- for block in bars -%}
          {%- liquid
            assign bv = block.settings.value | plus: 0.0
            assign pct = 0
            if bar_max > 0
              assign pct = bv | times: 100.0 | divided_by: bar_max | round: 1
            endif
            if pct > 100
              assign pct = 100
            endif
          -%}
          <div class="hlt-cmp__bar-row{% if block.settings.highlight %} is-us{% endif %}" role="row" data-hlt-reveal {{ block.shopify_attributes }}>
            <span class="hlt-cmp__label" role="rowheader">
              {{- block.settings.label -}}
              {%- if block.settings.sublabel != blank -%}<span class="hlt-cmp__sublabel">{{ block.settings.sublabel }}</span>{%- endif -%}
            </span>
            <span class="hlt-cmp__track" aria-hidden="true"><span class="hlt-cmp__fill" style="width: {{ pct }}%;"></span></span>
            <span class="hlt-cmp__num hlt-cmp__value" role="cell">{{ block.settings.value_text | default: block.settings.value }}</span>
            <span class="hlt-cmp__num hlt-cmp__extra" role="cell">{{ block.settings.extra_text }}</span>
          </div>
        {%- endfor -%}
      </div>
      {%- if section.settings.chart_note != blank -%}<div class="hlt-small hlt-cmp__note hlt-rte" data-hlt-reveal>{{ section.settings.chart_note }}</div>{%- endif -%}
    {%- endif -%}

    {%- if rows.size > 0 -%}
      {%- if section.settings.table_heading != blank or section.settings.table_text != blank -%}
        <div class="hlt-stack hlt-cmp__head hlt-cmp__head--table" data-hlt-stagger>
          {%- if section.settings.table_heading != blank -%}<h2 class="hlt-h2" data-hlt-reveal>{{ section.settings.table_heading }}</h2>{%- endif -%}
          {%- if section.settings.table_text != blank -%}<div class="hlt-body hlt-body--lg hlt-rte" data-hlt-reveal>{{ section.settings.table_text }}</div>{%- endif -%}
        </div>
      {%- endif -%}
      <div class="hlt-cmp__table-wrap" data-hlt-reveal>
        <table class="hlt-cmp__table">
          <thead>
            <tr>
              <th scope="col">{{ section.settings.col1_label }}</th>
              <th scope="col">{{ section.settings.them_label }}</th>
              <th scope="col" class="is-us">{{ section.settings.us_label }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in rows -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.label }}</th>
                <td>{{ block.settings.them }}</td>
                <td class="is-us{% if block.settings.win %} is-win{% endif %}">
                  {%- if block.settings.win -%}{% render 'hlt-icon', name: 'check', size: 16 %}{%- endif -%}
                  <span>{{ block.settings.us }}</span>
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="hlt-btn-row hlt-cmp__cta" data-hlt-reveal>
        <a class="hlt-btn{% if section.settings.button_style == 'splash' %} hlt-btn--splash{% elsif section.settings.button_style == 'white' %} hlt-btn--white{% endif %}" href="{{ cta_target }}" data-hlt-scroll-to="{{ cta_target }}">
          {{- section.settings.button_label -}}
          {% render 'hlt-icon', name: 'arrow-right', size: 20 %}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .hlt-cmp__inner { max-width: 1040px; }
  .hlt-cmp__head { max-width: 780px; margin-bottom: 32px; }
  .hlt-cmp__head--table { margin-top: clamp(48px, 7vw, 88px); }

  /* Chart */
  .hlt-cmp__chart { display: grid; gap: 10px; }
  .hlt-cmp__bar-row {
    display: grid; align-items: center; gap: 14px;
    grid-template-columns: minmax(0, 210px) minmax(0, 1fr) 64px 88px;
    font-size: 15px; line-height: 1.3; color: var(--hlt-heading);
  }
  .hlt-cmp__bar-row--head { font-family: var(--hlt-font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--hlt-text); margin-bottom: 2px; }
  .hlt-cmp__label { font-weight: 600; }
  .hlt-cmp__sublabel { display: block; font-weight: 400; font-size: 12px; color: var(--hlt-text); }
  .hlt-cmp__track { position: relative; height: 28px; border-radius: 8px; background: rgba(59, 77, 56, 0.06); overflow: hidden; }
  .hlt-cmp__fill {
    position: absolute; left: 0; top: 0; bottom: 0; border-radius: 8px;
    background: var(--hlt-navy-100);
    transform-origin: left center;
    transition: transform 1.1s var(--hlt-ease);
  }
  .hlt-js .hlt-cmp__bar-row[data-hlt-reveal] .hlt-cmp__fill { transform: scaleX(0); }
  .hlt-js .hlt-cmp__bar-row[data-hlt-reveal].is-in .hlt-cmp__fill { transform: scaleX(1); transition-delay: 0.15s; }
  .hlt-anim-off .hlt-cmp__fill, .shopify-design-mode .hlt-cmp__fill { transform: none !important; }
  .hlt-cmp__num { text-align: right; white-space: nowrap; }
  .hlt-cmp__value { font-family: var(--hlt-font-display); font-weight: 800; }
  .hlt-cmp__extra { font-family: var(--hlt-font-mono); font-size: 13px; color: var(--hlt-text); }
  .hlt-cmp__bar-row.is-us { font-weight: 800; }
  .hlt-cmp__bar-row.is-us .hlt-cmp__label { font-family: var(--hlt-font-display); font-weight: 800; font-size: 17px; }
  .hlt-cmp__bar-row.is-us .hlt-cmp__fill { background: var(--hlt-navy); }
  .hlt-cmp__bar-row.is-us .hlt-cmp__value { font-size: 18px; }
  .hlt-cmp__note { margin-top: 18px !important; max-width: 820px; }
  @media (max-width: 749px) {
    .hlt-cmp__bar-row { grid-template-columns: minmax(0, 100px) minmax(0, 1fr) 48px 66px; gap: 8px; font-size: 13px; }
    .hlt-cmp__bar-row--head { font-size: 9px; letter-spacing: 0.04em; }
    .hlt-cmp__track { height: 22px; }
    .hlt-cmp__extra { font-size: 11px; }
    .hlt-cmp__bar-row.is-us .hlt-cmp__label { font-size: 14px; }
    .hlt-cmp__bar-row.is-us .hlt-cmp__value { font-size: 15px; }
  }

  /* Table */
  .hlt-cmp__table-wrap { border-radius: var(--hlt-r-card); overflow: hidden; box-shadow: inset 0 0 0 1.5px rgba(59, 77, 56, 0.1); background: var(--hlt-paper); }
  .hlt-cmp__table { width: 100%; border-collapse: collapse; font-size: 15px; line-height: 1.45; color: var(--hlt-heading); }
  .hlt-cmp__table th, .hlt-cmp__table td { padding: 14px 18px; text-align: left; vertical-align: top; border-top: 1.5px solid rgba(59, 77, 56, 0.08); }
  .hlt-cmp__table thead th {
    border-top: 0; background: var(--hlt-cream);
    font-family: var(--hlt-font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--hlt-text);
  }
  .hlt-cmp__table thead th.is-us { background: var(--hlt-navy); color: #fff; }
  .hlt-cmp__table tbody th { font-weight: 700; width: 30%; }
  .hlt-cmp__table tbody td { color: var(--hlt-text); }
  .hlt-cmp__table td.is-us { background: var(--hlt-splash-pale); color: var(--hlt-heading); }
  .hlt-cmp__table td.is-win { font-weight: 700; }
  .hlt-cmp__table td.is-us .hlt-icon { float: left; margin: 2px 8px 0 0; color: var(--hlt-splash-deep); stroke-width: 2.4; }
  .hlt-cmp__table td.is-us span { display: block; overflow: hidden; }
  @media (max-width: 749px) {
    .hlt-cmp__table { font-size: 13px; }
    .hlt-cmp__table th, .hlt-cmp__table td { padding: 11px 10px; }
    .hlt-cmp__table tbody th { width: 32%; }
    .hlt-cmp__table td.is-us .hlt-icon { display: none; }
  }
  .hlt-cmp__cta { margin-top: 36px; }
{% endstylesheet %}

{% schema %}
{
  "name": "HLT Comparison",
  "tag": "div",
  "class": "hlt-section",
  "max_blocks": 30,
  "settings": [
    { "type": "header", "content": "Chart" },
    { "type": "text", "id": "overline", "label": "Overline" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The same 100g, side by side." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "label_heading", "label": "First column heading (screen readers only)", "default": "Food" },
    { "type": "text", "id": "value_heading", "label": "Bar figure heading", "default": "Protein" },
    { "type": "text", "id": "extra_heading", "label": "Last column heading", "default": "Calories" },
    { "type": "text", "id": "bar_max", "label": "Scale the bars to", "info": "The figure a full-width bar stands for. Leave empty to use the largest bar." },
    { "type": "richtext", "id": "chart_note", "label": "Small print under the chart", "info": "Where the figures come from." },
    { "type": "header", "content": "Table" },
    { "type": "text", "id": "table_heading", "label": "Heading" },
    { "type": "richtext", "id": "table_text", "label": "Text" },
    { "type": "text", "id": "col1_label", "label": "First column heading", "default": "Per 100g" },
    { "type": "text", "id": "them_label", "label": "Middle column heading", "default": "The usual" },
    { "type": "text", "id": "us_label", "label": "Last column heading (ours)", "default": "Ours" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Label", "info": "Scrolls to the buy box. Leave empty to hide it." },
    { "type": "text", "id": "scroll_target", "label": "Scroll target", "default": "#hlt-buy-box" },
    { "type": "select", "id": "button_style", "label": "Style", "default": "navy", "options": [
      { "value": "navy", "label": "Navy" }, { "value": "splash", "label": "Splash blue" }, { "value": "white", "label": "White" }
    ] },
    { "type": "header", "content": "Colours and spacing" },
    { "type": "select", "id": "background", "label": "Colour combination", "default": "paper", "options": [
      { "value": "cream", "label": "Cream" }, { "value": "paper", "label": "Paper" }, { "value": "splash-pale", "label": "Splash pale" }
    ] },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "bar",
      "name": "Bar",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "White rice" },
        { "type": "text", "id": "sublabel", "label": "Line under the label" },
        { "type": "text", "id": "value", "label": "Figure for the bar", "info": "A plain number, for example 7.1. Sets the bar's length.", "default": "7.1" },
        { "type": "text", "id": "value_text", "label": "Figure as shown", "info": "For example 7.1g. Empty shows the plain number.", "default": "7.1g" },
        { "type": "text", "id": "extra_text", "label": "Last column", "info": "Plain text beside the bar, for example 365 kcal.", "default": "365 kcal" },
        { "type": "checkbox", "id": "highlight", "label": "This is our product", "default": false }
      ]
    },
    {
      "type": "row",
      "name": "Table row",
      "settings": [
        { "type": "text", "id": "label", "label": "Row label", "default": "Protein" },
        { "type": "text", "id": "them", "label": "Middle column", "default": "5.6g to 20g" },
        { "type": "text", "id": "us", "label": "Last column (ours)", "default": "31.9g" },
        { "type": "checkbox", "id": "win", "label": "Mark ours as the better figure", "info": "Adds a tick and bold type. Leave it off for rows that come out even.", "default": true }
      ]
    }
  ],
  "presets": [ { "name": "HLT Comparison", "blocks": [ { "type": "bar" }, { "type": "bar", "settings": { "label": "Ours", "value": "31.9", "value_text": "31.9g", "extra_text": "340 kcal", "highlight": true } }, { "type": "row" } ] } ]
}
{% endschema %}
