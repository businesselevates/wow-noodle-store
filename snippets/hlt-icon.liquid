{%- comment -%}
  Outline icons in the Tabler style required by the brand guidelines (stroke 1.75, round caps and joins).
  Usage: {% render 'hlt-icon', name: 'leaf', size: 20 %}
{%- endcomment -%}
{%- liquid
  assign s = size | default: 20
  assign fill = 'none'
  if name == 'star'
    assign fill = 'currentColor'
  endif

  comment
    Most icons are drawn on the 24 grid at 1.75 stroke. The three snack-story
    icons carry more detail than that grid holds, so they are drawn on 48 at a
    stroke that reads the same once scaled.
  endcomment
  assign box = '0 0 24 24'
  assign stroke = '1.75'
  assign wide_grid = 'snack-bag-question,snack-bag-soft,bin'
  assign needle = ',' | append: name | append: ','
  assign wide_grid = ',' | append: wide_grid | append: ','
  if wide_grid contains needle
    assign box = '0 0 48 48'
    assign stroke = '2'
  endif
-%}
<svg class="hlt-icon" width="{{ s }}" height="{{ s }}" viewBox="{{ box }}" fill="{{ fill }}" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
