{%- comment -%}
  Featured range block (homepage 07): three facts with an image, three reviews, then the gift set
  picker modelled on Pai's "Find your routine": tabs, items joined by plus signs with live
  prices, a typed total bar, one button to the product page with that set selected.
  Each set's 11.11 total can carry dates (Singapore time) and swaps in on its own.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="dh dh--{{ s.background }}" style="--dh-pt-d: {{ s.padding_top }}px; --dh-pb-d: {{ s.padding_bottom }}px;">
  <div class="dh__inner">
    <div class="dh-feat__top">
      <div class="dh-stack">
        {%- if s.eyebrow != blank -%}<p class="dh-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="dh-h2">{{ s.heading }}</h2>
        <ul class="dh-feat__points">
          {%- for i in (1..3) -%}
            {%- assign key = 'point_' | append: i -%}
            {%- if s[key] != blank -%}<li>{{ s[key] }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
        {%- if s.more_label != blank -%}<p><a class="dh-link" href="{{ s.more_link | default: '#' }}">{{ s.more_label }}</a></p>{%- endif -%}
      </div>
      {%- if s.image != blank -%}
        <div class="dh-media dh-media--square">{{ s.image | image_url: width: 1200 | image_tag: widths: '480, 720, 960, 1200', sizes: '(min-width: 990px) 46vw, 100vw', loading: 'lazy', alt: s.image_alt }}</div>
      {%- endif -%}
    </div>

    <div class="dh-scroll-row dh-scroll-row--desktop-grid" style="margin-top:40px">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' and block.settings.show -%}
          <figure class="dh-review" {{ block.shopify_attributes }}>
            <blockquote>“{{ block.settings.quote }}”</blockquote>
            <figcaption><cite>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.cite }}</a>{% else %}{{ block.settings.cite }}{% endif %}</cite></figcaption>
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- liquid
      assign sets = section.blocks | where: 'type', 'set'
    -%}
    {%- if sets.size > 0 -%}
      <div class="dh-picker">
        <div class="dh-picker__grid">
          <div class="dh-picker__media">
            {%- for block in sets -%}
              <div id="dh-set-img-{{ block.id }}" data-dh-panel{% unless forloop.first %} hidden{% endunless %}>
                {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1200 | image_tag: widths: '480, 720, 960, 1200', sizes: '(min-width: 990px) 46vw, 100vw', loading: 'lazy', alt: block.settings.image_alt }}{%- endif -%}
              </div>
            {%- endfor -%}
          </div>
          <div class="dh-picker__body">
            {%- if s.picker_heading != blank -%}<h3 class="dh-h3">{{ s.picker_heading }}</h3>{%- endif -%}
            <div class="dh-tabs" role="tablist" aria-label="{{ s.picker_heading | escape }}" data-dh-tabs>
              {%- for block in sets -%}
                <button type="button" role="tab" id="dh-set-tab-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="dh-set-{{ block.id }} dh-set-img-{{ block.id }}"{% unless forloop.first %} tabindex="-1"{% endunless %} {{ block.shopify_attributes }}>{{ block.settings.tab }}</button>
              {%- endfor -%}
            </div>
            {%- for block in sets -%}
              {%- assign b = block.settings -%}
              <div id="dh-set-{{ block.id }}" role="tabpanel" aria-labelledby="dh-set-tab-{{ block.id }}" data-dh-panel class="dh-stack"{% unless forloop.first %} hidden{% endunless %}>
                <ul class="dh-picker__items">
                  {%- for i in (1..3) -%}
                    {%- liquid
                      assign pk = 'product_' | append: i
                      assign nk = 'name_' | append: i
                      assign item = b[pk]
                    -%}
                    {%- if item != blank -%}
                      <li><span class="dh-picker__name">{{ b[nk] | default: item.title }}</span><span>{{ item.price | money_without_currency | remove: '.00' | prepend: 'S$' }}</span></li>
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if b.extra_name != blank -%}<li><span class="dh-picker__name">{{ b.extra_name }}</span><span>{{ b.extra_price }}</span></li>{%- endif -%}
                </ul>
                <div data-dh-one-of>
                  {%- if b.total_sale != blank and b.sale_start != blank -%}<p class="dh-picker__total" data-dh-scheduled data-dh-start="{{ b.sale_start | escape }}" data-dh-end="{{ b.sale_end | escape }}" hidden>{{ b.total_sale }}</p>{%- endif -%}
                  <p class="dh-picker__total" data-dh-scheduled>{{ b.total }}</p>
                </div>
                <div class="dh-actions"><a class="dh-btn dh-btn--solid" href="{{ b.link | default: '#' }}">{{ b.button_label }}</a></div>
              </div>
            {%- endfor -%}
            {%- if s.under != blank -%}<div class="dh-rte dh-small">{{ s.under }}</div>{%- endif -%}
            {%- if s.promise != blank -%}
              {%- if s.show_promise -%}<p class="dh-small">{{ s.promise }}</p>{%- else -%}<p class="dh-ph">Hidden until Lyne agrees the 30-day promise terms: {{ s.promise }}</p>{%- endif -%}
            {%- endif -%}
            {%- if s.sale_line != blank and s.sale_start != blank -%}<p class="dh-small" data-dh-scheduled data-dh-start="{{ s.sale_start | escape }}" data-dh-end="{{ s.sale_end | escape }}" hidden>{{ s.sale_line }}</p>{%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "DH: Featured range",
  "tag": "div",
  "class": "dh-section",
  "settings": [
    { "type": "select", "id": "background", "label": "Background", "default": "warm", "options": [ { "value": "white", "label": "White" }, { "value": "warm", "label": "Warm grey" }, { "value": "green", "label": "Soft green" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "text", "id": "point_1", "label": "Fact 1" },
    { "type": "text", "id": "point_2", "label": "Fact 2" },
    { "type": "text", "id": "point_3", "label": "Fact 3" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "1200 x 1200." },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "text", "id": "more_label", "label": "Link" },
    { "type": "url", "id": "more_link", "label": "Link URL" },
    { "type": "header", "content": "Gift set picker" },
    { "type": "text", "id": "picker_heading", "label": "Picker heading" },
    { "type": "richtext", "id": "under", "label": "Text under the picker" },
    { "type": "text", "id": "promise", "label": "Promise line" },
    { "type": "checkbox", "id": "show_promise", "label": "Show the promise line", "default": false },
    { "type": "text", "id": "sale_line", "label": "Sale line (dated)" },
    { "type": "text", "id": "sale_start", "label": "Sale line start (Singapore time)" },
    { "type": "text", "id": "sale_end", "label": "Sale line end (Singapore time)" },
    { "type": "range", "id": "padding_top", "label": "Top padding, desktop", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding, desktop", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "checkbox", "id": "show", "label": "Show", "default": true },
      { "type": "textarea", "id": "quote", "label": "Quote, word for word" },
      { "type": "text", "id": "cite", "label": "Name · product · site" },
      { "type": "url", "id": "link", "label": "Link to the product it names" }
    ] },
    { "type": "set", "name": "Gift set tab", "settings": [
      { "type": "text", "id": "tab", "label": "Tab", "default": "Face and hands" },
      { "type": "product", "id": "product_1", "label": "Item 1" }, { "type": "text", "id": "name_1", "label": "Item 1 name" },
      { "type": "product", "id": "product_2", "label": "Item 2" }, { "type": "text", "id": "name_2", "label": "Item 2 name" },
      { "type": "product", "id": "product_3", "label": "Item 3" }, { "type": "text", "id": "name_3", "label": "Item 3 name" },
      { "type": "text", "id": "extra_name", "label": "Extra item", "default": "Facial at our International Plaza studio" },
      { "type": "text", "id": "extra_price", "label": "Extra item price", "default": "S$98" },
      { "type": "text", "id": "total", "label": "Total bar", "info": "Typed from the offer: change it the same day a live price changes." },
      { "type": "text", "id": "total_sale", "label": "Sale total bar (dated)" },
      { "type": "text", "id": "sale_start", "label": "Sale start (Singapore time)", "info": "e.g. 2026-11-11T00:00" },
      { "type": "text", "id": "sale_end", "label": "Sale end (Singapore time)", "info": "e.g. 2026-11-15T23:59" },
      { "type": "text", "id": "button_label", "label": "Button", "default": "Choose this set" },
      { "type": "url", "id": "link", "label": "Button link", "info": "The product page with this set selected, e.g. ?set=gift" },
      { "type": "image_picker", "id": "image", "label": "Image", "info": "1200 x 1200." },
      { "type": "text", "id": "image_alt", "label": "Image alt text" }
    ] }
  ],
  "presets": [ { "name": "DH: Featured range" } ]
}
{% endschema %}