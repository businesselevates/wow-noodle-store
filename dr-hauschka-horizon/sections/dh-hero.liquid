{%- comment -%}
  Homepage hero. Slide 1 is the month's store-wide campaign, slide 2 the featured product.
  Each slide can carry a start and end date (Singapore time), so the 11.11 slide and the
  monthly swaps go up and come down on their own. Rotation never faster than 7 seconds,
  pauses on hover, focus and tap, and does not move under reduced motion.
  "[from_price]" in a slide's text becomes the cheapest available price in its collection.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="dh-hero" data-dh-hero data-delay="{{ s.delay | times: 1000 }}" aria-roledescription="carousel" aria-label="{{ s.label | escape }}">
  <div class="dh-hero__track">
    {%- for block in section.blocks -%}
      {%- liquid
        assign b = block.settings
        assign from_text = ''
        if b.price_collection != blank
          assign cheapest = 999999999
          for cp in b.price_collection.products
            if cp.available == false
              continue
            endif
            if b.price_skip_tag != blank and cp.tags contains b.price_skip_tag
              continue
            endif
            if b.price_title_has != blank
              unless cp.title contains b.price_title_has
                continue
              endunless
            endif
            if cp.price < cheapest
              assign cheapest = cp.price
            endif
          endfor
          if cheapest < 999999999
            assign from_text = cheapest | money_without_currency | remove: '.00' | prepend: 'S$'
          endif
        endif
        assign body = b.text | replace: '[from_price]', from_text
        assign heading_tag = 'h2'
        if b.is_h1
          assign heading_tag = 'h1'
        endif
        case b.background
          when 'green'
            assign bg = 'var(--dh-green)'
          when 'pink'
            assign bg = 'var(--dh-pink)'
          when 'white'
            assign bg = 'var(--dh-white)'
          else
            assign bg = 'var(--dh-warm)'
        endcase
      -%}
      {%- if b.show -%}
        <div class="dh-hero__slide{% if forloop.first %} is-active{% endif %}" data-dh-slide data-dh-scheduled{% if b.start != blank %} data-dh-start="{{ b.start | escape }}"{% endif %}{% if b.end != blank %} data-dh-end="{{ b.end | escape }}"{% endif %} role="group" aria-roledescription="slide" aria-label="{{ b.heading | strip_html | escape }}" style="--slide-bg: {{ bg }};" {{ block.shopify_attributes }}>
          <div class="dh-hero__media{% if b.image == blank %} dh-hero__media--fallback{% endif %}">
            {%- if b.image != blank -%}
              {%- assign mob = b.image_mobile | default: b.image -%}
              <picture>
                <source media="(min-width: 990px)" srcset="{{ b.image | image_url: width: 1600 }} 1600w, {{ b.image | image_url: width: 2200 }} 2200w, {{ b.image | image_url: width: 2560 }} 2560w" sizes="100vw">
                {{ mob | image_url: width: 1170 | image_tag: widths: '600, 800, 1000, 1170', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: b.alt }}
              </picture>
            {%- else -%}
              {%- for fp in b.fallback_products limit: 3 -%}
                {%- if fp.featured_image -%}{{ fp.featured_image | image_url: width: 600 | image_tag: loading: 'eager', alt: '', sizes: '(min-width: 990px) 14vw, 30vw', widths: '300, 450, 600' }}{%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
          <div class="dh-hero__content">
            {%- if b.eyebrow != blank -%}<p class="dh-eyebrow">{{ b.eyebrow }}</p>{%- endif -%}
            <{{ heading_tag }} class="dh-h1">{{ b.heading }}</{{ heading_tag }}>
            {%- if body != blank -%}<div class="dh-rte">{{ body }}</div>{%- endif -%}
            {%- if b.button_label != blank or b.link_label != blank -%}
              <div class="dh-actions">
                {%- if b.button_label != blank -%}<a class="dh-btn dh-btn--solid" href="{{ b.button_link | default: '#' }}">{{ b.button_label }}</a>{%- endif -%}
                {%- if b.link_label != blank -%}<a class="dh-link" href="{{ b.link_url | default: '#' }}">{{ b.link_label }}</a>{%- endif -%}
              </div>
            {%- endif -%}
            {%- if b.note != blank -%}<p class="dh-ph">{{ b.note }}</p>{%- endif -%}
          </div>
        </div>
      {%- elsif request.design_mode -%}
        <p class="dh-ph" {{ block.shopify_attributes }}>Slide off: {{ b.heading | strip_html }}{% if b.start != blank %} (scheduled {{ b.start }} to {{ b.end }}){% endif %}</p>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="dh-hero__controls" data-dh-controls>
    <button type="button" class="dh-hero__arrow" data-dh-prev aria-label="Previous slide">{% render 'dh-icon', name: 'arrow-left' %}</button>
    <div class="dh-hero__dots" data-dh-dots></div>
    <button type="button" class="dh-hero__arrow" data-dh-next aria-label="Next slide">{% render 'dh-icon', name: 'arrow-right' %}</button>
    <button type="button" class="dh-hero__pause" data-dh-pause data-pause="Pause" data-play="Play">Pause</button>
  </div>
</section>

{% schema %}
{
  "name": "DH: Hero slides",
  "tag": "div",
  "class": "dh-section dh-hero-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible name", "default": "This month at Dr. Hauschka Singapore" },
    { "type": "range", "id": "delay", "label": "Seconds per slide", "min": 7, "max": 15, "step": 1, "unit": "s", "default": 8 }
  ],
  "blocks": [
    { "type": "slide", "name": "Slide", "settings": [
      { "type": "checkbox", "id": "show", "label": "Show", "default": true },
      { "type": "text", "id": "start", "label": "Start (Singapore time)", "info": "e.g. 2026-11-11T00:00. Empty = already live." },
      { "type": "text", "id": "end", "label": "End (Singapore time)", "info": "e.g. 2026-11-15T23:59. Empty = no end." },
      { "type": "checkbox", "id": "is_h1", "label": "Headline is the page H1", "default": false, "info": "Tick on the month's slide only." },
      { "type": "image_picker", "id": "image", "label": "Desktop image", "info": "2560 x 1000, room on the left for the text." },
      { "type": "image_picker", "id": "image_mobile", "label": "Phone image", "info": "1170 x 1500." },
      { "type": "text", "id": "alt", "label": "Alt text" },
      { "type": "product_list", "id": "fallback_products", "label": "Stand-in products", "limit": 3, "info": "Their store images show on the flat colour until the slide image exists." },
      { "type": "select", "id": "background", "label": "Colour", "default": "warm", "options": [ { "value": "warm", "label": "Warm grey" }, { "value": "green", "label": "Soft green" }, { "value": "pink", "label": "Soft pink" }, { "value": "white", "label": "White" } ] },
      { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
      { "type": "text", "id": "heading", "label": "Headline", "default": "Headline" },
      { "type": "richtext", "id": "text", "label": "Text", "info": "[from_price] shows the cheapest live price in the collection below." },
      { "type": "collection", "id": "price_collection", "label": "Collection for [from_price]" },
      { "type": "text", "id": "price_skip_tag", "label": "[from_price] ignores products tagged", "info": "e.g. Accessories (the gift box)." },
      { "type": "text", "id": "price_title_has", "label": "[from_price] counts only titles containing", "info": "e.g. Set. Clear once the collection holds sets only (P2-19f)." },
      { "type": "text", "id": "button_label", "label": "Button" },
      { "type": "url", "id": "button_link", "label": "Button link" },
      { "type": "text", "id": "link_label", "label": "Text link" },
      { "type": "url", "id": "link_url", "label": "Text link URL" },
      { "type": "text", "id": "note", "label": "Editor note" }
    ] }
  ],
  "presets": [ { "name": "DH: Hero slides", "blocks": [ { "type": "slide" }, { "type": "slide" } ] } ]
}
{% endschema %}